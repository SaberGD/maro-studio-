+
+/// HORIX Colour Chords (Affinity's, crate::horix_chords) under the panel, from the active colour: a
+/// click on a colour applies it as the panel does (and, as any colour the panel chooses, makes it
+/// the Color Guide's base), Add to Swatches saves the chord as a swatch group of the document (one
+/// undo step).
+fn horix_chords(app: &mut VectorcraftApp, ui: &mut Ui, tgt: &Target, color: Option<Color>) {
+    let Some(base) = color else { return };
+    ui.add_space(10.0);
+    ui.separator();
+    match crate::horix_chords::section(ui, "vectors", base.to_rgb(), app.session.active().is_some()) {
+        Some(crate::horix_chords::ChordAction::Use(c)) => choose(app, tgt, Color::rgb(c[0], c[1], c[2]), Live::Released, false),
+        Some(crate::horix_chords::ChordAction::AddToSwatches { group, colors }) => {
+            let colors: Vec<String> = colors.into_iter().map(crate::horix_chords::hex).collect();
+            if let Err(e) = app.run("swatch.newGroup", json!({"name": group, "colors": colors})) {
+                app.ui.status = e.to_string();
+            }
+        }
+        None => {}
+    }
 }
 
