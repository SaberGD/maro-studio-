+    /// HORIX is for Arabic and English: the only languages its interface offers. Every other
+    /// translation stays in the code, hidden.
+    pub fn horix_offered(self) -> bool {
+        matches!(self.code(), "en" | "ar")
+    }
+
+    /// [`Self::from_pref`] limited to what HORIX offers: a saved or system language it does not
+    /// offer shows English.
+    pub fn horix_from_pref(pref: &str) -> Lang {
+        let lang = Lang::from_pref(pref);
+        if lang.horix_offered() { lang } else { Lang::EN }
+    }
+
