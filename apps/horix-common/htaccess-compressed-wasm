# >>> compressed-wasm (deploy.sh removes this block if the host does not serve it correctly)
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.wasm)$ $1.br [L,E=no-gzip:1,E=HORIX_ENC:br]
  RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+\.wasm)$ $1.gz [L,E=no-gzip:1,E=HORIX_ENC:gzip]
</IfModule>
<FilesMatch "\.wasm\.br$">
  ForceType application/wasm
  <IfModule mod_headers.c>
    Header set Content-Encoding br
  </IfModule>
</FilesMatch>
<FilesMatch "\.wasm\.gz$">
  ForceType application/wasm
  <IfModule mod_headers.c>
    Header set Content-Encoding gzip
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "\.wasm(\.br|\.gz)?$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>
# <<< compressed-wasm

# Each update keeps some file names (lightcraft_web_bg.wasm, its .js, index.html), so browsers ask
# the server every time instead of keeping an old copy (304 when the file is unchanged: nothing is
# downloaded again). Outside the block above, so it stays when that block is removed.
<IfModule mod_headers.c>
  <FilesMatch "(\.(wasm|br|gz|js|html|json|onnx)|^)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
