+++ b/crates/engine/src/segment/external.rs
@@ -0,0 +1,177 @@
+//! HORIX: AI masks computed outside the engine. Horix Light's web build has no SAM 3 (it is a
+//! 3.4 GB desktop-only model), so the page runs HORIX's own models with onnxruntime-web instead:
+//! MobileSAM for Object clicks and IS-Net for Subject and Background (the models HORIX's Select
+//! Subject and Object Selection use). With [`super::Segmenter::external`] set, AI mask commands
+//! queue an [`ExternalRequest`]; the host takes them ([`super::Segmenter::take_external`]),
+//! renders the model input ([`Session::segment_external_input`]), runs the model, and applies
+//! the answer with `mask.horixResult`. The answer is an ordinary [`lightcraft_develop::SegMask`],
+//! so renders, exports and the desktop app read the mask like any other.
+
+use lightcraft_catalog::PhotoId;
+use lightcraft_geom::Point;
+
+use super::PendingClicks;
+use crate::Session;
+
+/// Long edge of the image the page's models see (MobileSAM's encoder input).
+pub const EXTERNAL_EDGE: usize = 1024;
+
+/// What a request asks the page for.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ExternalKind {
+    /// The object these Object clicks pick (normalized image points).
+    Clicks { hint: Vec<Point>, exclude: Vec<Point> },
+    /// The photo's main subject.
+    Subject,
+    /// Everything but the main subject.
+    Background,
+}
+
+impl ExternalKind {
+    /// The name `mask.horixResult` takes.
+    pub fn name(&self) -> &'static str {
+        match self {
+            ExternalKind::Clicks { .. } => "clicks",
+            ExternalKind::Subject => "subject",
+            ExternalKind::Background => "background",
+        }
+    }
+}
+
+/// One AI mask the page computes: for component `comp` of mask `mask` on `photo`. `key` names the
+/// model input (the photo's look without masks), so the page re-encodes only when it changed.
+#[derive(Clone, Debug)]
+pub struct ExternalRequest {
+    pub req: u64,
+    pub photo: PhotoId,
+    pub mask: u32,
+    pub comp: usize,
+    pub kind: ExternalKind,
+    pub key: u64,
+}
+
+impl super::Segmenter {
+    /// The requests queued since the last call; each counts as in flight (see [`Self::busy`])
+    /// until [`Self::external_done`].
+    pub fn take_external(&mut self) -> Vec<ExternalRequest> {
+        let out = std::mem::take(&mut self.external_queue);
+        self.external_inflight += out.len();
+        out
+    }
+
+    /// A request taken with [`Self::take_external`] is finished (applied, failed or dropped).
+    pub fn external_done(&mut self, r: &ExternalRequest) {
+        self.external_inflight = self.external_inflight.saturating_sub(1);
+        if self.pending.as_ref().is_some_and(|p| (p.photo, p.mask, p.comp) == (r.photo, r.mask, r.comp)) {
+            self.pending = None;
+        }
+    }
+}
+
+impl Session {
+    /// Queue an AI mask for the page (see the module docs). Object clicks show as pending on the
+    /// loupe until the answer is applied.
+    pub fn segment_external(&mut self, id: PhotoId, mask: u32, comp: usize, kind: ExternalKind) -> Result<(), String> {
+        let (key, _) = self.segment_key(id).ok_or("no such photo")?;
+        if let ExternalKind::Clicks { hint, exclude } = &kind {
+            if hint.is_empty() {
+                return Err("click the object to include it first".into());
+            }
+            self.segmenter.pending = Some(PendingClicks { photo: id, mask, comp, hint: hint.clone(), exclude: exclude.clone() });
+        }
+        self.segmenter.external_next += 1;
+        let req = self.segmenter.external_next;
+        self.segmenter.external_queue.push(ExternalRequest { req, photo: id, mask, comp, kind, key });
+        Ok(())
+    }
+
+    /// The model input for photo `id`: its look without masks, upright and uncropped, as 8-bit
+    /// RGB with its size, the long edge at most [`EXTERNAL_EDGE`]. Mask coordinates are
+    /// normalized to this frame.
+    pub fn segment_external_input(&mut self, id: PhotoId) -> Result<(Vec<u8>, usize, usize), String> {
+        let (_, d) = self.segment_key(id).ok_or("no such photo")?;
+        let job = self.preview_job(id, EXTERNAL_EDGE, EXTERNAL_EDGE, false, &d).ok_or("no such photo")?;
+        let image = job.run().rendered?.image;
+        let rgb: Vec<u8> = image.data.iter().flat_map(|px| [px[0], px[1], px[2]]).collect();
+        Ok((rgb, image.width, image.height))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn requests_are_in_flight_until_done() {
+        let mut seg = super::super::Segmenter { external: true, ..Default::default() };
+        assert!(!seg.busy());
+        seg.external_queue.push(ExternalRequest { req: 1, photo: PhotoId(1), mask: 1, comp: 0, kind: ExternalKind::Subject, key: 7 });
+        let taken = seg.take_external();
+        assert_eq!(taken.len(), 1);
+        assert!(seg.busy(), "a taken request is in flight");
+        assert!(seg.take_external().is_empty());
+        seg.external_done(&taken[0]);
+        assert!(!seg.busy());
+        assert!(seg.require_model().is_ok(), "the page has the models");
+    }
+
+    fn shape(s: &Session, mask: usize, comp: usize) -> lightcraft_develop::MaskShape {
+        s.develop_of(s.active().unwrap()).unwrap().masks[mask].components[comp].shape.clone()
+    }
+
+    /// A segmentation selecting the left half, as the page sends it.
+    fn left_half() -> serde_json::Value {
+        let side = 32;
+        let logits: Vec<f32> = (0..side * side).map(|i| if i % side < side / 2 { 10.0 } else { -10.0 }).collect();
+        serde_json::to_value(lightcraft_develop::SegMask::from_logits(side, &logits)).unwrap()
+    }
+
+    #[test]
+    fn subject_and_object_masks_round_trip_through_the_page() {
+        use lightcraft_develop::MaskShape;
+        use serde_json::json;
+        let mut s = Session::with_demo();
+        s.segmenter.external = true;
+        let photo = s.active().unwrap();
+        // Subject: the built-in estimate at once, the page's answer when it comes
+        let out = s.execute("mask.add", &json!({"kind": "subject"})).unwrap();
+        assert_eq!(out["pending"], true);
+        assert_eq!(shape(&s, 0, 0), MaskShape::Subject);
+        let reqs = s.segmenter.take_external();
+        assert_eq!(reqs.len(), 1);
+        assert_eq!((reqs[0].photo, reqs[0].mask, reqs[0].comp, &reqs[0].kind), (photo, 1, 0, &ExternalKind::Subject));
+        assert!(s.segmenter.busy());
+        let (rgb, w, h) = s.segment_external_input(photo).unwrap();
+        assert!(w.max(h) <= EXTERNAL_EDGE && w > 0 && h > 0 && rgb.len() == w * h * 3);
+        let r = s.execute("mask.horixResult", &json!({"photo": photo.0, "id": 1, "component": 0, "kind": "subject", "seg": left_half()})).unwrap();
+        assert_eq!(r["applied"], true);
+        s.segmenter.external_done(&reqs[0]);
+        assert!(!s.segmenter.busy());
+        let d = s.develop_of(photo).unwrap();
+        assert!(matches!(&d.masks[0].components[0].shape, MaskShape::Object { seg: Some(_), hint, .. } if hint.is_empty()));
+        assert_eq!(d.masks[0].components[0].name.as_deref(), Some("Subject"));
+        // an answer for a component that changed meanwhile is dropped
+        let r = s.execute("mask.horixResult", &json!({"photo": photo.0, "id": 1, "component": 0, "kind": "subject", "seg": left_half()})).unwrap();
+        assert_eq!(r["applied"], false);
+        // Object: clicks queue a request; only the answer for the latest clicks applies
+        s.execute("mask.add", &json!({"kind": "object"})).unwrap();
+        assert!(s.segmenter.take_external().is_empty(), "nothing to compute before a click");
+        s.execute("mask.objectPoint", &json!({"x": 0.3, "y": 0.5})).unwrap();
+        s.execute("mask.objectPoint", &json!({"x": 0.4, "y": 0.6, "exclude": true})).unwrap();
+        let reqs = s.segmenter.take_external();
+        assert_eq!(reqs.len(), 2);
+        let ExternalKind::Clicks { hint, exclude } = &reqs[1].kind else { panic!("clicks") };
+        assert_eq!((hint.len(), exclude.len()), (1, 1), "the second request carries both clicks");
+        let stale = json!({"photo": photo.0, "id": 2, "component": 0, "kind": "clicks", "seg": left_half(), "hint": [[0.3, 0.5]], "exclude": []});
+        assert_eq!(s.execute("mask.horixResult", &stale).unwrap()["applied"], false);
+        let latest = json!({"photo": photo.0, "id": 2, "component": 0, "kind": "clicks", "seg": left_half(), "hint": [[0.3, 0.5]], "exclude": [[0.4, 0.6]]});
+        assert_eq!(s.execute("mask.horixResult", &latest).unwrap()["applied"], true);
+        assert!(matches!(shape(&s, 1, 0), MaskShape::Object { seg: Some(_), hint, exclude, .. } if hint.len() == 1 && exclude.len() == 1));
+        // the result is one undo step
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert!(matches!(shape(&s, 1, 0), MaskShape::Object { seg: None, .. }));
+        // Describe needs the desktop model; nothing is added
+        assert!(s.execute("mask.add", &json!({"kind": "prompt", "text": "sky"})).is_err());
+        assert_eq!(s.develop_of(photo).unwrap().masks.len(), 2);
+    }
+}
