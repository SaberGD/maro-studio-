+
+/// HORIX Colour Chords (Affinity's, crate::horix_chords) under Color Grading: hues that go together,
+/// from the highlights' hue (else the midtones', the shadows'), set on the wheels in one step. A
+/// wheel without saturation gets a gentle 25 so its new hue shows.
+fn horix_chords(app: &mut LightcraftApp, ui: &mut egui::Ui, d: &DevelopSettings) {
+    let g = &d.grading;
+    let wheels = [g.shadows, g.midtones, g.highlights];
+    let base = [g.highlights, g.midtones, g.shadows].into_iter().find(|w| w.sat > 0.0).map_or(30.0, |w| w.hue as f32);
+    egui::Frame::NONE.inner_margin(egui::Margin { left: 24, right: 22, top: 8, bottom: 6 }).show(ui, |ui| {
+        if let Some(hues) = crate::horix_chords::grading_section(ui, "light", base) {
+            let mut values = serde_json::Map::new();
+            for (i, hue) in hues {
+                let key = GRADING_WHEELS[i].0;
+                values.insert(format!("grading.{key}.hue"), json!(hue.round()));
+                if wheels[i].sat <= 0.0 {
+                    values.insert(format!("grading.{key}.sat"), json!(25));
+                }
+            }
+            let _ = app.run("develop.set", json!({"values": values}));
+        }
+    });
 }
 
