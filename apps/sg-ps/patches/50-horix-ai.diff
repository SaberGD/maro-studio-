diff --git a/apps/photocraft-web/index.html b/apps/photocraft-web/index.html
index d120169..0e0af2c 100644
--- a/apps/photocraft-web/index.html
+++ b/apps/photocraft-web/index.html
@@ -460,5 +460,173 @@
       font: inherit; font-weight: 700; text-align: center; text-decoration: none; cursor: pointer; }
     #sgps_crash a { background: #3A3535; }
   </style>
+  <script>
+    // HORIX AI selection: MobileSAM in the browser (onnxruntime-web, loaded on the first Quick /
+    // Object Selection), and IS-Net (half precision) for Select Subject (loaded on its first use). The models come from ./models/; the runtime from jsDelivr. The app asks
+    // through window.horixAi (see web.rs WebSegmenter) and polls for results.
+    (function () {
+      var ORT = 'https://cdn.jsdelivr.net/npm/onnxruntime-web@1.22.0/dist/';
+      var MODELS = new URL('models/', document.baseURI).href;
+      var ready = null, enc = null, dec = null, emb = null, queue = Promise.resolve(), out = [];
+      var rt = null, subj = null;
+      function script(src) {
+        return new Promise(function (res, rej) {
+          var s = document.createElement('script');
+          s.src = src; s.crossOrigin = 'anonymous'; s.onload = res;
+          s.onerror = function () { rej(new Error('could not load the AI runtime')); };
+          document.head.appendChild(s);
+        });
+      }
+      var adapter = false;
+      async function session(url, gpu) {
+        // The GPU (WebGPU) when the browser has it, else the CPU (WebAssembly).
+        if (gpu && adapter) {
+          try { return await ort.InferenceSession.create(url, { executionProviders: ['webgpu'] }); } catch (e) { console.warn('HORIX AI: WebGPU unavailable', e); }
+        }
+        return ort.InferenceSession.create(url, { executionProviders: ['wasm'] });
+      }
+      function runtime() {
+        if (rt) return rt;
+        rt = Promise.all([
+          script(ORT + 'ort.webgpu.min.js'),
+          (navigator.gpu ? navigator.gpu.requestAdapter().catch(function () { return null; }) : Promise.resolve(null))
+        ]).then(function (r) {
+          // Our models carry half-precision weights (IS-Net): a graphics card without shader-f16
+          // runs them wrongly (empty masks), so those take the processor path.
+          adapter = !!(r[1] && r[1].features.has('shader-f16'));
+          ort.env.wasm.wasmPaths = ORT;
+          ort.env.wasm.numThreads = self.crossOriginIsolated ? Math.min(navigator.hardwareConcurrency || 4, 8) : 1;
+          // Without a usable graphics card the models run on the processor: in a worker, so the page
+          // keeps responding (on the page's own thread Select Subject froze it for ~16 s).
+          ort.env.wasm.proxy = !adapter;
+        });
+        rt.catch(function () { rt = null; });
+        return rt;
+      }
+      function load() {
+        if (ready) return ready;
+        ready = runtime().then(async function () {
+          enc = await session(MODELS + 'mobile_sam_image_encoder.onnx', true);
+          dec = await session(MODELS + 'sam_mask_decoder_multi.onnx', false);
+        });
+        return ready;
+      }
+      // Background preparation (horixAi.preload, soon after start-up): download the three models
+      // with progress (the browser keeps them, so later visits only revalidate), open them, and on
+      // a graphics card run IS-Net once so its shaders are compiled before the first Select Subject.
+      var FILES = [['mobile_sam_image_encoder.onnx', 28157093], ['sam_mask_decoder_multi.onnx', 16496559], ['isnet_fp16.onnx', 90648790]];
+      var prepared = null, lastShown = -1;
+      function progress(fraction, stage) {
+        var pct = Math.floor(fraction * 100);
+        if (pct === lastShown) return;
+        lastShown = pct;
+        out.push({ type: 'progress', fraction: fraction, stage: stage });
+      }
+      async function download(name, size, done, total) {
+        var r = await fetch(MODELS + name);
+        if (!r.ok) throw new Error(name + ': HTTP ' + r.status);
+        if (!r.body || !r.body.getReader) return new Uint8Array(await r.arrayBuffer());
+        var reader = r.body.getReader(), parts = [], got = 0;
+        for (;;) {
+          var c = await reader.read();
+          if (c.done) break;
+          parts.push(c.value); got += c.value.length;
+          progress(0.04 + 0.78 * (done + Math.min(got, size)) / total, 'Downloading the AI models');
+        }
+        var buf = new Uint8Array(got), at = 0;
+        for (var i = 0; i < parts.length; i++) { buf.set(parts[i], at); at += parts[i].length; }
+        return buf;
+      }
+      function preload() {
+        if (prepared) return prepared;
+        prepared = queue = queue.then(async function () {
+          progress(0.01, 'Starting the AI runtime');
+          await runtime();
+          var total = FILES.reduce(function (a, f) { return a + f[1]; }, 0), done = 0, bufs = [];
+          for (var i = 0; i < FILES.length; i++) { bufs.push(await download(FILES[i][0], FILES[i][1], done, total)); done += FILES[i][1]; }
+          progress(0.84, 'Opening the models');
+          if (!enc) { enc = await session(bufs[0], true); dec = await session(bufs[1], false); ready = Promise.resolve(); }
+          if (!subj) subj = await session(bufs[2], true);
+          if (adapter) {
+            progress(0.92, 'Preparing the graphics card');
+            var n = 1024 * 1024;
+            await subj.run({ [subj.inputNames[0]]: new ort.Tensor('float32', new Float32Array(3 * n), [1, 3, 1024, 1024]) });
+          }
+          out.push({ type: 'ready' });
+        }).catch(function (e) {
+          // Not fatal: each tool loads what it needs on first use, as before.
+          console.warn('HORIX AI: background preparation failed', e);
+          out.push({ type: 'ready' });
+        });
+        return prepared;
+      }
+      // One model call at a time, in order.
+      function then(job) {
+        queue = queue.then(function () { return load().then(job); }).catch(function (e) {
+          out.push({ type: 'failed', msg: String((e && e.message) || e) });
+        });
+      }
+      window.horixAi = {
+        encode: function (key, rgb, w, h) {
+          then(async function () {
+            var f = new Float32Array(rgb.length);
+            for (var i = 0; i < rgb.length; i++) f[i] = rgb[i];
+            var r = await enc.run({ input_image: new ort.Tensor('float32', f, [h, w, 3]) });
+            emb = { key: key, t: r.image_embeddings, w: w, h: h };
+            out.push({ type: 'encoded', key: key });
+          });
+        },
+        decode: function (key, req, coords, labels, prev) {
+          then(async function () {
+            if (!emb || emb.key !== key) throw new Error('the image is not encoded');
+            var n = labels.length;
+            var r = await dec.run({
+              image_embeddings: emb.t,
+              point_coords: new ort.Tensor('float32', coords, [1, n, 2]),
+              point_labels: new ort.Tensor('float32', labels, [1, n]),
+              mask_input: new ort.Tensor('float32', prev || new Float32Array(256 * 256), [1, 1, 256, 256]),
+              has_mask_input: new ort.Tensor('float32', new Float32Array([prev ? 1 : 0]), [1]),
+              orig_im_size: new ort.Tensor('float32', new Float32Array([emb.h, emb.w]), [2])
+            });
+            out.push({ type: 'decoded', req: req, logits: await r.low_res_masks.getData(), ious: await r.iou_predictions.getData() });
+          });
+        },
+        // Select Subject: rgb is side × side; answers the subject's probability (0..1).
+        subject: function (req, rgb, side) {
+          queue = queue.then(async function () {
+            await runtime();
+            // The GPU when the browser has WebGPU (seconds faster), else WebAssembly.
+            if (!subj) subj = await session(MODELS + 'isnet_fp16.onnx', true);
+            var n = side * side, x = new Float32Array(3 * n);
+            for (var i = 0; i < n; i++) for (var c = 0; c < 3; c++) x[c * n + i] = rgb[i * 3 + c] / 255 - 0.5;
+            async function infer() {
+              var r = await subj.run({ [subj.inputNames[0]]: new ort.Tensor('float32', x, [1, 3, side, side]) });
+              var y = await r[subj.outputNames[0]].getData(), lo = Infinity, hi = -Infinity;
+              for (var i = 0; i < n; i++) { if (y[i] < lo) lo = y[i]; if (y[i] > hi) hi = y[i]; }
+              if (!(hi - lo > 1e-6)) throw new Error('the model answered an empty mask');
+              return { y: y, lo: lo, hi: hi };
+            }
+            var o;
+            try { o = await infer(); } catch (e) {
+              // A graphics card that runs the model wrongly or not at all: once more on the processor.
+              if (!adapter || subj.horixCpu) throw e;
+              console.warn('HORIX AI: Select Subject failed on WebGPU; using the CPU', e);
+              subj = await session(MODELS + 'isnet_fp16.onnx', false);
+              subj.horixCpu = true;
+              o = await infer();
+            }
+            var y = o.y, lo = o.lo, hi = o.hi;
+            var k = hi - lo > 1e-6 ? 1 / (hi - lo) : 0, m = new Float32Array(n);
+            for (var i = 0; i < n; i++) m[i] = (y[i] - lo) * k;
+            out.push({ type: 'subject', req: req, mask: m });
+          }).catch(function (e) {
+            out.push({ type: 'subjectFailed', msg: String((e && e.message) || e) });
+          });
+        },
+        preload: function () { preload(); },
+        poll: function () { return out.splice(0, out.length); }
+      };
+    })();
+  </script>
 </body>
 </html>
diff --git a/apps/photocraft-web/src/web.rs b/apps/photocraft-web/src/web.rs
