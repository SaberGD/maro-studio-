diff --git a/apps/photocraft/src/ai_model.rs b/apps/photocraft/src/ai_model.rs
new file mode 100644
index 0000000..808bce8
--- /dev/null
+++ b/apps/photocraft/src/ai_model.rs
@@ -0,0 +1,700 @@
+//! HORIX AI selection on the desktop: MobileSAM (Quick / Object Selection) and IS-Net (Select
+//! Subject) through Microsoft's onnxruntime, loaded at run
+//! time from the app folder (`onnxruntime.dll` / `libonnxruntime.dylib` / `.so` next to the
+//! executable, or in the macOS bundle's Frameworks), with the models in `models/` beside it (or
+//! the bundle's Resources). The model runs on a worker thread; see `photocraft_ui_egui::ai_segment`.
+
+use std::path::{Path, PathBuf};
+use std::sync::mpsc::{Receiver, Sender, channel};
+
+use ort::session::Session;
+use ort::value::Tensor;
+use photocraft_ui_egui::ai_segment::{LOW, SegEvent, Segmenter};
+
+const ENCODER: &str = "mobile_sam_image_encoder.onnx";
+const DECODER: &str = "sam_mask_decoder_multi.onnx";
+/// IS-Net (DIS, general use; Apache-2.0), 1024 × 1024: Select Subject, on the graphics card when
+/// there is one.
+const SUBJECT: &str = "isnet-general-use.onnx";
+const SUBJECT_SIDE: u32 = 1024;
+
+enum Cmd {
+    Encode { key: u64, rgb: Vec<u8>, w: u32, h: u32 },
+    Decode { key: u64, req: u64, points: Vec<[f32; 2]>, labels: Vec<f32>, prev: Option<Vec<f32>> },
+    Subject { req: u64, rgb: Vec<u8>, side: u32 },
+    /// Load both models now (start-up), reporting progress.
+    Preload,
+}
+
+pub struct NativeSegmenter {
+    tx: Sender<Cmd>,
+    rx: Receiver<SegEvent>,
+}
+
+impl NativeSegmenter {
+    /// Starts the worker; the runtime and models load on the first request.
+    pub fn start() -> Self {
+        let (tx, crx) = channel();
+        let (etx, rx) = channel();
+        let spawned = std::thread::Builder::new().name("horix-ai".into()).spawn(move || worker(crx, etx));
+        if let Err(e) = spawned {
+            log::warn!("HORIX AI worker did not start: {e}");
+        }
+        Self { tx, rx }
+    }
+}
+
+impl Segmenter for NativeSegmenter {
+    fn encode(&mut self, key: u64, rgb: Vec<u8>, w: u32, h: u32) {
+        let _ = self.tx.send(Cmd::Encode { key, rgb, w, h });
+    }
+    fn decode(&mut self, key: u64, req: u64, points: Vec<[f32; 2]>, labels: Vec<f32>, prev: Option<Vec<f32>>) {
+        let _ = self.tx.send(Cmd::Decode { key, req, points, labels, prev });
+    }
+    fn poll(&mut self) -> Vec<SegEvent> {
+        self.rx.try_iter().collect()
+    }
+    fn subject_side(&self) -> Option<u32> {
+        Some(SUBJECT_SIDE)
+    }
+    fn subject(&mut self, req: u64, rgb: Vec<u8>, side: u32) {
+        let _ = self.tx.send(Cmd::Subject { req, rgb, side });
+    }
+    fn preload(&mut self) {
+        let _ = self.tx.send(Cmd::Preload);
+    }
+}
+
+/// Folders the runtime library and the models may be in, nearest first.
+fn search_dirs() -> Vec<PathBuf> {
+    let mut v = Vec::new();
+    if let Some(dir) = std::env::current_exe().ok().and_then(|p| p.parent().map(Path::to_path_buf)) {
+        v.push(dir.clone());
+        // HORIX.app/Contents/MacOS → Contents/Frameworks, Contents/Resources.
+        if let Some(contents) = dir.parent() {
+            v.push(contents.join("Frameworks"));
+            v.push(contents.join("Resources"));
+        }
+    }
+    if let Some(dir) = std::env::var_os("HORIX_AI_DIR") {
+        v.insert(0, PathBuf::from(dir));
+    }
+    v
+}
+
+fn runtime_name() -> &'static str {
+    if cfg!(target_os = "windows") {
+        "onnxruntime.dll"
+    } else if cfg!(target_os = "macos") {
+        "libonnxruntime.dylib"
+    } else {
+        "libonnxruntime.so"
+    }
+}
+
+fn find(name: &str) -> Option<PathBuf> {
+    search_dirs().into_iter().flat_map(|d| [d.join(name), d.join("models").join(name)]).find(|p| p.is_file())
+}
+
+struct Model {
+    enc: Session,
+    dec: Session,
+    /// Either session is on the graphics card (a failed run retries on the processor).
+    gpu: bool,
+    paths: (PathBuf, PathBuf),
+}
+
+/// Loads onnxruntime once (the first model to need it).
+fn runtime() -> Result<(), String> {
+    static INIT: std::sync::OnceLock<Result<(), String>> = std::sync::OnceLock::new();
+    INIT.get_or_init(|| {
+        let lib = find(runtime_name()).ok_or_else(|| format!("{} not found next to HORIX", runtime_name()))?;
+        ort::init_from(lib.to_string_lossy().to_string()).with_name("horix").commit().map(|_| ()).map_err(|e| e.to_string())
+    })
+    .clone()
+}
+
+/// Where a session runs: on the graphics card (DirectML on Windows, Core ML on macOS) when there is
+/// one, else on the processor. `HORIX_AI_CPU=1` forces the processor.
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Device {
+    Gpu,
+    Cpu,
+}
+
+#[allow(unreachable_code)]
+fn gpu_providers() -> Vec<ort::execution_providers::ExecutionProviderDispatch> {
+    if std::env::var_os("HORIX_AI_CPU").is_some() {
+        return Vec::new();
+    }
+    #[cfg(target_os = "windows")]
+    return vec![ort::execution_providers::DirectMLExecutionProvider::default().build().error_on_failure()];
+    #[cfg(target_os = "macos")]
+    {
+        use ort::execution_providers::coreml::{CoreMLComputeUnits, CoreMLModelFormat};
+        // Compiled Core ML models are cached, so only the first load of a model is slow.
+        let cache = std::env::temp_dir().join("horix-coreml-cache");
+        let _ = std::fs::create_dir_all(&cache);
+        return vec![
+            ort::execution_providers::CoreMLExecutionProvider::default()
+                .with_model_format(CoreMLModelFormat::MLProgram)
+                .with_compute_units(CoreMLComputeUnits::All)
+                .with_model_cache_dir(cache.to_string_lossy())
+                .build()
+                .error_on_failure(),
+        ];
+    }
+    Vec::new()
+}
+
+fn session_on(p: &Path, device: Device) -> Result<Session, String> {
+    let threads = std::thread::available_parallelism().map_or(4, |n| n.get()).clamp(1, 8);
+    let b = Session::builder().and_then(|b| b.with_intra_threads(threads));
+    let b = match device {
+        // DirectML wants sequential execution without memory patterns.
+        Device::Gpu => b.and_then(|b| b.with_execution_providers(gpu_providers())).and_then(|b| b.with_memory_pattern(false)).and_then(|b| b.with_parallel_execution(false)),
+        Device::Cpu => b,
+    };
+    b.and_then(|b| b.commit_from_file(p)).map_err(|e| e.to_string())
+}
+
+/// The graphics card when it takes the model, else the processor.
+fn session(p: &Path) -> Result<(Session, Device), String> {
+    if !gpu_providers().is_empty() {
+        match session_on(p, Device::Gpu) {
+            Ok(s) => {
+                log::info!("HORIX AI: {} on the GPU", p.display());
+                return Ok((s, Device::Gpu));
+            }
+            Err(e) => log::warn!("HORIX AI: GPU unavailable for {} ({e}); using the CPU", p.display()),
+        }
+    }
+    Ok((session_on(p, Device::Cpu)?, Device::Cpu))
+}
+
+fn load() -> Result<Model, String> {
+    runtime()?;
+    let enc = find(ENCODER).ok_or("the AI model files are missing (models folder)")?;
+    let dec = find(DECODER).ok_or("the AI model files are missing (models folder)")?;
+    let (enc_s, d1) = session(&enc)?;
+    let (dec_s, d2) = session(&dec)?;
+    Ok(Model { enc: enc_s, dec: dec_s, gpu: d1 == Device::Gpu || d2 == Device::Gpu, paths: (enc, dec) })
+}
+
+impl Model {
+    /// After a failed run on the graphics card: the same models on the processor.
+    fn move_to_cpu(&mut self) -> Result<(), String> {
+        self.enc = session_on(&self.paths.0, Device::Cpu)?;
+        self.dec = session_on(&self.paths.1, Device::Cpu)?;
+        self.gpu = false;
+        Ok(())
+    }
+}
+
+struct Subject {
+    s: Session,
+    device: Device,
+}
+
+/// IS-Net, on the graphics card when it takes the model, else the processor.
+fn load_subject() -> Result<Subject, String> {
+    runtime()?;
+    let (s, device) = session(&find(SUBJECT).ok_or("the Select Subject model is missing (models folder)")?)?;
+    Ok(Subject { s, device })
+}
+
+/// Select Subject, falling back once from a failed run on the graphics card to the processor.
+fn subject_mask(sub: &mut Subject, rgb: &[u8], side: u32) -> Result<Vec<f32>, String> {
+    match run_subject(&mut sub.s, rgb, side) {
+        Ok(m) => Ok(m),
+        Err(e) if sub.device == Device::Gpu => {
+            log::warn!("HORIX AI: Select Subject failed on the GPU ({e}); retrying on the CPU");
+            let p = find(SUBJECT).ok_or("the Select Subject model is missing (models folder)")?;
+            *sub = Subject { s: session_on(&p, Device::Cpu)?, device: Device::Cpu };
+            subject_mask(sub, rgb, side)
+        }
+        Err(e) => Err(e),
+    }
+}
+
+fn worker(rx: Receiver<Cmd>, tx: Sender<SegEvent>) {
+    let mut model: Option<Model> = None;
+    let mut failed: Option<String> = None;
+    let mut embedding: Option<(u64, Vec<f32>, u32, u32)> = None;
+    let mut subject: Option<Result<Subject, String>> = None;
+    while let Ok(mut cmd) = rx.recv() {
+        // Only the newest image matters: skip encodes superseded by a later one.
+        while let Cmd::Encode { .. } = cmd {
+            match rx.try_recv() {
+                Ok(next @ Cmd::Encode { .. }) => cmd = next,
+                Ok(other) => {
+                    run(&mut model, &mut failed, &mut embedding, &mut subject, cmd, &tx);
+                    cmd = other;
+                    break;
+                }
+                Err(_) => break,
+            }
+        }
+        run(&mut model, &mut failed, &mut embedding, &mut subject, cmd, &tx);
+    }
+}
+
+fn run(
+    model: &mut Option<Model>,
+    failed: &mut Option<String>,
+    embedding: &mut Option<(u64, Vec<f32>, u32, u32)>,
+    subject: &mut Option<Result<Subject, String>>,
+    cmd: Cmd,
+    tx: &Sender<SegEvent>,
+) {
+    // Start-up: both models load before anything asks (the graphics card compiles them on first
+    // load, Core ML especially), so the first selection doesn't wait.
+    if let Cmd::Preload = cmd {
+        let progress = |fraction: f32, stage: &str| {
+            let _ = tx.send(SegEvent::Progress { fraction, stage: stage.into() });
+        };
+        progress(0.05, "Loading the selection model");
+        if model.is_none() && failed.is_none() {
+            match load() {
+                Ok(m) => *model = Some(m),
+                Err(msg) => {
+                    log::warn!("HORIX AI: {msg}");
+                    *failed = Some(msg);
+                }
+            }
+        }
+        progress(0.5, "Loading the Select Subject model");
+        if subject.is_none() {
+            *subject = Some(load_subject());
+        }
+        if let Some(Err(msg)) = subject.as_ref() {
+            log::warn!("HORIX AI: {msg}");
+        }
+        let _ = tx.send(SegEvent::Ready);
+        return;
+    }
+    // Select Subject has its own model, loaded on first use.
+    if let Cmd::Subject { req, rgb, side } = cmd {
+        let ev = match subject.get_or_insert_with(load_subject) {
+            Ok(sub) => subject_mask(sub, &rgb, side).map_or_else(|msg| SegEvent::SubjectFailed { msg }, |mask| SegEvent::Subject { req, mask }),
+            Err(msg) => {
+                log::warn!("HORIX AI: {msg}");
+                SegEvent::SubjectFailed { msg: msg.clone() }
+            }
+        };
+        let _ = tx.send(ev);
+        return;
+    }
+    if let Some(msg) = failed {
+        let _ = tx.send(SegEvent::Failed { msg: msg.clone() });
+        return;
+    }
+    if model.is_none() {
+        match load() {
+            Ok(m) => *model = Some(m),
+            Err(msg) => {
+                log::warn!("HORIX AI: {msg}");
+                *failed = Some(msg.clone());
+                let _ = tx.send(SegEvent::Failed { msg });
+                return;
+            }
+        }
+    }
+    let Some(m) = model.as_mut() else { return };
+    let mut result = step(m, embedding, &cmd);
+    // A run that fails on the graphics card is retried once on the processor.
+    if result.is_err() && m.gpu {
+        log::warn!("HORIX AI: selection failed on the GPU; retrying on the CPU");
+        result = m.move_to_cpu().and_then(|()| step(m, embedding, &cmd));
+    }
+    if let Some(result) = result.transpose() {
+        let _ = tx.send(result.unwrap_or_else(|msg| SegEvent::Failed { msg }));
+    }
+}
+
+/// One encode or decode; `Ok(None)` for commands handled elsewhere.
+fn step(m: &mut Model, embedding: &mut Option<(u64, Vec<f32>, u32, u32)>, cmd: &Cmd) -> Result<Option<SegEvent>, String> {
+    Ok(Some(match cmd {
+        Cmd::Encode { key, rgb, w, h } => {
+            let e = encode(m, rgb, *w, *h)?;
+            *embedding = Some((*key, e, *w, *h));
+            SegEvent::Encoded { key: *key }
+        }
+        Cmd::Decode { key, req, points, labels, prev } => match embedding.as_ref().filter(|e| e.0 == *key) {
+            Some((_, emb, w, h)) => {
+                let (logits, ious) = decode(m, emb, *w, *h, points, labels, prev.clone())?;
+                SegEvent::Decoded { req: *req, logits, ious }
+            }
+            None => return Err("the image is not encoded".into()),
+        },
+        Cmd::Subject { .. } | Cmd::Preload => return Ok(None),
+    }))
+}
+
+/// The salient-object model on a `side × side` RGB image: the subject's probability, 0..1.
+fn run_subject(s: &mut Session, rgb: &[u8], side: u32) -> Result<Vec<f32>, String> {
+    let n = side as usize * side as usize;
+    if rgb.len() < n * 3 {
+        return Err("bad image".into());
+    }
+    // Planar, normalised as IS-Net was trained: v / 255 − 0.5.
+    let mut x = vec![0.0f32; 3 * n];
+    for i in 0..n {
+        for c in 0..3 {
+            x[c * n + i] = f32::from(rgb[i * 3 + c]) / 255.0 - 0.5;
+        }
+    }
+    let e = |e: ort::Error| e.to_string();
+    let input = Tensor::from_array(([1usize, 3, side as usize, side as usize], x)).map_err(e)?;
+    let out = s.run(ort::inputs!["input_image" => input]).map_err(e)?;
+    let (_, y) = out[0].try_extract_tensor::<f32>().map_err(e)?;
+    let y = &y[..n.min(y.len())];
+    Ok(normalise(y))
+}
+
+/// Min–max to 0..1 (IS-Net's output isn't calibrated).
+fn normalise(y: &[f32]) -> Vec<f32> {
+    let (lo, hi) = y.iter().fold((f32::MAX, f32::MIN), |(a, b), v| (a.min(*v), b.max(*v)));
+    let k = if hi - lo > 1e-6 { 1.0 / (hi - lo) } else { 0.0 };
+    y.iter().map(|v| (v - lo) * k).collect()
+}
+
+fn encode(m: &mut Model, rgb: &[u8], w: u32, h: u32) -> Result<Vec<f32>, String> {
+    let img: Vec<f32> = rgb.iter().map(|v| f32::from(*v)).collect();
+    let input = Tensor::from_array(([h as usize, w as usize, 3], img)).map_err(|e| e.to_string())?;
+    let out = m.enc.run(ort::inputs!["input_image" => input]).map_err(|e| e.to_string())?;
+    let (_, emb) = out["image_embeddings"].try_extract_tensor::<f32>().map_err(|e| e.to_string())?;
+    Ok(emb.to_vec())
+}
+
+fn decode(m: &mut Model, emb: &[f32], w: u32, h: u32, points: &[[f32; 2]], labels: &[f32], prev: Option<Vec<f32>>) -> Result<(Vec<f32>, Vec<f32>), String> {
+    let e = |e: ort::Error| e.to_string();
+    let n = points.len();
+    let has = prev.is_some();
+    let inputs = ort::inputs![
+        "image_embeddings" => Tensor::from_array(([1usize, 256, 64, 64], emb.to_vec())).map_err(e)?,
+        "point_coords" => Tensor::from_array(([1usize, n, 2], points.iter().flatten().copied().collect::<Vec<f32>>())).map_err(e)?,
+        "point_labels" => Tensor::from_array(([1usize, n], labels.to_vec())).map_err(e)?,
+        "mask_input" => Tensor::from_array(([1usize, 1, LOW, LOW], prev.unwrap_or_else(|| vec![0.0; LOW * LOW]))).map_err(e)?,
+        "has_mask_input" => Tensor::from_array(([1usize], vec![if has { 1.0f32 } else { 0.0 }])).map_err(e)?,
+        "orig_im_size" => Tensor::from_array(([2usize], vec![h as f32, w as f32])).map_err(e)?,
+    ];
+    let out = m.dec.run(inputs).map_err(e)?;
+    let (_, low) = out["low_res_masks"].try_extract_tensor::<f32>().map_err(e)?;
+    let (_, iou) = out["iou_predictions"].try_extract_tensor::<f32>().map_err(e)?;
+    Ok((low.to_vec(), iou.to_vec()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use photocraft_ui_egui::{PhotocraftApp, Services};
+
+    fn pnm(path: &str) -> (usize, usize, Vec<u8>) {
+        let d = std::fs::read(path).unwrap_or_default();
+        let mut f = Vec::new();
+        let mut i = 0;
+        while f.len() < 4 && i < d.len() {
+            while d[i].is_ascii_whitespace() {
+                i += 1;
+            }
+            let s = i;
+            while !d[i].is_ascii_whitespace() {
+                i += 1;
+            }
+            f.push(String::from_utf8_lossy(&d[s..i]).to_string());
+        }
+        i += 1;
+        (f[1].parse().unwrap_or(0), f[2].parse().unwrap_or(0), d[i..].to_vec())
+    }
+
+    /// End to end through the app (strokes → model → selection) on composites with an exact
+    /// ground truth: `HORIX_AI_DIR=<runtime + models> HORIX_AI_EVAL=<dir of cNNN.ppm/.pgm/.json>
+    /// cargo test -p photocraft --release ai_model -- --ignored --nocapture`.
+    #[test]
+    #[ignore = "needs the onnxruntime library, the models and an evaluation set"]
+    fn quick_selection_with_corrections() {
+        let Some(dir) = std::env::var_os("HORIX_AI_EVAL").map(PathBuf::from) else { return };
+        let mut names: Vec<String> = std::fs::read_dir(&dir)
+            .into_iter()
+            .flatten()
+            .filter_map(|e| e.ok()?.file_name().into_string().ok()?.strip_suffix(".json").map(String::from))
+            .collect();
+        names.sort();
+        let ctx = egui::Context::default();
+        let mut tot = [0.0f32; 4];
+        for n in &names {
+            let (w, h, rgb) = pnm(&dir.join(format!("{n}.ppm")).to_string_lossy());
+            let (_, _, g) = pnm(&dir.join(format!("{n}.pgm")).to_string_lossy());
+            let gt: Vec<bool> = g.iter().map(|v| *v > 127).collect();
+            let meta: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(dir.join(format!("{n}.json"))).unwrap_or_default()).unwrap_or_default();
+            let pts: Vec<[f64; 2]> = meta["pts"].as_array().into_iter().flatten().map(|p| [p[0].as_f64().unwrap_or(0.0), p[1].as_f64().unwrap_or(0.0)]).collect();
+            let mut doc = photocraft_doc::Document::new("t", photocraft_geom::Size::new(w as u32, h as u32), photocraft_color::ColorMode::Rgb, photocraft_color::SampleType::U8);
+            let mut l = photocraft_doc::Layer::raster("bg", photocraft_color::PixelFormat::RGBA8);
+            let px: Vec<f32> = rgb.chunks_exact(3).flat_map(|p| [f32::from(p[0]) / 255.0, f32::from(p[1]) / 255.0, f32::from(p[2]) / 255.0, 1.0]).collect();
+            if let Some(s) = l.surface_mut() {
+                s.write_region(photocraft_geom::Rect::new(0, 0, w as i32, h as i32), &px);
+            }
+            doc.layers.push(l);
+            let mut session = photocraft_engine::Session::new();
+            session.add_document(doc, None);
+            let id = session.active().and_then(|s| s.doc.layers.first().map(|l| l.id));
+            if let Some(id) = id {
+                let _ = session.select_layer(id);
+            }
+            let mut app = PhotocraftApp::new(session, Services { segmenter: Some(Box::new(NativeSegmenter::start())), ..Default::default() });
+            let settle = |app: &mut PhotocraftApp| {
+                for _ in 0..400 {
+                    photocraft_ui_egui::ai_segment::poll(app, &ctx);
+                    if !photocraft_ui_egui::ai_segment::busy(app) {
+                        break;
+                    }
+                    std::thread::sleep(std::time::Duration::from_millis(10));
+                }
+            };
+            let sel = |app: &PhotocraftApp| -> Vec<bool> {
+                let s = app.session.active().and_then(|s| s.doc.selection.clone());
+                (0..w * h).map(|i| s.as_ref().is_some_and(|s| s.sample_channel((i % w) as i32, (i / w) as i32, 0) >= 0.5)).collect()
+            };
+            let iou = |a: &[bool]| a.iter().zip(&gt).filter(|(x, y)| **x && **y).count() as f32 / a.iter().zip(&gt).filter(|(x, y)| **x || **y).count().max(1) as f32;
+            assert!(photocraft_ui_egui::ai_segment::quick_stroke(&mut app, &pts, false, false, serde_json::json!({})));
+            settle(&mut app);
+            let mut res = vec![iou(&sel(&app))];
+            for _ in 0..3 {
+                let s = sel(&app);
+                // The user's correction: a click in the middle of the biggest error.
+                let fp: Vec<bool> = s.iter().zip(&gt).map(|(a, b)| *a && !*b).collect();
+                let fneg: Vec<bool> = s.iter().zip(&gt).map(|(a, b)| !*a && *b).collect();
+                let (c, add) = match (biggest(&fp, w, h), biggest(&fneg, w, h)) {
+                    (Some(a), Some(b)) if a.len() >= b.len() => (a, false),
+                    (_, Some(b)) => (b, true),
+                    (Some(a), None) => (a, false),
+                    _ => break,
+                };
+                if c.len() < 50 {
+                    break;
+                }
+                let p = deepest(&c, w, h);
+                let pt = [(p % w) as f64 + 0.5, (p / w) as f64 + 0.5];
+                assert!(photocraft_ui_egui::ai_segment::quick_stroke(&mut app, &[pt], !add, false, serde_json::json!({})));
+                settle(&mut app);
+                res.push(iou(&sel(&app)));
+            }
+            while res.len() < 4 {
+                let l = res[res.len() - 1];
+                res.push(l);
+            }
+            println!("{n} {:.3} {:.3} {:.3} {:.3}", res[0], res[1], res[2], res[3]);
+            for k in 0..4 {
+                tot[k] += res[k];
+            }
+        }
+        let k = names.len().max(1) as f32;
+        println!("app mean IoU after stroke, +1, +2, +3: {:.3} {:.3} {:.3} {:.3}", tot[0] / k, tot[1] / k, tot[2] / k, tot[3] / k);
+    }
+
+    /// Select Subject through the app against salient-object ground truth (e.g. DUTS-TE):
+    /// `HORIX_AI_DIR=… HORIX_AI_SUBJECT_EVAL=<dir of NAME.ppm / NAME.pgm> cargo test -p photocraft
+    /// --release ai_model -- --ignored --nocapture`.
+    #[test]
+    #[ignore = "needs the onnxruntime library, the model and an evaluation set"]
+    fn select_subject_eval() {
+        let Some(dir) = std::env::var_os("HORIX_AI_SUBJECT_EVAL").map(PathBuf::from) else { return };
+        let mut names: Vec<String> = std::fs::read_dir(&dir)
+            .into_iter()
+            .flatten()
+            .filter_map(|e| e.ok()?.file_name().into_string().ok()?.strip_suffix(".ppm").map(String::from))
+            .collect();
+        names.sort();
+        let ctx = egui::Context::default();
+        let mut seg: Option<Box<dyn Segmenter>> = Some(Box::new(NativeSegmenter::start()));
+        let (mut tot, mut etot, mut ms) = (0.0f32, 0.0f32, 0.0f64);
+        for n in &names {
+            let (w, h, rgb) = pnm(&dir.join(format!("{n}.ppm")).to_string_lossy());
+            let (_, _, g) = pnm(&dir.join(format!("{n}.pgm")).to_string_lossy());
+            let mut doc = photocraft_doc::Document::new("t", photocraft_geom::Size::new(w as u32, h as u32), photocraft_color::ColorMode::Rgb, photocraft_color::SampleType::U8);
+            let mut l = photocraft_doc::Layer::raster("bg", photocraft_color::PixelFormat::RGBA8);
+            let px: Vec<f32> = rgb.chunks_exact(3).flat_map(|p| [f32::from(p[0]) / 255.0, f32::from(p[1]) / 255.0, f32::from(p[2]) / 255.0, 1.0]).collect();
+            if let Some(s) = l.surface_mut() {
+                s.write_region(photocraft_geom::Rect::new(0, 0, w as i32, h as i32), &px);
+            }
+            doc.layers.push(l);
+            let mut session = photocraft_engine::Session::new();
+            session.add_document(doc, None);
+            let mut app = PhotocraftApp::new(session, Services { segmenter: seg.take(), ..Default::default() });
+            let t0 = std::time::Instant::now();
+            app.run("select.subject", serde_json::json!({})).unwrap();
+            for _ in 0..3000 {
+                photocraft_ui_egui::ai_segment::poll(&mut app, &ctx);
+                if !photocraft_ui_egui::ai_segment::busy(&app) {
+                    break;
+                }
+                std::thread::sleep(std::time::Duration::from_millis(5));
+            }
+            ms += t0.elapsed().as_secs_f64() * 1000.0;
+            let s = app.session.active().and_then(|s| s.doc.selection.clone());
+            let sel: Vec<bool> = (0..w * h).map(|k| s.as_ref().is_some_and(|s| s.sample_channel((k % w) as i32, (k / w) as i32, 0) >= 0.5)).collect();
+            let gt: Vec<bool> = g.iter().map(|v| *v > 127).collect();
+            // The edge band: pixels within 1% of the long side of the true outline.
+            let r = (w.max(h) / 100).max(2);
+            let mut edge = vec![0u32; (w + 1) * (h + 1)];
+            for y in 0..h {
+                for x in 0..w {
+                    let k = y * w + x;
+                    let e = (x + 1 < w && gt[k] != gt[k + 1]) || (y + 1 < h && gt[k] != gt[k + w]);
+                    edge[(y + 1) * (w + 1) + x + 1] = u32::from(e) + edge[y * (w + 1) + x + 1] + edge[(y + 1) * (w + 1) + x] - edge[y * (w + 1) + x];
+                }
+            }
+            let near = |x: usize, y: usize| {
+                let (x0, y0, x1, y1) = (x.saturating_sub(r), y.saturating_sub(r), (x + r + 1).min(w), (y + r + 1).min(h));
+                edge[y1 * (w + 1) + x1] + edge[y0 * (w + 1) + x0] > edge[y0 * (w + 1) + x1] + edge[y1 * (w + 1) + x0]
+            };
+            let (mut i, mut u, mut ei, mut eu) = (0usize, 0usize, 0usize, 0usize);
+            for k in 0..w * h {
+                let (a, b) = (sel[k], gt[k]);
+                i += usize::from(a && b);
+                u += usize::from(a || b);
+                if near(k % w, k / w) {
+                    ei += usize::from(a && b);
+                    eu += usize::from(a || b);
+                }
+            }
+            let (iou, eiou) = (i as f32 / u.max(1) as f32, ei as f32 / eu.max(1) as f32);
+            println!("{n} {iou:.3} edge {eiou:.3} {}", app.ui.status);
+            tot += iou;
+            etot += eiou;
+            seg = app.services.segmenter.take();
+        }
+        let k = names.len().max(1);
+        println!("Select Subject mean IoU {:.4}, edge band {:.4} ({:.0} ms avg)", tot / k as f32, etot / k as f32, ms / k as f64);
+    }
+
+    /// Object Selection, AI against the classic tool, with the object's box (`box` in NAME.json,
+    /// `[x, y, w, h]`): `HORIX_AI_DIR=… HORIX_AI_EVAL=<dir> cargo test -p photocraft --release
+    /// object_selection_eval -- --ignored --nocapture`.
+    #[test]
+    #[ignore = "needs the onnxruntime library, the models and an evaluation set"]
+    fn object_selection_eval() {
+        let Some(dir) = std::env::var_os("HORIX_AI_EVAL").map(PathBuf::from) else { return };
+        let mut names: Vec<String> = std::fs::read_dir(&dir)
+            .into_iter()
+            .flatten()
+            .filter_map(|e| e.ok()?.file_name().into_string().ok()?.strip_suffix(".json").map(String::from))
+            .collect();
+        names.sort();
+        let ctx = egui::Context::default();
+        let mut seg: Option<Box<dyn Segmenter>> = Some(Box::new(NativeSegmenter::start()));
+        let (mut ai, mut classic, mut n) = (0.0f32, 0.0f32, 0);
+        for name in &names {
+            let (w, h, rgb) = pnm(&dir.join(format!("{name}.ppm")).to_string_lossy());
+            let (_, _, g) = pnm(&dir.join(format!("{name}.pgm")).to_string_lossy());
+            let meta: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(dir.join(format!("{name}.json"))).unwrap_or_default()).unwrap_or_default();
+            let Some(b) = meta["box"].as_array().map(|a| a.iter().filter_map(serde_json::Value::as_f64).collect::<Vec<f64>>()) else { continue };
+            if b.len() != 4 {
+                continue;
+            }
+            // A box a little larger than the object, as drawn by hand.
+            let (mx, my) = (b[2] * 0.05 + 2.0, b[3] * 0.05 + 2.0);
+            let rect = [(b[0] - mx).max(0.0), (b[1] - my).max(0.0), b[2] + 2.0 * mx, b[3] + 2.0 * my];
+            let make = |seg: Option<Box<dyn Segmenter>>| {
+                let mut doc = photocraft_doc::Document::new("t", photocraft_geom::Size::new(w as u32, h as u32), photocraft_color::ColorMode::Rgb, photocraft_color::SampleType::U8);
+                let mut l = photocraft_doc::Layer::raster("bg", photocraft_color::PixelFormat::RGBA8);
+                let px: Vec<f32> = rgb.chunks_exact(3).flat_map(|p| [f32::from(p[0]) / 255.0, f32::from(p[1]) / 255.0, f32::from(p[2]) / 255.0, 1.0]).collect();
+                if let Some(s) = l.surface_mut() {
+                    s.write_region(photocraft_geom::Rect::new(0, 0, w as i32, h as i32), &px);
+                }
+                doc.layers.push(l);
+                let mut session = photocraft_engine::Session::new();
+                session.add_document(doc, None);
+                PhotocraftApp::new(session, Services { segmenter: seg, ..Default::default() })
+            };
+            let iou = |app: &PhotocraftApp| {
+                let s = app.session.active().and_then(|s| s.doc.selection.clone());
+                let (mut i, mut u) = (0usize, 0usize);
+                for k in 0..w * h {
+                    let a = s.as_ref().is_some_and(|s| s.sample_channel((k % w) as i32, (k / w) as i32, 0) >= 0.5);
+                    let bb = g[k] > 127;
+                    i += usize::from(a && bb);
+                    u += usize::from(a || bb);
+                }
+                i as f32 / u.max(1) as f32
+            };
+            let mut app = make(seg.take());
+            assert!(photocraft_ui_egui::ai_segment::object_box(&mut app, rect, photocraft_algo::selection::SelectionMode::Replace, false, serde_json::json!({})));
+            for _ in 0..3000 {
+                photocraft_ui_egui::ai_segment::poll(&mut app, &ctx);
+                if !photocraft_ui_egui::ai_segment::busy(&app) {
+                    break;
+                }
+                std::thread::sleep(std::time::Duration::from_millis(5));
+            }
+            let a = iou(&app);
+            seg = app.services.segmenter.take();
+            let mut capp = make(None);
+            let _ = capp.run("select.object", serde_json::json!({"rect": rect}));
+            let c = iou(&capp);
+            println!("{name} ai {a:.3} classic {c:.3}");
+            ai += a;
+            classic += c;
+            n += 1;
+        }
+        let k = n.max(1) as f32;
+        println!("Object Selection mean IoU ({n}): AI {:.4}, classic {:.4}", ai / k, classic / k);
+    }
+
+    fn biggest(m: &[bool], w: usize, h: usize) -> Option<Vec<usize>> {
+        let mut seen = vec![false; w * h];
+        let mut best: Option<Vec<usize>> = None;
+        for s in 0..w * h {
+            if !m[s] || seen[s] {
+                continue;
+            }
+            let mut c = vec![s];
+            seen[s] = true;
+            let mut k = 0;
+            while k < c.len() {
+                let i = c[k];
+                k += 1;
+                let (x, y) = (i % w, i / w);
+                for (nx, ny) in [(x.wrapping_sub(1), y), (x + 1, y), (x, y.wrapping_sub(1)), (x, y + 1)] {
+                    if nx < w && ny < h && m[ny * w + nx] && !seen[ny * w + nx] {
+                        seen[ny * w + nx] = true;
+                        c.push(ny * w + nx);
+                    }
+                }
+            }
+            if best.as_ref().is_none_or(|b| c.len() > b.len()) {
+                best = Some(c);
+            }
+        }
+        best
+    }
+
+    fn deepest(c: &[usize], w: usize, h: usize) -> usize {
+        let mut d = vec![0.0f32; w * h];
+        for i in c {
+            d[*i] = 1e9;
+        }
+        for _ in 0..2 {
+            for i in 0..w * h {
+                let (x, y) = (i % w, i / w);
+                if x > 0 {
+                    d[i] = d[i].min(d[i - 1] + 1.0);
+                }
+                if y > 0 {
+                    d[i] = d[i].min(d[i - w] + 1.0);
+                }
+            }
+            for i in (0..w * h).rev() {
+                let (x, y) = (i % w, i / w);
+                if x + 1 < w {
+                    d[i] = d[i].min(d[i + 1] + 1.0);
+                }
+                if y + 1 < h {
+                    d[i] = d[i].min(d[i + w] + 1.0);
+                }
+            }
+        }
+        c.iter().copied().max_by(|a, b| d[*a].total_cmp(&d[*b])).unwrap_or(c[0])
+    }
+}
