+        assert_eq!(c.len(), 2);
+        assert!(!c[0].2 && c[1].2, "the refinement gets the previous mask");
+        assert!(c[1].1.contains(&0.0) && c[1].1.contains(&1.0));
+        // A selection made otherwise starts a new run; ⌥ on it goes to the classic tool.
+        drop(c);
+        app.run("select.rect", serde_json::json!({"x": 0, "y": 0, "width": 10, "height": 10})).unwrap();
+        assert!(!quick_stroke(&mut app, &[[5.0, 5.0]], true, false, serde_json::json!({})));
+    }
+
+    #[test]
+    fn content_key_ignores_selection_changes() {
+        let mut s = photocraft_engine::Session::new();
+        s.execute("file.new", serde_json::json!({"width": 64, "height": 64})).unwrap();
+        let k = |s: &photocraft_engine::Session| {
+            let st = s.active().unwrap();
+            content_key(&st.doc, st.active_layer, false).0
+        };
+        let a = k(&s);
+        s.execute("select.rect", serde_json::json!({"x": 0, "y": 0, "width": 8, "height": 8})).unwrap();
+        assert_eq!(k(&s), a);
+        s.execute("edit.fill", serde_json::json!({"contents": "black"})).unwrap();
+        assert_ne!(k(&s), a);
+    }
+}
diff --git a/crates/ui-egui/src/gpu_status.rs b/crates/ui-egui/src/gpu_status.rs
