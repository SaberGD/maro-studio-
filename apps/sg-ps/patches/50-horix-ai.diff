+/// Object Selection click with Object Finder (document point): the object under it.
+pub fn object_point(app: &mut PhotocraftApp, pt: [f64; 2], mode: SelectionMode, all_layers: bool) -> bool {
+    if !begin(app, Kind::Object, all_layers, mode, false) {
+        return false;
+    }
+    let Some(r) = app.ai.run.as_mut() else { return false };
+    let s = r.step as f64;
+    let (iw, ih) = (r.img.0 as f64, r.img.1 as f64);
+    r.points.push([(pt[0] / s).clamp(0.0, iw - 1.0) as f32, (pt[1] / s).clamp(0.0, ih - 1.0) as f32]);
+    r.labels.push(1.0);
+    r.wanted = true;
+    r.fallback = None;
+    send(app);
+    true
+}
+
+/// Object Finder: highlight the object under the pointer (document point; `None` clears it).
+/// Runs only on an image already analysed for Object Selection, one decode at a time.
+pub fn hover(app: &mut PhotocraftApp, pt: Option<[f64; 2]>, zoom: f32) {
+    let Some(pt) = pt else {
+        app.ai.hover_tex = None;
+        app.ai.hover_pt = None;
+        return;
+    };
+    if !available(app) || app.ai.hover_req.is_some() || app.ai.run.as_ref().is_some_and(|r| r.wanted) || app.ai.in_flight.is_some() {
+        return;
+    }
+    let Some((key, step, w, h)) = app.ai.frame else { return };
+    if app.ai.embedded != Some(key) || app.session.active().is_none_or(|s| Some((s.doc.id, s.revision, app.ui.tool_options.sample_all_layers)) != app.ai.checked) {
+        return;
+    }
+    let p = [(pt[0] / step as f64).clamp(0.0, w as f64 - 1.0) as f32, (pt[1] / step as f64).clamp(0.0, h as f64 - 1.0) as f32];
+    // A new decode once the pointer has moved a few screen pixels.
+    let near = 4.0 / (zoom.max(0.01) * step as f32);
+    if app.ai.hover_pt.is_some_and(|q| (q[0] - p[0]).hypot(q[1] - p[1]) < near) {
+        return;
+    }
+    app.ai.next_req += 1;
+    let req = app.ai.next_req;
+    app.ai.hover_req = Some(req);
+    app.ai.hover_pt = Some(p);
+    if let Some(seg) = app.services.segmenter.as_mut() {
+        seg.decode(key, req, vec![p, [0.0, 0.0]], vec![1.0, -1.0], None);
+    }
+}
+
+/// The Object Finder highlight: a texture over the analysed square (document pixels 0 …
+/// `EMBED_SIDE × step`), drawn by the canvas.
+pub fn hover_overlay(app: &PhotocraftApp) -> Option<(egui::TextureId, f32)> {
+    app.ai.hover_tex.as_ref().map(|(t, side)| (t.id(), *side))
+}
+
+fn set_hover(app: &mut PhotocraftApp, ctx: &egui::Context, logits: &[f32], ious: &[f32]) {
+    let n = LOW * LOW;
+    let k = ious.iter().enumerate().max_by(|a, b| a.1.total_cmp(b.1)).map_or(0, |(i, _)| i);
+    let k = if logits.len() >= (k + 1) * n { k } else { 0 };
+    let Some(low) = logits.get(k * n..(k + 1) * n) else { return };
+    let Some((_, step, w, h)) = app.ai.frame else { return };
+    let cell = EMBED_SIDE as f32 / LOW as f32;
+    let (lw, lh) = (((w as f32 / cell).ceil() as usize).min(LOW), ((h as f32 / cell).ceil() as usize).min(LOW));
+    let mut px = vec![egui::Color32::TRANSPARENT; n];
+    for y in 0..lh {
+        for x in 0..lw {
+            let v = low[y * LOW + x];
+            if v > 0.0 {
+                // Photoshop's Object Finder blue, a little transparent.
+                let a = (1.0 / (1.0 + (-v).exp()) * 120.0) as u8;
+                px[y * LOW + x] = egui::Color32::from_rgba_unmultiplied(40, 120, 255, a);
+            }
+        }
+    }
+    let img = egui::ColorImage::new([LOW, LOW], px);
+    let side = EMBED_SIDE as f32 * step as f32;
+    match app.ai.hover_tex.as_mut() {
+        Some((t, s)) => {
+            t.set(img, egui::TextureOptions::LINEAR);
+            *s = side;
+        }
+        None => app.ai.hover_tex = Some((ctx.load_texture("object-finder", img, egui::TextureOptions::LINEAR), side)),
+    }
+}
+
+/// Object Selection box (document pixels `[x, y, w, h]`), combined with the selection by `mode`.
+pub fn object_box(app: &mut PhotocraftApp, rect: [f64; 4], mode: SelectionMode, all_layers: bool, fallback: serde_json::Value) -> bool {
+    if !begin(app, Kind::Object, all_layers, mode, false) {
+        return false;
+    }
+    let Some(r) = app.ai.run.as_mut() else { return false };
+    let s = r.step as f64;
+    let (iw, ih) = (r.img.0 as f64, r.img.1 as f64);
+    let c = |v: f64, m: f64| (v / s).clamp(0.0, m - 1.0) as f32;
+    r.rect = Some([c(rect[0], iw), c(rect[1], ih), c(rect[0] + rect[2], iw), c(rect[1] + rect[3], ih)]);
+    r.wanted = true;
+    r.fallback = Some(("select.object", fallback));
+    send(app);
+    true
+}
+
+/// Send the run's decode when the image is encoded and nothing is in flight.
+fn send(app: &mut PhotocraftApp) {
+    let Some(r) = app.ai.run.as_mut() else { return };
+    if !r.wanted || app.ai.embedded != Some(r.key) {
+        return;
+    }
+    if app.ai.in_flight.is_some() {
+        app.ai.dirty = true;
+        return;
+    }
+    let mut pts = Vec::new();
+    let mut labels = Vec::new();
+    if let Some(b) = r.rect {
+        pts.extend([[b[0], b[1]], [b[2], b[3]]]);
+        labels.extend([2.0, 3.0]);
+    }
+    pts.extend(r.points.iter().copied());
+    labels.extend(r.labels.iter().copied());
+    if r.rect.is_none() {
+        // SAM's padding point (no box).
+        pts.push([0.0, 0.0]);
+        labels.push(-1.0);
+    }
+    r.wanted = false;
+    app.ai.next_req += 1;
+    let req = app.ai.next_req;
+    app.ai.in_flight = Some(req);
+    let (key, prev) = (r.key, r.prev.clone());
+    if let Some(seg) = app.services.segmenter.as_mut() {
+        seg.decode(key, req, pts, labels, prev);
+    }
+}
+
+/// Handle the model's results; call every frame.
+pub fn poll(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    // Prepare the models in the background soon after start-up, so the first selection is quick.
+    if !app.ai.preload_sent
+        && ctx.input(|i| i.time) > PRELOAD_AFTER_S
+        && let Some(s) = app.services.segmenter.as_mut()
+    {
+        app.ai.preload_sent = true;
+        s.preload();
+    }
+    let events = match app.services.segmenter.as_mut() {
+        Some(s) => s.poll(),
+        None => return,
+    };
+    if app.ai.preparing.is_some() {
+        ctx.request_repaint_after(std::time::Duration::from_millis(120));
+    }
+    for e in events {
+        match e {
+            SegEvent::Progress { fraction, stage } => {
+                let started = app.ai.preparing.as_ref().map_or_else(|| clock_ms(app), |p| p.2);
+                app.ai.preparing = Some((fraction, stage, started));
+                ctx.request_repaint_after(std::time::Duration::from_millis(120));
+            }
+            SegEvent::Ready => {
+                // Say so when it took long enough to have been noticed.
+                if let Some((_, _, started)) = app.ai.preparing.take()
+                    && clock_ms(app) - started > 1500.0
+                {
+                    crate::notices::post_brief(
+                        app,
+                        ctx,
+                        tl!("AI tools are ready"),
+                        vec![tl!("Select Subject, Quick Selection and Object Selection now respond right away.").to_string()],
+                    );
+                }
+            }
+            SegEvent::Encoded { key } => {
+                app.ai.embedded = Some(key);
+                if app.ai.encoding == Some(key) {
+                    app.ai.encoding = None;
+                }
+                send(app);
+            }
+            SegEvent::Decoded { req, logits, ious } => {
+                if app.ai.hover_req == Some(req) {
+                    app.ai.hover_req = None;
+                    if app.ai.hover_pt.is_some() {
+                        set_hover(app, ctx, &logits, &ious);
+                    }
+                    continue;
+                }
+                if app.ai.in_flight != Some(req) {
+                    continue;
+                }
+                app.ai.in_flight = None;
+                apply(app, &logits, &ious);
+                if std::mem::take(&mut app.ai.dirty)
+                    && let Some(r) = app.ai.run.as_mut()
+                {
+                    r.wanted = true;
+                    send(app);
+                }
+            }
+            SegEvent::Failed { msg } => {
+                app.ai.failed = Some(msg.clone());
+                app.ai.encoding = None;
+                app.ai.in_flight = None;
+                app.ai.hover_req = None;
+                app.ai.hover_tex = None;
+                let fallback = app.ai.run.take().and_then(|r| r.fallback);
+                app.ui.status = format!("HORIX AI unavailable ({msg}): using the classic tool");
+                app.ui.status_error = true;
+                if let Some((cmd, p)) = fallback {
+                    let _ = app.run(cmd, p);
+                }
+            }
+            SegEvent::Subject { req, mask } => {
+                if let Some(run) = app.ai.subject.take_if(|r| r.req == req) {
+                    apply_subject(app, run, &mask);
+                }
+            }
+            SegEvent::SubjectFailed { msg } => {
+                app.ai.subject_failed = Some(msg.clone());
+                if let Some(run) = app.ai.subject.take() {
+                    app.ui.status = format!("HORIX AI unavailable ({msg}): using the classic Select Subject");
+                    app.ui.status_error = true;
+                    let _ = app.run("select.subject", run.params);
+                }
+            }
+        }
+    }
+    prefetch(app);
+    if app.ai.hover_req.is_some() {
+        ctx.request_repaint_after(std::time::Duration::from_millis(30));
+    }
+    if busy(app) {
+        app.ui.status = if app.ai.subject.is_some() {
+            let elapsed = app
+                .ai
+                .subject
+                .as_ref()
+                .map(|s| crate::jobs_ui::elapsed(clock_ms(app) - s.started_ms))
+                .unwrap_or_else(|| "0.0 s".into());
+            format!("HORIX AI: finding the subject… {elapsed}")
+        } else if app.ai.encoding.is_some() {
+            "HORIX AI: analyzing the image…".into()
+        } else {
+            "HORIX AI: selecting…".into()
+        };
+        app.ui.status_error = false;
+        ctx.request_repaint_after(std::time::Duration::from_millis(40));
+    }
+}
+
+/// A decode result: the best mask (first decode) or the refined one, edge-snapped, combined with
+/// the run's starting selection.
+fn apply(app: &mut PhotocraftApp, logits: &[f32], ious: &[f32]) {
+    let Some(r) = app.ai.run.as_mut() else { return };
+    let n = LOW * LOW;
+    if logits.len() < n {
+        return;
+    }
+    // The first answer picks the most confident of SAM's masks; refinements use the first.
+    let k = if r.decodes == 0 { ious.iter().enumerate().max_by(|a, b| a.1.total_cmp(b.1)).map_or(0, |(i, _)| i) } else { 0 };
+    let k = if logits.len() >= (k + 1) * n { k } else { 0 };
+    let low = logits[k * n..(k + 1) * n].to_vec();
+    r.prev = Some(low.clone());
+    r.decodes += 1;
+    let (doc, step, img, all, mode) = (r.doc, r.step, r.img, r.all_layers, r.mode);
+    let base = r.base.clone();
+    let Some(st) = app.session.active().filter(|s| s.doc.id == doc) else { return };
+    let canvas = st.doc.bounds();
+    let region = region_from_logits(&low, step, img.0, img.1, canvas);
+    // Snap the upsampled edge to the image (the model sees at most 1024 px).
+    let region = match region {
+        Some(rg) => photocraft_engine::smartselect_cmds::enhance_region(&app.session, all, &rg, (step as f32 * 2.0 + 2.0).min(64.0)).or(Some(rg)),
+        None => None,
+    };
+    let label = if app.ai.run.as_ref().is_some_and(|r| r.kind == Kind::Object) { "Object Selection" } else { "Quick Selection" };
+    let res = photocraft_engine::smartselect_cmds::set_selection_from(&mut app.session, label, base.as_ref(), region.as_ref(), mode);
+    if let Err(e) = res {
+        app.ui.status = e.to_string();
+        app.ui.status_error = true;
+        return;
+    }
+    app.sync_views();
+    let rev = app.session.active().map(|s| s.revision).unwrap_or(0);
+    if let Some(r) = app.ai.run.as_mut() {
+        r.revision = rev;
+    }
+    app.ui.status = "HORIX AI selection".into();
+    app.ui.status_error = false;
+}
