 const PREFS_KEY: &str = "horix.preferences";
 
+/// HORIX AI selection in the browser: the page's `window.horixAi` (index.html) runs MobileSAM and
+/// IS-Net with onnxruntime-web; results are polled every frame.
+struct WebSegmenter;
+
+impl WebSegmenter {
+    fn api() -> Option<wasm_bindgen::JsValue> {
+        let w = web_sys::window()?;
+        js_sys::Reflect::get(&w, &"horixAi".into()).ok().filter(|v| v.is_object())
+    }
+    fn call(name: &str, args: &[wasm_bindgen::JsValue]) -> Option<wasm_bindgen::JsValue> {
+        use wasm_bindgen::JsCast;
+        let api = Self::api()?;
+        let f = js_sys::Reflect::get(&api, &name.into()).ok()?.dyn_into::<js_sys::Function>().ok()?;
+        f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+    }
+}
+
+impl photocraft_ui_egui::ai_segment::Segmenter for WebSegmenter {
+    fn encode(&mut self, key: u64, rgb: Vec<u8>, w: u32, h: u32) {
+        let bytes = js_sys::Uint8Array::from(rgb.as_slice());
+        Self::call("encode", &[key.to_string().into(), bytes.into(), w.into(), h.into()]);
+    }
+    fn decode(&mut self, key: u64, req: u64, points: Vec<[f32; 2]>, labels: Vec<f32>, prev: Option<Vec<f32>>) {
+        let coords: Vec<f32> = points.iter().flatten().copied().collect();
+        let prev = prev.map_or(wasm_bindgen::JsValue::NULL, |p| js_sys::Float32Array::from(p.as_slice()).into());
+        Self::call(
+            "decode",
+            &[key.to_string().into(), (req as f64).into(), js_sys::Float32Array::from(coords.as_slice()).into(), js_sys::Float32Array::from(labels.as_slice()).into(), prev],
+        );
+    }
+    fn poll(&mut self) -> Vec<photocraft_ui_egui::ai_segment::SegEvent> {
+        use photocraft_ui_egui::ai_segment::SegEvent;
+        let Some(list) = Self::call("poll", &[]) else {
+            return Vec::new();
+        };
+        let get = |o: &wasm_bindgen::JsValue, k: &str| js_sys::Reflect::get(o, &k.into()).unwrap_or(wasm_bindgen::JsValue::UNDEFINED);
+        let f32s = |v: wasm_bindgen::JsValue| js_sys::Float32Array::new(&v).to_vec();
+        js_sys::Array::from(&list)
+            .iter()
+            .filter_map(|e| match get(&e, "type").as_string()?.as_str() {
+                "encoded" => Some(SegEvent::Encoded { key: get(&e, "key").as_string()?.parse().ok()? }),
+                "decoded" => Some(SegEvent::Decoded { req: get(&e, "req").as_f64()? as u64, logits: f32s(get(&e, "logits")), ious: f32s(get(&e, "ious")) }),
+                "failed" => Some(SegEvent::Failed { msg: get(&e, "msg").as_string().unwrap_or_default() }),
+                "subject" => Some(SegEvent::Subject { req: get(&e, "req").as_f64()? as u64, mask: f32s(get(&e, "mask")) }),
+                "subjectFailed" => Some(SegEvent::SubjectFailed { msg: get(&e, "msg").as_string().unwrap_or_default() }),
+                "progress" => Some(SegEvent::Progress { fraction: get(&e, "fraction").as_f64()? as f32, stage: get(&e, "stage").as_string().unwrap_or_default() }),
+                "ready" => Some(SegEvent::Ready),
+                _ => None,
+            })
+            .collect()
+    }
+    fn subject_side(&self) -> Option<u32> {
+        Some(SUBJECT_SIDE)
+    }
+    fn subject(&mut self, req: u64, rgb: Vec<u8>, side: u32) {
+        Self::call("subject", &[(req as f64).into(), js_sys::Uint8Array::from(rgb.as_slice()).into(), side.into()]);
+    }
+    fn preload(&mut self) {
+        Self::call("preload", &[]);
+    }
+}
+
+/// IS-Net's input side (Select Subject; the browser runs the half-precision export).
+const SUBJECT_SIDE: u32 = 1024;
+
 fn local_storage() -> Option<web_sys::Storage> {
     web_sys::window()?.local_storage().ok().flatten()
 }
