+// HORIX AI selection support: the model runs in the app (ui-egui `ai_segment`); these give it the
+// pixels to analyse and store what it found.
+
+/// The pixels Quick / Object Selection analyse (the active layer, or the composite with
+/// `all_layers`), box-downscaled by a whole step so the longest side is at most `max_side`:
+/// (RGB bytes, width, height, step).
+pub fn sample_rgb8(s: &Session, all_layers: bool, max_side: u32) -> Option<(Vec<u8>, u32, u32, usize)> {
+    with_sampler(s, all_layers, |smp, doc| {
+        let b = doc.bounds();
+        if b.is_empty() {
+            return None;
+        }
+        let long = b.width().max(b.height()) as usize;
+        let step = long.div_ceil(max_side.max(1) as usize).max(1);
+        let img = smp.rgb_scaled(b, step);
+        let rgb = img.px.iter().flat_map(|p| p.map(|v| (v.clamp(0.0, 1.0) * 255.0).round() as u8)).collect();
+        Some((rgb, img.w as u32, img.h as u32, step))
+    })
+    .ok()
+    .flatten()
+}
+
+/// Snaps a model's mask to the image edges at full resolution (Quick Selection's Auto-Enhance,
+/// with a band `band` pixels wide: about the model's upsampling factor).
+pub fn enhance_region(s: &Session, all_layers: bool, r: &Region, band: f32) -> Option<Region> {
+    let p = RefineParams { radius: band.max(1.0), ..ENHANCE };
+    with_sampler(s, all_layers, |smp, doc| matting::refine_mask(smp, &matting::region_reader(r), r.bbox, doc.bounds(), &p)).ok().flatten()
+}
+
+/// Stores `base` combined with `region` by `mode` as the selection, in one history step labelled
+/// `label`. Returns whether anything is selected.
+pub fn set_selection_from(s: &mut Session, label: &str, base: Option<&photocraft_raster::Surface>, region: Option<&Region>, mode: SelectionMode) -> Result<bool> {
+    s.edit(label, |doc, _| {
+        doc.selection = combine_region(base, region, mode);
+        Ok(doc.selection.is_some())
+    })
+}
