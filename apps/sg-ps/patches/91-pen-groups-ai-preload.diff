+/// ⌘Z, ⌫ or Delete while drawing: remove the last anchor (the path is dropped with its first).
+pub fn pen_undo_point(app: &mut PhotocraftApp) {
+    if let Some(pen) = app.ui.pen.as_mut() {
+        pen.knots.pop();
+        pen.dragging = false;
+        if pen.knots.is_empty() || (pen.resume.is_some() && pen.knots.len() < 2) {
+            app.ui.pen = None;
+        }
+    }
+}
