+/// Which tool the Pen acts as while a modifier is held, as in Photoshop: ⌘/Ctrl is the Direct
+/// Selection tool, ⌥/Alt the Convert Point tool.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum PenMode {
+    Draw,
+    Direct,
+    Convert,
+}
+
+pub fn pen_mode(app: &PhotocraftApp, mods: egui::Modifiers) -> PenMode {
+    if !matches!(app.ui.tool_options.pen_kind.as_str(), "standard" | "curvature") {
+        PenMode::Draw
+    } else if mods.command {
+        PenMode::Direct
+    } else if mods.alt {
+        PenMode::Convert
+    } else {
+        PenMode::Draw
+    }
+}
+
+/// Pen press with the modifiers held: draw, or edit a point of the path (⌘ / ⌥).
+pub fn pen_press(app: &mut PhotocraftApp, x: f64, y: f64, mods: egui::Modifiers) {
+    match pen_mode(app, mods) {
+        PenMode::Draw => pen_down(app, x, y),
+        mode => point_press(app, [x, y], mode == PenMode::Convert),
+    }
+}
+
+/// A part of a path the Pen's ⌘ / ⌥ grab: an anchor, one of its handles, new handles pulled out
+/// of an anchor (⌥-drag), or the whole path (⌘-drag on a segment).
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Part {
+    Anchor(usize, usize),
+    In(usize, usize),
+    Out(usize, usize),
+    Pull(usize, usize),
+    Whole,
+}
+
+/// An anchor or handle being dragged (see [`pen_press`]).
+#[derive(Clone, Debug, PartialEq)]
+pub struct PathDrag {
+    /// The path being drawn (`None`) or a saved one.
+    target: Option<PathTarget>,
+    original: Path,
+    path: Path,
+    part: Part,
+    start: [f64; 2],
+    convert: bool,
+    moved: bool,
+}
+
+fn pen_as_path(pen: &PenPath) -> Path {
+    let knots = pen.knots.iter().map(|k| Knot { anchor: point(k[0]), in_ctrl: point(k[1]), out_ctrl: point(k[2]), smooth: k[1] != k[0] || k[2] != k[0] }).collect();
+    Path { subpaths: vec![Subpath { closed: false, knots, ..Default::default() }], ..Default::default() }
+}
+
+/// The path ⌘ / ⌥ edit: the one being drawn, else the targeted vector mask, the active shape's
+/// path or the Work Path (unless hidden).
+fn editable_path(app: &PhotocraftApp) -> Option<(Option<PathTarget>, Path)> {
+    if let Some(pen) = app.ui.pen.as_ref().filter(|p| !p.knots.is_empty()) {
+        return Some((None, pen_as_path(pen)));
+    }
+    target_path(app).filter(|(t, _)| !(matches!(t, PathTarget::Work) && app.ui.paths_hidden)).map(|(t, p)| (Some(t), p))
+}
+
+/// The handle or anchor under the pointer (handles first: they sit on top).
+fn part_at(path: &Path, at: [f64; 2], tol: f64) -> Option<Part> {
+    for (si, sub) in path.subpaths.iter().enumerate() {
+        for (ki, k) in sub.knots.iter().enumerate() {
+            let (a, i, o) = knot_points(k);
+            if o != a && distance(o, at) <= tol {
+                return Some(Part::Out(si, ki));
+            }
+            if i != a && distance(i, at) <= tol {
+                return Some(Part::In(si, ki));
+            }
+        }
+    }
+    nearest_anchor(path, at).filter(|(_, _, d)| *d <= tol).map(|(si, ki, _)| Part::Anchor(si, ki))
+}
+
+fn point_press(app: &mut PhotocraftApp, at: [f64; 2], convert: bool) {
+    let tol = 8.0 / app.current_zoom().max(0.01) as f64;
+    let Some((target, path)) = editable_path(app) else { return };
+    let part = match part_at(&path, at, tol) {
+        Some(Part::Anchor(si, ki)) if convert => Some(Part::Pull(si, ki)),
+        Some(p) => Some(p),
+        None if !convert && nearest_segment(&path, at).is_some_and(|(_, _, _, d)| d <= tol) => Some(Part::Whole),
+        None => None,
+    };
+    let Some(part) = part else {
+        // ⌘-click away from the path finishes the one being drawn, as in Photoshop.
+        if !convert && app.ui.pen.is_some() {
+            pen_commit(app, false);
+        }
+        return;
+    };
+    app.ui.paths_hidden = false;
+    app.ui.path_drag = Some(PathDrag { target, original: path.clone(), path, part, start: at, convert, moved: false });
+}
+
+/// `handle` mirrored through `anchor`, at `len` from it (Photoshop keeps a smooth point's other
+/// handle in line, at its own length).
+fn opposite(anchor: [f64; 2], handle: [f64; 2], len: f64) -> [f64; 2] {
+    let (dx, dy) = (anchor[0] - handle[0], anchor[1] - handle[1]);
+    let d = dx.hypot(dy);
+    if d < 1e-9 { anchor } else { [anchor[0] + dx / d * len, anchor[1] + dy / d * len] }
+}
+
+fn drag_point(app: &mut PhotocraftApp, at: [f64; 2]) {
+    let Some(d) = app.ui.path_drag.as_mut() else { return };
+    let (dx, dy) = (at[0] - d.start[0], at[1] - d.start[1]);
+    if dx.abs() + dy.abs() < 0.5 && !d.moved {
+        return;
+    }
+    d.moved = true;
+    let mut path = d.original.clone();
+    let shift = |p: Point| Point::new(p.x + dx, p.y + dy);
+    match d.part {
+        Part::Whole => path = path.transform(&Affine::translate(dx, dy)),
+        Part::Anchor(si, ki) => {
+            let k = &mut path.subpaths[si].knots[ki];
+            *k = Knot { anchor: shift(k.anchor), in_ctrl: shift(k.in_ctrl), out_ctrl: shift(k.out_ctrl), smooth: k.smooth };
+        }
+        Part::In(si, ki) | Part::Out(si, ki) => {
+            let k = &mut path.subpaths[si].knots[ki];
+            let (a, i, o) = knot_points(k);
+            let outgoing = matches!(d.part, Part::Out(..));
+            let (moved, other) = if outgoing { (o, i) } else { (i, o) };
+            let new = [moved[0] + dx, moved[1] + dy];
+            // ⌥ (Convert Point) moves one handle alone; ⌘ keeps a smooth point smooth.
+            let other = if k.smooth && !d.convert && other != a { opposite(a, new, distance(a, other)) } else { other };
+            let (ni, no) = if outgoing { (other, new) } else { (new, other) };
+            *k = Knot { anchor: point(a), in_ctrl: point(ni), out_ctrl: point(no), smooth: k.smooth && !d.convert };
+        }
+        Part::Pull(si, ki) => {
+            let k = &mut path.subpaths[si].knots[ki];
+            let a = [k.anchor.x, k.anchor.y];
+            *k = Knot::smooth(point(a), point([2.0 * a[0] - at[0], 2.0 * a[1] - at[1]]), point(at));
+        }
+    }
+    d.path = path;
+    if d.target.is_none() {
+        write_back_pen(app);
+    }
+}
+
+/// The dragged copy of the path being drawn goes back into the Pen's knots.
+fn write_back_pen(app: &mut PhotocraftApp) {
+    let (Some(d), Some(pen)) = (app.ui.path_drag.as_ref(), app.ui.pen.as_mut()) else { return };
+    if let Some(sub) = d.path.subpaths.first() {
+        pen.knots = sub.knots.iter().map(|k| [knot_points(k).0, knot_points(k).1, knot_points(k).2]).collect();
+    }
+}
+
+fn finish_point_drag(app: &mut PhotocraftApp) {
+    let Some(mut d) = app.ui.path_drag.take() else { return };
+    if !d.moved {
+        // ⌥-click on an anchor without dragging: a corner point (no handles).
+        let Part::Pull(si, ki) = d.part else { return };
+        let a = d.path.subpaths[si].knots[ki].anchor;
+        d.path.subpaths[si].knots[ki] = Knot::corner(a.x, a.y);
+    }
+    match d.target {
+        None => {
+            app.ui.path_drag = Some(d);
+            write_back_pen(app);
+            app.ui.path_drag = None;
+        }
+        Some(target) => save_target_path(app, target, &d.path),
+    }
+}
+
+/// An open Work Path subpath whose end point is under the pointer, as a Pen path to continue
+/// from that end (the subpath reversed when it was its first point).
+fn resume_at(app: &PhotocraftApp, at: [f64; 2], tol: f64) -> Option<PenPath> {
+    if app.ui.tool_options.vector_mode == "shape" || targeted_vector_mask(app).is_some() {
+        return None;
+    }
+    let wp = app.session.active()?.doc.work_path.as_ref()?;
+    for (si, sub) in wp.subpaths.iter().enumerate() {
+        if sub.closed || sub.knots.len() < 2 {
+            continue;
+        }
+        let knots: Vec<[[f64; 2]; 3]> = sub.knots.iter().map(|k| [knot_points(k).0, knot_points(k).1, knot_points(k).2]).collect();
+        let last = knots[knots.len() - 1][0];
+        if distance(last, at) <= tol {
+            return Some(PenPath { knots, dragging: false, resume: Some(si) });
+        }
+        if distance(knots[0][0], at) <= tol {
+            // Reversed: segments run the other way, so each knot's handles swap.
+            let knots = knots.into_iter().rev().map(|k| [k[0], k[2], k[1]]).collect();
+            return Some(PenPath { knots, dragging: false, resume: Some(si) });
+        }
+    }
+    None
+}
