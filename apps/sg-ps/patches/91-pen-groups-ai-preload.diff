+//! Deleting a group asks what goes, as in Photoshop ("Delete the group and its contents, or the
+//! group only?"), plus the contents only: the Layers panel's trash button, Delete / ⌫ and Layer ›
+//! Delete all come here when a selected group has layers in it.
+
+use serde_json::json;
+
+use crate::PhotocraftApp;
+
+/// The first selected group that has layers in it (its name), if any.
+fn non_empty_group(app: &PhotocraftApp) -> Option<String> {
+    let st = app.session.active()?;
+    st.selected_layers().into_iter().filter_map(|id| st.doc.layer(id)).find(|l| l.children().is_some_and(|c| !c.is_empty())).map(|l| l.name.clone())
+}
+
+/// Layer › Delete with a non-empty group selected: ask instead of deleting (true when asked).
+pub fn intercept(app: &mut PhotocraftApp) -> bool {
+    let Some(name) = non_empty_group(app) else { return false };
+    app.ui.group_delete = Some(name);
+    true
+}
+
+fn answer(app: &mut PhotocraftApp, command: &str, params: serde_json::Value) {
+    app.ui.group_delete = None;
+    if let Err(e) = app.run(command, params) {
+        app.ui.status = e;
+        app.ui.status_error = true;
+    }
+}
+
+pub fn show(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let Some(name) = app.ui.group_delete.clone() else { return };
+    let t = crate::theme::Tokens::get(ctx);
+    let (mut all, mut group_only, mut contents, mut cancel) = (false, false, false, false);
+    let modal = egui::Modal::new(egui::Id::new("group-delete-prompt")).show(ctx, |ui| {
+        ui.set_max_width(440.0);
+        ui.label(egui::RichText::new(tl!("Delete Group")).font(crate::theme::semibold(15.0)));
+        ui.add_space(4.0);
+        crate::widgets::hairline(ui);
+        ui.add_space(8.0);
+        ui.label(crate::i18n::fmt(tl!("Delete the group “{name}” and its contents, or only one of them?"), &[("name", &name)]));
+        ui.add_space(2.0);
+        ui.label(egui::RichText::new(tl!("Group Only keeps its layers in place; Contents Only keeps the empty group.")).color(t.text_dim).size(12.0));
+        ui.add_space(12.0);
+        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+            ui.spacing_mut().item_spacing.x = 8.0;
+            all = crate::widgets::primary_button(ui, tl!("Group and Contents"), 140.0).clicked();
+            group_only = crate::widgets::secondary_button(ui, tl!("Group Only"), 96.0).clicked();
+            contents = crate::widgets::secondary_button(ui, tl!("Contents Only"), 108.0).clicked();
+            cancel = crate::widgets::secondary_button(ui, tl!("Cancel"), 76.0).clicked();
+        });
+    });
+    // ↩ answers with the default (Group and Contents), Esc or a click outside cancels.
+    all |= ctx.input_mut(|i| i.consume_key(egui::Modifiers::NONE, egui::Key::Enter));
+    if all {
+        answer(app, "layer.delete", json!({}));
+    } else if group_only {
+        answer(app, "layer.deleteGroup", json!({"mode": "groupOnly"}));
+    } else if contents {
+        answer(app, "layer.deleteGroup", json!({"mode": "contents"}));
+    } else if cancel || modal.should_close() {
+        app.ui.group_delete = None;
+    }
+}
+
