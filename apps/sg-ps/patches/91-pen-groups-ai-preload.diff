diff --git a/crates/ui-egui/src/pen_tool_tests.rs b/crates/ui-egui/src/pen_tool_tests.rs
new file mode 100644
index 0000000..349777d
--- /dev/null
+++ b/crates/ui-egui/src/pen_tool_tests.rs
@@ -0,0 +1,200 @@
+//! The Pen as in Photoshop: ⌘Z / ⌫ take back the last point, an open path continues from its end
+//! point, new subpaths join the Work Path, Make Selection hides the path, ⌘ drags anchors and
+//! handles (Direct Selection) and ⌥ converts points. Also ⇧⌘Z redoes.
+
+use egui::{Event, Key, Modifiers, vec2};
+use egui_kittest::Harness;
+use serde_json::json;
+
+use crate::PhotocraftApp;
+use crate::state::Tool;
+use crate::vector_ui::{pen_commit, pen_move, pen_press, pen_up};
+
+fn harness() -> Harness<'static, PhotocraftApp> {
+    let mut s = photocraft_engine::Session::new();
+    s.execute("file.new", json!({"width": 200, "height": 100})).unwrap();
+    let mut h = Harness::builder().with_size(vec2(1280.0, 800.0)).with_max_steps(64).build_eframe(move |cc| {
+        PhotocraftApp::setup_context(&cc.egui_ctx, Default::default());
+        PhotocraftApp::new(s, crate::Services::default())
+    });
+    h.state_mut().ui.tool = Tool::Pen;
+    h.run_steps(6);
+    h
+}
+
+/// ⌘ on the Mac, Ctrl elsewhere, as egui-winit reports them.
+fn command() -> Modifiers {
+    if cfg!(target_os = "macos") {
+        Modifiers { command: true, mac_cmd: true, ..Default::default() }
+    } else {
+        Modifiers { command: true, ctrl: true, ..Default::default() }
+    }
+}
+
+fn press(h: &mut Harness<'_, PhotocraftApp>, key: Key, m: Modifiers) {
+    h.event(Event::ModifiersChanged(m));
+    h.event(Event::Key { key, physical_key: None, pressed: true, repeat: false, modifiers: m });
+    h.event(Event::Key { key, physical_key: None, pressed: false, repeat: false, modifiers: m });
+    h.event(Event::ModifiersChanged(Modifiers::NONE));
+    h.run_steps(3);
+}
+
+/// A click (press and release where pressed) with the Pen.
+fn click(app: &mut PhotocraftApp, x: f64, y: f64, m: Modifiers) {
+    pen_press(app, x, y, m);
+    pen_up(app);
+}
+
+fn drag(app: &mut PhotocraftApp, from: [f64; 2], to: [f64; 2], m: Modifiers) {
+    pen_press(app, from[0], from[1], m);
+    pen_move(app, (from[0] + to[0]) / 2.0, (from[1] + to[1]) / 2.0, m);
+    pen_move(app, to[0], to[1], m);
+    pen_up(app);
+}
+
+fn work(app: &PhotocraftApp) -> photocraft_doc::vector::Path {
+    app.session.active().unwrap().doc.work_path.clone().expect("a work path")
+}
+
+fn anchors(app: &PhotocraftApp, sub: usize) -> Vec<[f64; 2]> {
+    work(app).subpaths[sub].knots.iter().map(|k| [k.anchor.x, k.anchor.y]).collect()
+}
+
+#[test]
+fn cmd_z_and_backspace_take_back_the_last_point() {
+    let mut h = harness();
+    for (x, y) in [(10.0, 10.0), (60.0, 10.0), (60.0, 60.0)] {
+        click(h.state_mut(), x, y, Modifiers::NONE);
+    }
+    h.run_steps(2);
+    press(&mut h, Key::Z, command());
+    assert_eq!(h.state().ui.pen.as_ref().unwrap().knots.len(), 2, "⌘Z removed the last point");
+    press(&mut h, Key::Backspace, Modifiers::NONE);
+    assert_eq!(h.state().ui.pen.as_ref().unwrap().knots.len(), 1);
+    press(&mut h, Key::Delete, Modifiers::NONE);
+    assert!(h.state().ui.pen.is_none(), "the last point gone, the path is dropped");
+    assert!(h.state().session.active().unwrap().doc.work_path.is_none(), "nothing reached the document");
+}
+
+#[test]
+fn an_open_path_continues_from_its_end_point() {
+    let mut h = harness();
+    let app = h.state_mut();
+    click(app, 10.0, 10.0, Modifiers::NONE);
+    click(app, 60.0, 10.0, Modifiers::NONE);
+    pen_commit(app, false);
+    assert_eq!(anchors(app, 0).len(), 2);
+    // Click the last point, then go on.
+    click(app, 60.0, 10.0, Modifiers::NONE);
+    click(app, 60.0, 60.0, Modifiers::NONE);
+    pen_commit(app, false);
+    assert_eq!(work(app).subpaths.len(), 1, "the same subpath, continued");
+    assert_eq!(anchors(app, 0), vec![[10.0, 10.0], [60.0, 10.0], [60.0, 60.0]]);
+    // From the first point it runs the other way; clicking the far end closes it.
+    click(app, 10.0, 10.0, Modifiers::NONE);
+    click(app, 10.0, 60.0, Modifiers::NONE);
+    click(app, 60.0, 60.0, Modifiers::NONE);
+    let w = work(app);
+    assert_eq!(w.subpaths.len(), 1);
+    assert!(w.subpaths[0].closed, "closed on the other end point");
+    assert_eq!(anchors(app, 0).len(), 4);
+}
+
+#[test]
+fn a_second_path_joins_the_work_path_and_make_selection_hides_it() {
+    let mut h = harness();
+    let app = h.state_mut();
+    for (x, y) in [(10.0, 10.0), (40.0, 10.0), (40.0, 40.0)] {
+        click(app, x, y, Modifiers::NONE);
+    }
+    click(app, 10.0, 10.0, Modifiers::NONE); // close
+    for (x, y) in [(100.0, 10.0), (140.0, 10.0), (140.0, 40.0)] {
+        click(app, x, y, Modifiers::NONE);
+    }
+    click(app, 100.0, 10.0, Modifiers::NONE);
+    assert_eq!(work(app).subpaths.len(), 2, "both shapes are in the Work Path");
+    crate::vector_ui::path_to_selection(app, json!({})).unwrap();
+    assert!(app.session.active().unwrap().doc.selection.is_some());
+    assert!(app.ui.paths_hidden, "the path left the canvas");
+    assert!(app.session.active().unwrap().doc.work_path.is_some(), "but stays in the Paths panel");
+    // Drawing again starts a new Work Path.
+    click(app, 10.0, 80.0, Modifiers::NONE);
+    click(app, 50.0, 80.0, Modifiers::NONE);
+    pen_commit(app, false);
+    assert_eq!(work(app).subpaths.len(), 1);
+    assert!(!app.ui.paths_hidden);
+}
+
+#[test]
+fn cmd_drags_anchors_handles_and_the_path() {
+    let mut h = harness();
+    let app = h.state_mut();
+    click(app, 10.0, 10.0, Modifiers::NONE);
+    drag(app, [60.0, 10.0], [80.0, 10.0], Modifiers::NONE); // smooth point, handles ±20 px
+    click(app, 60.0, 60.0, Modifiers::NONE);
+    pen_commit(app, false);
+    // ⌘-drag an anchor: it moves with its handles; nothing else does.
+    drag(app, [60.0, 60.0], [70.0, 70.0], command());
+    assert_eq!(anchors(app, 0)[2], [70.0, 70.0]);
+    assert_eq!(anchors(app, 0)[0], [10.0, 10.0]);
+    // ⌘-drag a handle of the smooth point: the other one stays opposite, at its own length.
+    drag(app, [80.0, 10.0], [60.0, 30.0], command());
+    let k = work(app).subpaths[0].knots[1];
+    assert_eq!([k.out_ctrl.x, k.out_ctrl.y], [60.0, 30.0]);
+    assert!((k.in_ctrl.x - 60.0).abs() < 1e-6 && (k.in_ctrl.y + 10.0).abs() < 1e-6, "in handle mirrored: {:?}", k.in_ctrl);
+    // ⌘-drag a segment moves the whole path.
+    drag(app, [35.0, 10.0], [35.0, 15.0], command());
+    assert_eq!(anchors(app, 0)[0], [10.0, 15.0]);
+}
+
+#[test]
+fn alt_converts_points() {
+    let mut h = harness();
+    let app = h.state_mut();
+    click(app, 10.0, 10.0, Modifiers::NONE);
+    click(app, 60.0, 10.0, Modifiers::NONE);
+    click(app, 60.0, 60.0, Modifiers::NONE);
+    pen_commit(app, false);
+    // ⌥-drag from a corner pulls out smooth handles.
+    drag(app, [60.0, 10.0], [80.0, 10.0], Modifiers::ALT);
+    let k = work(app).subpaths[0].knots[1];
+    assert!(k.smooth);
+    assert_eq!([k.out_ctrl.x, k.out_ctrl.y, k.in_ctrl.x, k.in_ctrl.y], [80.0, 10.0, 40.0, 10.0]);
+    // ⌥-drag one handle moves it alone (a cusp).
+    drag(app, [80.0, 10.0], [80.0, 30.0], Modifiers::ALT);
+    let k = work(app).subpaths[0].knots[1];
+    assert!(!k.smooth);
+    assert_eq!([k.in_ctrl.x, k.in_ctrl.y], [40.0, 10.0]);
+    // ⌥-click the anchor: a corner again.
+    click(app, 60.0, 10.0, Modifiers::ALT);
+    let k = work(app).subpaths[0].knots[1];
+    assert_eq!([k.in_ctrl, k.out_ctrl], [k.anchor, k.anchor]);
+}
+
+#[test]
+fn cmd_edits_the_path_being_drawn_and_cmd_click_away_finishes_it() {
+    let mut h = harness();
+    let app = h.state_mut();
+    click(app, 10.0, 10.0, Modifiers::NONE);
+    click(app, 60.0, 10.0, Modifiers::NONE);
+    drag(app, [60.0, 10.0], [60.0, 20.0], command());
+    assert_eq!(app.ui.pen.as_ref().unwrap().knots[1][0], [60.0, 20.0], "moved while drawing");
+    click(app, 150.0, 90.0, command());
+    assert!(app.ui.pen.is_none(), "⌘-click away finished the path");
+    assert_eq!(anchors(app, 0), vec![[10.0, 10.0], [60.0, 20.0]]);
+}
+
+#[test]
+fn shift_cmd_z_redoes() {
+    let mut h = harness();
+    h.state_mut().run("layer.new.layer", json!({})).unwrap();
+    let layers = |h: &Harness<'_, PhotocraftApp>| h.state().session.active().unwrap().doc.layers.len();
+    let n = layers(&h);
+    h.state_mut().ui.tool = Tool::Brush;
+    press(&mut h, Key::Z, command());
+    assert_eq!(layers(&h), n - 1, "⌘Z undid");
+    let mut m = command();
+    m.shift = true;
+    press(&mut h, Key::Z, m);
+    assert_eq!(layers(&h), n, "⇧⌘Z redid: {}", h.state().ui.status);
+}
