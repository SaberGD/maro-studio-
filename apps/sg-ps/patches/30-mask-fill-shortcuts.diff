+/// Alt+Backspace follows the selected mask thumbnail instead of changing layer pixels.
+#[test]
+fn foreground_fill_shortcut_targets_the_active_mask() {
+    let mut h = harness();
+    h.state_mut().run("layer.layerMask.revealAll", json!({})).unwrap();
+    h.state_mut().ui.mask_target = true;
+    h.run_steps(2);
+
+    let before = {
+        let st = h.state().session.active().unwrap();
+        let bounds = st.doc.bounds();
+        let layer = st.doc.layer(st.active_layer.unwrap()).unwrap();
+        (
+            layer.surface().unwrap().read_region(bounds),
+            layer.mask.as_ref().unwrap().surface.read_region(bounds),
+        )
+    };
+
+    press(&mut h, "Alt+Backspace");
+
+    let st = h.state().session.active().unwrap();
+    let bounds = st.doc.bounds();
+    let layer = st.doc.layer(st.active_layer.unwrap()).unwrap();
+    assert_eq!(layer.surface().unwrap().read_region(bounds), before.0, "layer pixels stay unchanged");
+    assert_ne!(layer.mask.as_ref().unwrap().surface.read_region(bounds), before.1, "mask receives the foreground fill");
+}
