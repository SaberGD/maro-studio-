+/// One channel targeted in the Channels panel: an alpha channel, or one colour channel of the
+/// active pixel layer. Copy and Paste then work on that channel alone, as a grayscale image
+/// (Photoshop).
+fn targeted_channel(s: &Session) -> Option<ChannelTarget> {
+    let d = s.active()?;
+    match d.channel_view.target {
+        ChannelTarget::Alpha(i) if i < d.doc.channels.len() => Some(ChannelTarget::Alpha(i)),
+        ChannelTarget::Color(k) => {
+            let surf = d.active_layer.and_then(|id| d.doc.layer(id)).and_then(Layer::surface)?;
+            (k < surf.channels() - usize::from(surf.format().alpha)).then_some(ChannelTarget::Color(k))
+        }
+        _ => None,
+    }
+}
+
+/// The targeted channel's values over `area`, one per pixel. Transparent parts of a layer read as
+/// white, as the Channels panel shows them.
+fn channel_values(doc: &Document, active: Option<LayerId>, t: ChannelTarget, area: Rect) -> Option<Vec<f32>> {
+    match t {
+        ChannelTarget::Alpha(i) => {
+            let c = doc.channels.get(i)?;
+            let n = c.surface.channels();
+            Some(c.surface.read_region(area).chunks_exact(n).map(|p| p[0]).collect())
+        }
+        ChannelTarget::Color(k) => {
+            let surf = active.and_then(|id| doc.layer(id)).and_then(Layer::surface)?;
+            let n = surf.channels();
+            let alpha = surf.format().alpha;
+            Some(
+                surf.read_region(area)
+                    .chunks_exact(n)
+                    .map(|p| {
+                        let a = if alpha { p[n - 1] } else { 1.0 };
+                        p[k] * a + (1.0 - a)
+                    })
+                    .collect(),
+            )
+        }
+        ChannelTarget::Composite => None,
+    }
+}
+
+/// Copy with one channel targeted: a grayscale image of the channel inside the selection (or the
+/// whole canvas).
+fn copy_channel(s: &Session, t: ChannelTarget) -> Option<Clip> {
+    let d = s.active()?;
+    let canvas = d.doc.bounds();
+    let sel = d.doc.selection.as_ref();
+    let area = sel.map_or(canvas, |m| m.content_bounds().intersect(&canvas));
+    let fmt = PixelFormat::new(ColorMode::Grayscale, d.doc.depth, true);
+    let mut out = Surface::new(fmt);
+    if area.is_empty() {
+        return Some(Clip { surface: out, bounds: Rect::EMPTY });
+    }
+    let vals = channel_values(&d.doc, d.active_layer, t, area)?;
+    let w = area.width() as usize;
+    let mut px = Vec::with_capacity(vals.len() * 2);
+    for (i, v) in vals.into_iter().enumerate() {
+        let a = sel.map_or(1.0, |m| m.sample_channel(area.x0 + (i % w) as i32, area.y0 + (i / w) as i32, 0));
+        px.extend([v, a]);
+    }
+    out.write_region(area, &px);
+    out.prune();
+    let bounds = out.content_bounds();
+    Some(Clip { surface: out, bounds })
+}
+
+/// Paste with one channel targeted: the clipboard (as gray) goes into that channel, at its place.
+fn paste_into_channel(s: &mut Session, t: ChannelTarget, clip: Clip) -> Result<Value> {
+    let d = s.active().ok_or(EngineError::NoDocument)?;
+    let area = clip.bounds.intersect(&d.doc.bounds());
+    if area.is_empty() {
+        return Err(EngineError::Other("the pasted pixels are outside the canvas".into()));
+    }
+    let src = clip.surface.read_region(area);
+    let n = clip.surface.channels();
+    let gray = clip.surface.format().mode == ColorMode::Grayscale;
+    // Gray value and coverage of each clipboard pixel.
+    let new: Vec<(f32, f32)> = src
+        .chunks_exact(n)
+        .map(|p| {
+            let a = if clip.surface.format().alpha { p[n - 1] } else { 1.0 };
+            let v = if gray || n < 3 { p[0] } else { 0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2] };
+            (v, a)
+        })
+        .collect();
+    let active = d.active_layer;
+    s.edit("Paste", move |doc, _| {
+        match t {
+            ChannelTarget::Alpha(i) => {
+                let c = doc.channels.get_mut(i).ok_or(EngineError::Other("no such channel".into()))?;
+                let m = c.surface.channels();
+                let mut px = c.surface.read_region(area);
+                for (p, (v, a)) in px.chunks_exact_mut(m).zip(&new) {
+                    p[0] = p[0] * (1.0 - a) + v * a;
+                }
+                c.surface.write_region(area, &px);
+                c.surface.prune();
+            }
+            ChannelTarget::Color(k) => {
+                let id = active.ok_or(EngineError::Other("no active layer".into()))?;
+                let surf = doc.layer_mut(id).and_then(Layer::surface_mut).ok_or(EngineError::Other("the active layer has no pixels".into()))?;
+                let m = surf.channels();
+                let mut px = surf.read_region(area);
+                for (p, (v, a)) in px.chunks_exact_mut(m).zip(&new) {
+                    p[k] = p[k] * (1.0 - a) + v * a;
+                }
+                surf.write_region(area, &px);
+                surf.prune();
+            }
+            ChannelTarget::Composite => {}
+        }
+        Ok(())
+    })?;
+    Ok(json!({"channel": true, "bounds": [area.x0, area.y0, area.width(), area.height()]}))
+}
