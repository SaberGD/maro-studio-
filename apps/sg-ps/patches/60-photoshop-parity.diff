+/// Blending Options › Blend If: channel menu and the This Layer / Underlying Layer sliders.
+fn blend_if_ui(ui: &mut egui::Ui, f: &mut Map<String, Value>, p: &mut Value) {
+    let t = Tokens::get(ui.ctx());
+    let chans: Vec<(u64, String)> = f
+        .get("blendIfChannels")
+        .and_then(Value::as_array)
+        .map(|a| a.iter().filter_map(|e| Some((e.get(0)?.as_u64()?, e.get(1)?.as_str()?.to_string()))).collect())
+        .unwrap_or_default();
+    let Some(entries) = p.get_mut("blendIf").and_then(Value::as_array_mut) else { return };
+    if chans.is_empty() {
+        return;
+    }
+    ui.add_space(10.0);
+    ui.separator();
+    ui.add_space(4.0);
+    let mut cur = f.get("blendIfChannel").and_then(Value::as_u64).filter(|c| chans.iter().any(|(i, _)| i == c)).unwrap_or(chans[0].0);
+    ui.horizontal(|ui| {
+        ui.label(RichText::new(tl!("Blend If")).color(t.text_dim));
+        let opts: Vec<(u64, &str)> = chans.iter().map(|(i, l)| (*i, l.as_str())).collect();
+        widgets::dropdown(ui, "fx-blendif-channel", &mut cur, &opts, 120.0);
+    });
+    f.insert("blendIfChannel".into(), json!(cur));
+    let Some(entry) = entries.iter_mut().find(|e| e.get("channel").and_then(Value::as_u64) == Some(cur)) else { return };
+    for (key, label) in [("thisLayer", "This Layer:"), ("underlying", "Underlying Layer:")] {
+        let mut r = [0u8, 0, 255, 255];
+        if let Some(a) = entry.get(key).and_then(Value::as_array) {
+            for (k, v) in a.iter().take(4).enumerate() {
+                r[k] = v.as_u64().unwrap_or(0).min(255) as u8;
+            }
+        }
+        ui.add_space(4.0);
+        ui.label(RichText::new(tl!(label)).color(t.text_dim));
+        if range_slider(ui, ui.id().with(("blendif", key)), &mut r) {
+            entry[key] = json!(r);
+        }
+    }
+    ui.label(RichText::new(tl!("Alt-drag a slider to split it")).size(11.0).color(t.text_faint));
+}
