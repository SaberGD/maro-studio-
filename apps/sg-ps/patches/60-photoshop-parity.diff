+/// (RGB bytes, width, height, step).
+pub fn sample_rgb8(s: &Session, all_layers: bool, max_side: u32) -> Option<(Vec<u8>, u32, u32, usize)> {
+    with_sampler(s, all_layers, |smp, doc| {
+        let b = doc.bounds();
+        if b.is_empty() {
+            return None;
+        }
+        let long = b.width().max(b.height()) as usize;
+        let step = long.div_ceil(max_side.max(1) as usize).max(1);
+        let img = smp.rgb_scaled(b, step);
+        let rgb = img.px.iter().flat_map(|p| p.map(|v| (v.clamp(0.0, 1.0) * 255.0).round() as u8)).collect();
+        Some((rgb, img.w as u32, img.h as u32, step))
+    })
+    .ok()
+    .flatten()
+}
