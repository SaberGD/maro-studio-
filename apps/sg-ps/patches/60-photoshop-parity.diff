+    /// The decodes a [`Mock`] saw: (point count, labels, with a previous mask).
+    type Calls = std::rc::Rc<std::cell::RefCell<Vec<(usize, Vec<f32>, bool)>>>;
+
+    /// A model that answers at once: the mask is a square around the foreground points' centre,
+    /// shrunk while background points are present.
+    #[derive(Default)]
+    struct Mock {
+        out: Vec<SegEvent>,
+        calls: Calls,
+    }
+
+    impl Segmenter for Mock {
+        fn encode(&mut self, key: u64, _rgb: Vec<u8>, _w: u32, _h: u32) {
+            self.out.push(SegEvent::Encoded { key });
+        }
+        fn decode(&mut self, _key: u64, req: u64, points: Vec<[f32; 2]>, labels: Vec<f32>, prev: Option<Vec<f32>>) {
+            self.calls.borrow_mut().push((points.len(), labels.clone(), prev.is_some()));
+            let neg = labels.contains(&0.0);
+            let half = if neg { 4 } else { 8 };
+            let mut logits = vec![-10.0f32; 4 * LOW * LOW];
+            for y in 16 - half..16 + half {
+                for x in 16 - half..16 + half {
+                    logits[y * LOW + x] = 10.0;
+                }
+            }
+            self.out.push(SegEvent::Decoded { req, logits, ious: vec![0.9, 0.1, 0.1, 0.1] });
+        }
+        fn poll(&mut self) -> Vec<SegEvent> {
+            std::mem::take(&mut self.out)
+        }
+        fn subject_side(&self) -> Option<u32> {
+            Some(16)
+        }
+        /// The subject: the middle half of the image (4..12 of 16).
+        fn subject(&mut self, req: u64, rgb: Vec<u8>, side: u32) {
+            assert_eq!(rgb.len(), (side * side * 3) as usize);
+            let s = side as usize;
+            let mask = (0..s * s).map(|i| if (4..12).contains(&(i % s)) && (4..12).contains(&(i / s)) { 1.0 } else { 0.0 }).collect();
+            self.out.push(SegEvent::Subject { req, mask });
+        }
+    }
