+    fn biggest(m: &[bool], w: usize, h: usize) -> Option<Vec<usize>> {
+        let mut seen = vec![false; w * h];
+        let mut best: Option<Vec<usize>> = None;
+        for s in 0..w * h {
+            if !m[s] || seen[s] {
+                continue;
+            }
+            let mut c = vec![s];
+            seen[s] = true;
+            let mut k = 0;
+            while k < c.len() {
+                let i = c[k];
+                k += 1;
+                let (x, y) = (i % w, i / w);
+                for (nx, ny) in [(x.wrapping_sub(1), y), (x + 1, y), (x, y.wrapping_sub(1)), (x, y + 1)] {
+                    if nx < w && ny < h && m[ny * w + nx] && !seen[ny * w + nx] {
+                        seen[ny * w + nx] = true;
+                        c.push(ny * w + nx);
+                    }
+                }
+            }
+            if best.as_ref().is_none_or(|b| c.len() > b.len()) {
+                best = Some(c);
+            }
+        }
+        best
+    }
+
+    fn deepest(c: &[usize], w: usize, h: usize) -> usize {
+        let mut d = vec![0.0f32; w * h];
+        for i in c {
+            d[*i] = 1e9;
+        }
+        for _ in 0..2 {
+            for i in 0..w * h {
+                let (x, y) = (i % w, i / w);
+                if x > 0 {
+                    d[i] = d[i].min(d[i - 1] + 1.0);
+                }
+                if y > 0 {
+                    d[i] = d[i].min(d[i - w] + 1.0);
+                }
+            }
+            for i in (0..w * h).rev() {
+                let (x, y) = (i % w, i / w);
+                if x + 1 < w {
+                    d[i] = d[i].min(d[i + 1] + 1.0);
+                }
+                if y + 1 < h {
+                    d[i] = d[i].min(d[i + w] + 1.0);
+                }
+            }
+        }
+        c.iter().copied().max_by(|a, b| d[*a].total_cmp(&d[*b])).unwrap_or(c[0])
+    }
+}
