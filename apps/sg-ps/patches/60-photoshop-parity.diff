+/// One Blend If slider: black and white points under a black-to-white ramp, each split in two
+/// halves when Alt-dragged (Photoshop). `r` = [black low, black high, white low, white high].
+fn range_slider(ui: &mut egui::Ui, id: egui::Id, r: &mut [u8; 4]) -> bool {
+    let t = Tokens::get(ui.ctx());
+    let w = ui.available_width().min(300.0);
+    let (rect, _) = ui.allocate_exact_size(vec2(w, 38.0), Sense::hover());
+    let bar = Rect::from_min_size(rect.min + vec2(7.0, 2.0), vec2(w - 14.0, 11.0));
+    let mut mesh = egui::Mesh::default();
+    mesh.colored_vertex(bar.left_top(), Color32::BLACK);
+    mesh.colored_vertex(bar.right_top(), Color32::WHITE);
+    mesh.colored_vertex(bar.right_bottom(), Color32::WHITE);
+    mesh.colored_vertex(bar.left_bottom(), Color32::BLACK);
+    mesh.add_triangle(0, 1, 2);
+    mesh.add_triangle(0, 2, 3);
+    ui.painter().add(mesh);
+    ui.painter().rect_stroke(bar, 0.0, Stroke::new(1.0, t.field_border), StrokeKind::Outside);
+    let x_of = |v: u8| bar.left() + bar.width() * f32::from(v) / 255.0;
+    let v_of = |x: f32| (((x - bar.left()) / bar.width()).clamp(0.0, 1.0) * 255.0).round() as u8;
+    let track = Rect::from_min_max(pos2(bar.left() - 7.0, bar.bottom()), pos2(bar.right() + 7.0, bar.bottom() + 12.0));
+    let resp = ui.interact(track, id, Sense::drag());
+    // Which handle a drag moves: 0..=3 one half, 4 the whole black point, 5 the whole white point.
+    let grab = id.with("grab");
+    if resp.drag_started()
+        && let Some(pos) = resp.interact_pointer_pos()
+    {
+        let alt = ui.input(|i| i.modifiers.alt);
+        let mut cands: Vec<(u8, f32)> = Vec::new();
+        for (point, (lo, hi)) in [(4u8, (0usize, 1usize)), (5, (2, 3))] {
+            if r[lo] == r[hi] {
+                // Unsplit: a plain drag moves the point, Alt-drag pulls its inner half away.
+                cands.push((if alt { if point == 4 { 1 } else { 2 } } else { point }, x_of(r[lo])));
+            } else {
+                cands.push((lo as u8, x_of(r[lo])));
+                cands.push((hi as u8, x_of(r[hi])));
+            }
+        }
+        let best = cands.iter().min_by(|a, b| (a.1 - pos.x).abs().total_cmp(&(b.1 - pos.x).abs())).map(|c| c.0).unwrap_or(4);
+        ui.ctx().data_mut(|d| d.insert_temp(grab, best));
+    }
+    let mut changed = false;
+    if resp.dragged()
+        && let (Some(pos), Some(h)) = (resp.interact_pointer_pos(), ui.ctx().data(|d| d.get_temp::<u8>(grab)))
+    {
+        let v = v_of(pos.x);
+        let before = *r;
+        match h {
+            0 => r[0] = v.min(r[1]),
+            1 => r[1] = v.clamp(r[0], r[2]),
+            2 => r[2] = v.clamp(r[1], r[3]),
+            3 => r[3] = v.max(r[2]),
+            4 => {
+                let d = r[1] - r[0];
+                let lo = v.min(r[2] - d);
+                r[0] = lo;
+                r[1] = lo + d;
+            }
+            _ => {
+                let d = r[3] - r[2];
+                let lo = v.clamp(r[1], 255 - d);
+                r[2] = lo;
+                r[3] = lo + d;
+            }
+        }
+        changed = *r != before;
+    }
+    // Triangles: black halves dark, white halves light.
+    for (k, v) in r.iter().enumerate() {
+        let x = x_of(*v);
+        let y = bar.bottom() + 1.0;
+        let fill = if k < 2 { Color32::from_gray(10) } else { Color32::from_gray(245) };
+        let tri = vec![pos2(x, y), pos2(x + 5.5, y + 9.0), pos2(x - 5.5, y + 9.0)];
+        ui.painter().add(egui::Shape::convex_polygon(tri, fill, Stroke::new(1.0, Color32::from_gray(120))));
+    }
+    let fmt = |a: u8, b: u8| if a == b { a.to_string() } else { format!("{a} / {b}") };
+    let font = egui::FontId::proportional(11.0);
+    ui.painter().text(pos2(bar.left(), rect.bottom()), egui::Align2::LEFT_BOTTOM, fmt(r[0], r[1]), font.clone(), t.text_dim);
+    ui.painter().text(pos2(bar.right(), rect.bottom()), egui::Align2::RIGHT_BOTTOM, fmt(r[2], r[3]), font, t.text_dim);
+    changed
+}
