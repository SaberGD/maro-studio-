+#[test]
+fn soft_brush_heals_the_whole_blemish() {
+    // A soft tip used to apply its falloff to the healed result, leaving a ghost of the spot.
+    let mut s = session(160, 120, 8, "rgb");
+    paint_layer(&mut s, |x, y| {
+        let d = ((x - 80) as f32).hypot((y - 60) as f32);
+        if d < 6.0 { [0.05, 0.03, 0.02, 1.0] } else { texture(x, y) }
+    });
+    s.execute("paint.spotHealing", json!({"points": [[80, 60]], "size": 22, "hardness": 0})).unwrap();
+    // The spot is dark: what is left of it shows as the healed pixels being darker than the texture.
+    let (mut dark, mut n) = (0.0f32, 0);
+    for y in 54..=66 {
+        for x in 74..=86 {
+            if ((x - 80) as f32).hypot((y - 60) as f32) < 6.0 {
+                let (p, t) = (rgba(&s, x, y), texture(x, y));
+                dark += (0..3).map(|c| t[c] - p[c]).sum::<f32>() / 3.0;
+                n += 1;
+            }
+        }
+    }
+    let dark = dark / n as f32;
+    assert!(dark < 0.05, "blemish left under the soft tip: {dark}");
+}
