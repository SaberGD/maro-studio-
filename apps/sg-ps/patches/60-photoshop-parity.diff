+/// Selection commands whose dialog previews the selection they make, with Select and Mask's view
+/// modes (Photoshop: Select and Mask, Select › Modify).
+pub fn selection_preview(command: &str) -> bool {
+    command == "select.refineEdge" || command.starts_with("select.modify.")
+}
