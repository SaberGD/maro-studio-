+    #[test]
+    fn logits_map_to_the_document() {
+        // Image 512 × 256 (step 2 → document 1024 × 512): the low mask covers 128 × 64 cells.
+        let mut logits = vec![-10.0f32; LOW * LOW];
+        for y in 16..48 {
+            for x in 32..96 {
+                logits[y * LOW + x] = 10.0;
+            }
+        }
+        let canvas = Rect::new(0, 0, 1024, 512);
+        let r = region_from_logits(&logits, 2, 512, 256, canvas).unwrap();
+        // Cells 32..96 × 16..48 are image pixels 128..384 × 64..192, document 256..768 × 128..384.
+        assert!(r.at(500, 250) > 0.99 && r.at(100, 250) < 0.01 && r.at(500, 450) < 0.01);
+        assert!((250..=262).contains(&r.bbox.x0) || r.at(258, 250) > 0.4, "left edge near 256: {:?}", r.bbox);
+        assert!(r.at(262, 250) > 0.9 && r.at(250, 250) < 0.1);
+        assert!(region_from_logits(&vec![-1.0; LOW * LOW], 1, 100, 100, canvas).is_none());
