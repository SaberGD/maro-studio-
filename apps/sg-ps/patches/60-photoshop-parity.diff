+//! HORIX AI selection: Quick Selection and Object Selection driven by MobileSAM (a lightweight
+//! Segment Anything; weights Apache-2.0, ONNX export MIT), as Photoshop's selection tools are
+//! driven by a trained model.
+//!
+//! The model runs behind a platform service ([`Segmenter`]: onnxruntime on the desktop,
+//! onnxruntime-web in the browser), asynchronously: the image is encoded once (about half a
+//! second) and kept while its pixels don't change; every stroke then only runs the small decoder.
+//! A run of Quick Selection strokes accumulates its points, as Photoshop's does: plain strokes
+//! are foreground, ⌥-strokes background, and each decode starts from the previous mask, so a
+//! correcting stroke fixes the leak instead of cutting a hole. The result is snapped to the image
+//! edges at full resolution and combined with the selection the run started from.
+//!
+//! Select Subject runs a second, salient-object model (IS-Net on the desktop, U²-Netp in the
+//! browser; Apache-2.0) on the whole image, stretched to the model's square input; its soft mask
+//! becomes the selection.
+//!
+//! Without the service, or when a model can't load, the classic tools run instead.
+
+use std::hash::{Hash, Hasher};
+
+use photocraft_algo::selection::{Region, SelectionMode};
+use photocraft_doc::{DocId, Document, Layer, LayerId};
+use photocraft_geom::Rect;
+use photocraft_raster::Surface;
+
+use crate::PhotocraftApp;
+
+/// The encoder's input side: images are downscaled to at most this.
+pub const EMBED_SIDE: u32 = 1024;
+/// The decoder's low-resolution mask side (covers the `EMBED_SIDE` square).
+pub const LOW: usize = 256;
+
+/// What a [`Segmenter`] reports back.
+#[derive(Clone, Debug, PartialEq)]
+pub enum SegEvent {
+    /// The image for `key` is encoded; decodes for it can run.
+    Encoded { key: u64 },
+    /// Decode `req` finished: four low-resolution mask logits (`4 × LOW × LOW`) and their
+    /// predicted IoU.
+    Decoded { req: u64, logits: Vec<f32>, ious: Vec<f32> },
+    /// The model is unavailable (files missing, runtime error).
+    Failed { msg: String },
+    /// Select Subject `req` finished: the subject's probability (0..1), `side × side` over the
+    /// image stretched to a square.
+    Subject { req: u64, mask: Vec<f32> },
+    /// The Select Subject model is unavailable.
+    SubjectFailed { msg: String },
+}
+
+/// The platform's model runner. Calls return at once; results arrive through [`Segmenter::poll`].
+pub trait Segmenter {
+    /// Encode an RGB image (`w × h`, longest side at most [`EMBED_SIDE`], 8-bit, row-major).
+    fn encode(&mut self, key: u64, rgb: Vec<u8>, w: u32, h: u32);
+    /// Decode masks for the image encoded as `key`. `points` are in the image's pixels; `labels`
+    /// are 1 (foreground), 0 (background), 2 / 3 (box corners) or -1 (padding); `prev` is the
+    /// previous low-resolution mask (`LOW × LOW` logits) when refining.
+    fn decode(&mut self, key: u64, req: u64, points: Vec<[f32; 2]>, labels: Vec<f32>, prev: Option<Vec<f32>>);
+    /// Results since the last call.
+    fn poll(&mut self) -> Vec<SegEvent>;
+    /// The Select Subject model's (square) input side, when the service has one.
+    fn subject_side(&self) -> Option<u32> {
+        None
+    }
+    /// Run the Select Subject model on an RGB image `side × side` (8-bit, row-major).
+    fn subject(&mut self, _req: u64, _rgb: Vec<u8>, _side: u32) {}
+}
+
+/// A Select Subject request waiting for the model.
+struct SubjectRun {
+    req: u64,
+    doc: DocId,
+    side: u32,
+    base: Option<Surface>,
+    mode: SelectionMode,
+    params: serde_json::Value,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Kind {
+    Quick,
+    Object,
+}
+
+/// A run of strokes (or one box) on one image.
+struct Run {
+    kind: Kind,
+    doc: DocId,
+    key: u64,
+    all_layers: bool,
+    step: usize,
+    img: (u32, u32),
+    /// The selection the run started from, and how the model's mask combines with it.
+    base: Option<Surface>,
+    mode: SelectionMode,
+    points: Vec<[f32; 2]>,
+    labels: Vec<f32>,
+    /// Box corners (image pixels), Object Selection.
+    rect: Option<[f32; 4]>,
+    prev: Option<Vec<f32>>,
+    decodes: u32,
+    /// Document revision after the run's last result (a stroke on it continues the run).
+    revision: u64,
+    /// A decode is wanted (sent when the image is encoded and no decode is in flight).
+    wanted: bool,
+    /// The classic command for the latest gesture, run if the model turns out unavailable.
+    fallback: Option<(&'static str, serde_json::Value)>,
+}
+
+#[derive(Default)]
+pub struct State {
+    embedded: Option<u64>,
+    encoding: Option<u64>,
+    /// (key, step, width, height) of the last image sent to the encoder.
+    frame: Option<(u64, usize, u32, u32)>,
+    run: Option<Run>,
+    in_flight: Option<u64>,
+    dirty: bool,
+    next_req: u64,
+    failed: Option<String>,
+    /// (document, revision, all layers) last checked for a prefetch.
+    checked: Option<(DocId, u64, bool)>,
+    subject: Option<SubjectRun>,
+    subject_failed: Option<String>,
+}
+
+/// The AI tools can run (a model service is attached and hasn't failed).
+pub fn available(app: &PhotocraftApp) -> bool {
+    app.services.segmenter.is_some() && app.ai.failed.is_none()
+}
+
+/// A run is waiting for the model (the canvas keeps polling).
+pub fn busy(app: &PhotocraftApp) -> bool {
+    app.ai.encoding.is_some() || app.ai.in_flight.is_some() || app.ai.subject.is_some()
+}
+
+/// Select Subject through the model (`params` as `select.subject`'s). Returns false when the
+/// classic command should run instead.
+pub fn subject(app: &mut PhotocraftApp, params: &serde_json::Value) -> bool {
+    if app.ai.subject_failed.is_some() {
+        return false;
+    }
+    let Some(side) = app.services.segmenter.as_ref().and_then(|s| s.subject_side()) else { return false };
+    let all = params.get("sampleAllLayers").and_then(serde_json::Value::as_bool).unwrap_or(true);
+    let mode = match params.get("mode").and_then(serde_json::Value::as_str).unwrap_or("replace") {
+        "add" => SelectionMode::Add,
+        "subtract" => SelectionMode::Subtract,
+        "intersect" => SelectionMode::Intersect,
+        _ => SelectionMode::Replace,
+    };
+    let Some(st) = app.session.active() else { return false };
+    let (doc, base) = (st.doc.id, st.doc.selection.clone());
+    let Some((rgb, w, h, _)) = photocraft_engine::smartselect_cmds::sample_rgb8(&app.session, all, side) else { return false };
+    let rgb = stretch_rgb(&rgb, w as usize, h as usize, side as usize);
+    app.ai.next_req += 1;
+    let req = app.ai.next_req;
+    app.ai.subject = Some(SubjectRun { req, doc, side, base, mode, params: params.clone() });
+    if let Some(seg) = app.services.segmenter.as_mut() {
+        seg.subject(req, rgb, side);
+    }
+    app.ui.status = "HORIX AI: finding the subject…".into();
+    app.ui.status_error = false;
+    true
+}
+
+/// Bilinear resize of an RGB image to `side × side` (the model's square input).
+fn stretch_rgb(rgb: &[u8], w: usize, h: usize, side: usize) -> Vec<u8> {
+    let mut out = vec![0u8; side * side * 3];
+    if w == 0 || h == 0 || rgb.len() < w * h * 3 {
+        return out;
+    }
+    let px = |x: usize, y: usize, c: usize| f32::from(rgb[(y.min(h - 1) * w + x.min(w - 1)) * 3 + c]);
+    for j in 0..side {
+        let sy = ((j as f32 + 0.5) * h as f32 / side as f32 - 0.5).max(0.0);
+        let (y0, ty) = (sy.floor() as usize, sy.fract());
+        for i in 0..side {
+            let sx = ((i as f32 + 0.5) * w as f32 / side as f32 - 0.5).max(0.0);
+            let (x0, tx) = (sx.floor() as usize, sx.fract());
+            for c in 0..3 {
+                let v = (px(x0, y0, c) * (1.0 - tx) + px(x0 + 1, y0, c) * tx) * (1.0 - ty) + (px(x0, y0 + 1, c) * (1.0 - tx) + px(x0 + 1, y0 + 1, c) * tx) * ty;
+                out[(j * side + i) * 3 + c] = v.round().clamp(0.0, 255.0) as u8;
+            }
+        }
+    }
+    out
+}
+
+/// A Select Subject mask (`side × side` probabilities over the canvas stretched to a square) as a
+/// selection region over the document, upsampled bilinearly.
+pub fn region_from_prob(mask: &[f32], side: usize, canvas: Rect) -> Option<Region> {
+    if side == 0 || mask.len() < side * side || canvas.is_empty() {
+        return None;
+    }
+    let (cw, ch) = (canvas.width() as f32, canvas.height() as f32);
+    let (mut x0, mut y0, mut x1, mut y1) = (usize::MAX, usize::MAX, 0, 0);
+    for y in 0..side {
+        for x in 0..side {
+            if mask[y * side + x] > 0.02 {
+                x0 = x0.min(x);
+                y0 = y0.min(y);
+                x1 = x1.max(x + 1);
+                y1 = y1.max(y + 1);
+            }
+        }
+    }
+    if x0 == usize::MAX {
+        return None;
+    }
+    let to_x = |c: usize| canvas.x0 + (c as f32 * cw / side as f32).floor() as i32;
+    let to_y = |c: usize| canvas.y0 + (c as f32 * ch / side as f32).floor() as i32;
+    let bbox = Rect::new(to_x(x0.saturating_sub(1)), to_y(y0.saturating_sub(1)), to_x((x1 + 1).min(side)) + 1, to_y((y1 + 1).min(side)) + 1).intersect(&canvas);
+    if bbox.is_empty() {
+        return None;
+    }
+    let (w, h) = (bbox.width() as usize, bbox.height() as usize);
+    let at = |x: usize, y: usize| mask[y.min(side - 1) * side + x.min(side - 1)];
+    let mut out = vec![0u8; w * h];
+    for (j, row) in out.chunks_mut(w).enumerate() {
+        let sy = (((bbox.y0 - canvas.y0) as f32 + j as f32 + 0.5) * side as f32 / ch - 0.5).max(0.0);
+        let (yi, ty) = (sy.floor() as usize, sy.fract());
+        for (i, o) in row.iter_mut().enumerate() {
+            let sx = (((bbox.x0 - canvas.x0) as f32 + i as f32 + 0.5) * side as f32 / cw - 0.5).max(0.0);
+            let (xi, tx) = (sx.floor() as usize, sx.fract());
+            let v = (at(xi, yi) * (1.0 - tx) + at(xi + 1, yi) * tx) * (1.0 - ty) + (at(xi, yi + 1) * (1.0 - tx) + at(xi + 1, yi + 1) * tx) * ty;
+            *o = (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+        }
+    }
+    photocraft_algo::segment::trim_region(Region { bbox, mask: out })
+}
+
+/// The Select Subject result: the model's mask combined with the selection.
+fn apply_subject(app: &mut PhotocraftApp, run: SubjectRun, mask: &[f32]) {
+    let Some(st) = app.session.active().filter(|s| s.doc.id == run.doc) else { return };
+    let canvas = st.doc.bounds();
+    // The model's soft edge as is: snapping it to the image (as Quick Selection does) measured no
+    // better on DUTS-TE or HRSOD and cost 0.4 s.
+    let region = region_from_prob(mask, run.side as usize, canvas);
+    match photocraft_engine::smartselect_cmds::set_selection_from(&mut app.session, "Select Subject", run.base.as_ref(), region.as_ref(), run.mode) {
+        Ok(_) => {
+            app.sync_views();
+            app.ui.status = "HORIX AI: subject selected".into();
+            app.ui.status_error = false;
+        }
+        Err(e) => {
+            app.ui.status = e.to_string();
+            app.ui.status_error = true;
+        }
+    }
+}
+
+
+/// Identity of the pixels the tools analyse: the active layer's (or every visible layer's) tiles
+/// and blending. A selection change keeps it, so strokes don't re-encode the image.
+fn content_key(doc: &Document, active: Option<LayerId>, all_layers: bool) -> (u64, bool) {
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    doc.id.0.hash(&mut h);
+    (doc.size.width, doc.size.height).hash(&mut h);
+    let layer = active.and_then(|id| doc.layer(id)).filter(|l| l.surface().is_some());
+    let composite = all_layers || layer.is_none();
+    composite.hash(&mut h);
+    let mut add = |l: &Layer| {
+        l.id.0.hash(&mut h);
+        l.visible.hash(&mut h);
+        l.opacity.to_bits().hash(&mut h);
+        l.fill_opacity.to_bits().hash(&mut h);
+        l.blend.label().hash(&mut h);
+        for s in l.surface().into_iter().chain(l.mask.as_ref().map(|m| &m.surface)) {
+            for (c, t) in s.tiles() {
+                (c.tx, c.ty).hash(&mut h);
+                (std::sync::Arc::as_ptr(t) as *const () as usize).hash(&mut h);
+            }
+        }
+    };
+    match layer {
+        Some(l) if !composite => add(l),
+        _ => doc.walk().into_iter().for_each(|(_, _, l)| add(l)),
+    }
+    (h.finish(), composite)
+}
+
+/// Up to `n` points evenly spaced along a stroke (by length), ends included.
+fn sample_stroke(pts: &[[f64; 2]], n: usize) -> Vec<[f64; 2]> {
+    if pts.len() <= 1 || n <= 1 {
+        return pts.first().copied().into_iter().collect();
+    }
+    let seg: Vec<f64> = pts.windows(2).map(|w| ((w[1][0] - w[0][0]).powi(2) + (w[1][1] - w[0][1]).powi(2)).sqrt()).collect();
+    let total: f64 = seg.iter().sum();
+    if total < 1e-6 {
+        return vec![pts[0]];
+    }
+    (0..n)
+        .map(|k| {
+            let mut d = total * k as f64 / (n - 1) as f64;
+            for (i, l) in seg.iter().enumerate() {
+                if d <= *l || i + 1 == seg.len() {
+                    let t = if *l > 0.0 { (d / l).clamp(0.0, 1.0) } else { 0.0 };
+                    return [pts[i][0] + t * (pts[i + 1][0] - pts[i][0]), pts[i][1] + t * (pts[i + 1][1] - pts[i][1])];
+                }
+                d -= l;
+            }
+            pts[pts.len() - 1]
+        })
+        .collect()
+}
+
+/// The decoder's low-resolution mask (logits over the `EMBED_SIDE` square the `img_w × img_h`
+/// image sits in, top-left) as a selection region over the document, upsampled bilinearly:
+/// document pixel `x` is image pixel `x / step`.
+pub fn region_from_logits(logits: &[f32], step: usize, img_w: u32, img_h: u32, canvas: Rect) -> Option<Region> {
+    if logits.len() < LOW * LOW || canvas.is_empty() {
+        return None;
+    }
+    let cell = EMBED_SIDE as f32 / LOW as f32;
+    let (lw, lh) = (((img_w as f32 / cell).ceil() as usize).clamp(1, LOW), ((img_h as f32 / cell).ceil() as usize).clamp(1, LOW));
+    let (mut x0, mut y0, mut x1, mut y1) = (usize::MAX, usize::MAX, 0, 0);
+    for y in 0..lh {
+        for x in 0..lw {
+            if logits[y * LOW + x] > 0.0 {
+                x0 = x0.min(x);
+                y0 = y0.min(y);
+                x1 = x1.max(x + 1);
+                y1 = y1.max(y + 1);
+            }
+        }
+    }
+    if x0 == usize::MAX {
+        return None;
+    }
+    // Low cell → document pixels, one cell of margin for the interpolated edge.
+    let to_doc = |c: usize| (c as f32 * cell * step as f32) as i32;
+    let bbox = Rect::new(to_doc(x0.saturating_sub(1)), to_doc(y0.saturating_sub(1)), to_doc((x1 + 1).min(lw)), to_doc((y1 + 1).min(lh)))
+        .intersect(&canvas);
+    if bbox.is_empty() {
+        return None;
+    }
+    let (w, h) = (bbox.width() as usize, bbox.height() as usize);
+    let at = |x: usize, y: usize| logits[y.min(lh - 1) * LOW + x.min(lw - 1)];
+    let k = 1.0 / (cell * step as f32);
+    let mut mask = vec![0u8; w * h];
+    for (j, row) in mask.chunks_mut(w).enumerate() {
+        let ly = ((bbox.y0 + j as i32) as f32 + 0.5) * k - 0.5;
+        let (fy, ty) = (ly.floor(), ly - ly.floor());
+        let yi = fy.max(0.0) as usize;
+        let yi1 = if fy < 0.0 { 0 } else { yi + 1 };
+        for (i, o) in row.iter_mut().enumerate() {
+            let lx = ((bbox.x0 + i as i32) as f32 + 0.5) * k - 0.5;
+            let (fx, tx) = (lx.floor(), lx - lx.floor());
+            let xi = fx.max(0.0) as usize;
+            let xi1 = if fx < 0.0 { 0 } else { xi + 1 };
+            let v = (at(xi, yi) * (1.0 - tx) + at(xi1, yi) * tx) * (1.0 - ty) + (at(xi, yi1) * (1.0 - tx) + at(xi1, yi1) * tx) * ty;
+            // Logits are steep: about one pixel of anti-aliasing at the edge.
+            *o = ((0.5 + v * 0.5).clamp(0.0, 1.0) * 255.0).round() as u8;
+        }
+    }
+    photocraft_algo::segment::trim_region(Region { bbox, mask })
+}
+
+/// Start a run (or continue the current Quick Selection run). Returns false when the model can't
+/// serve it (the caller runs the classic tool).
+fn begin(app: &mut PhotocraftApp, kind: Kind, all_layers: bool, mode: SelectionMode, cont: bool) -> bool {
+    if !available(app) {
+        return false;
+    }
+    let Some(st) = app.session.active() else { return false };
+    let (key, composite) = content_key(&st.doc, st.active_layer, all_layers);
+    let (doc_id, revision) = (st.doc.id, st.revision);
+    let continues = cont
+        && app.ai.run.as_ref().is_some_and(|r| r.kind == kind && r.doc == doc_id && r.key == key && r.revision == revision && r.all_layers == composite);
+    if !continues {
+        let Some(frame) = ensure_encoded(app, key, composite) else { return false };
+        let base = app.session.active().and_then(|s| s.doc.selection.clone());
+        app.ai.run = Some(Run {
+            kind,
+            doc: doc_id,
+            key,
+            all_layers: composite,
+            step: frame.1,
+            img: (frame.2, frame.3),
+            base,
+            mode,
+            points: Vec::new(),
+            labels: Vec::new(),
+            rect: None,
+            prev: None,
+            decodes: 0,
+            revision,
+            wanted: false,
+            fallback: None,
+        });
+    }
+    true
+}
+
+/// The image `key` is encoded or being encoded (sends it to the model otherwise):
+/// (key, step, width, height).
+fn ensure_encoded(app: &mut PhotocraftApp, key: u64, composite: bool) -> Option<(u64, usize, u32, u32)> {
+    if let Some(f) = app.ai.frame.filter(|f| f.0 == key) {
+        return Some(f);
+    }
+    let (rgb, w, h, step) = photocraft_engine::smartselect_cmds::sample_rgb8(&app.session, composite, EMBED_SIDE)?;
+    app.services.segmenter.as_mut()?.encode(key, rgb, w, h);
+    app.ai.encoding = Some(key);
+    app.ai.frame = Some((key, step, w, h));
+    Some((key, step, w, h))
+}
+
+/// With Quick or Object Selection picked, analyse the image ahead of the first stroke (the model
+/// and the encoding take a moment, longest in the browser).
+fn prefetch(app: &mut PhotocraftApp) {
+    use crate::state::Tool;
+    if !available(app) || app.ai.encoding.is_some() || !matches!(app.ui.tool, Tool::QuickSelection | Tool::ObjectSelection) {
+        return;
+    }
+    let all = app.ui.tool_options.sample_all_layers;
+    let Some(st) = app.session.active() else { return };
+    let mark = (st.doc.id, st.revision, all);
+    if app.ai.checked == Some(mark) {
+        return;
+    }
+    app.ai.checked = Some(mark);
+    let (key, composite) = content_key(&st.doc, st.active_layer, all);
+    ensure_encoded(app, key, composite);
+}
+
+/// Quick Selection stroke (document points). ⌥ (`subtract`) marks background. Returns false when
+/// the classic Quick Selection should run instead.
+pub fn quick_stroke(app: &mut PhotocraftApp, points: &[[f64; 2]], subtract: bool, all_layers: bool, fallback: serde_json::Value) -> bool {
+    if points.is_empty() {
+        return false;
+    }
+    // ⌥ on a selection the model didn't make: nothing to refine, the classic subtract runs.
+    let cont = app.ai.run.as_ref().is_some_and(|r| r.kind == Kind::Quick);
+    if subtract && !cont_ok(app, all_layers) {
+        return false;
+    }
+    if !begin(app, Kind::Quick, all_layers, SelectionMode::Add, cont) {
+        return false;
+    }
+    let Some(r) = app.ai.run.as_mut() else { return false };
+    let s = r.step as f64;
+    let (iw, ih) = (r.img.0 as f64, r.img.1 as f64);
+    // A short stroke is a click; a long one gives several points along it.
+    let n = if points.len() < 3 { 1 } else { 6 };
+    for p in sample_stroke(points, n) {
+        r.points.push([((p[0] / s).clamp(0.0, iw - 1.0)) as f32, ((p[1] / s).clamp(0.0, ih - 1.0)) as f32]);
+        r.labels.push(if subtract { 0.0 } else { 1.0 });
+    }
+    r.wanted = true;
+    r.fallback = Some(("select.quick", fallback));
+    send(app);
+    true
+}
+
+/// Whether the current run would continue on this document (for ⌥-strokes).
+fn cont_ok(app: &PhotocraftApp, all_layers: bool) -> bool {
+    let Some(st) = app.session.active() else { return false };
+    let (key, composite) = content_key(&st.doc, st.active_layer, all_layers);
+    app.ai.run.as_ref().is_some_and(|r| r.kind == Kind::Quick && r.doc == st.doc.id && r.key == key && r.revision == st.revision && r.all_layers == composite)
+}
+
+/// Object Selection box (document pixels `[x, y, w, h]`), combined with the selection by `mode`.
+pub fn object_box(app: &mut PhotocraftApp, rect: [f64; 4], mode: SelectionMode, all_layers: bool, fallback: serde_json::Value) -> bool {
+    if !begin(app, Kind::Object, all_layers, mode, false) {
+        return false;
+    }
+    let Some(r) = app.ai.run.as_mut() else { return false };
+    let s = r.step as f64;
+    let (iw, ih) = (r.img.0 as f64, r.img.1 as f64);
+    let c = |v: f64, m: f64| (v / s).clamp(0.0, m - 1.0) as f32;
+    r.rect = Some([c(rect[0], iw), c(rect[1], ih), c(rect[0] + rect[2], iw), c(rect[1] + rect[3], ih)]);
+    r.wanted = true;
+    r.fallback = Some(("select.object", fallback));
+    send(app);
+    true
+}
+
+/// Send the run's decode when the image is encoded and nothing is in flight.
+fn send(app: &mut PhotocraftApp) {
+    let Some(r) = app.ai.run.as_mut() else { return };
+    if !r.wanted || app.ai.embedded != Some(r.key) {
+        return;
+    }
+    if app.ai.in_flight.is_some() {
+        app.ai.dirty = true;
+        return;
+    }
+    let mut pts = Vec::new();
+    let mut labels = Vec::new();
+    if let Some(b) = r.rect {
+        pts.extend([[b[0], b[1]], [b[2], b[3]]]);
+        labels.extend([2.0, 3.0]);
+    }
+    pts.extend(r.points.iter().copied());
+    labels.extend(r.labels.iter().copied());
+    if r.rect.is_none() {
+        // SAM's padding point (no box).
+        pts.push([0.0, 0.0]);
+        labels.push(-1.0);
+    }
+    r.wanted = false;
+    app.ai.next_req += 1;
+    let req = app.ai.next_req;
+    app.ai.in_flight = Some(req);
+    let (key, prev) = (r.key, r.prev.clone());
+    if let Some(seg) = app.services.segmenter.as_mut() {
+        seg.decode(key, req, pts, labels, prev);
+    }
+}
+
+/// Handle the model's results; call every frame.
+pub fn poll(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let events = match app.services.segmenter.as_mut() {
+        Some(s) => s.poll(),
+        None => return,
+    };
+    for e in events {
+        match e {
+            SegEvent::Encoded { key } => {
+                app.ai.embedded = Some(key);
+                if app.ai.encoding == Some(key) {
+                    app.ai.encoding = None;
+                }
+                send(app);
+            }
+            SegEvent::Decoded { req, logits, ious } => {
+                if app.ai.in_flight != Some(req) {
+                    continue;
+                }
+                app.ai.in_flight = None;
+                apply(app, &logits, &ious);
+                if std::mem::take(&mut app.ai.dirty)
+                    && let Some(r) = app.ai.run.as_mut()
+                {
+                    r.wanted = true;
+                    send(app);
+                }
+            }
+            SegEvent::Failed { msg } => {
+                app.ai.failed = Some(msg.clone());
+                app.ai.encoding = None;
+                app.ai.in_flight = None;
+                let fallback = app.ai.run.take().and_then(|r| r.fallback);
+                app.ui.status = format!("HORIX AI unavailable ({msg}): using the classic tool");
+                app.ui.status_error = true;
+                if let Some((cmd, p)) = fallback {
+                    let _ = app.run(cmd, p);
+                }
+            }
+            SegEvent::Subject { req, mask } => {
+                if let Some(run) = app.ai.subject.take_if(|r| r.req == req) {
+                    apply_subject(app, run, &mask);
+                }
+            }
+            SegEvent::SubjectFailed { msg } => {
+                app.ai.subject_failed = Some(msg.clone());
+                if let Some(run) = app.ai.subject.take() {
+                    app.ui.status = format!("HORIX AI unavailable ({msg}): using the classic Select Subject");
+                    app.ui.status_error = true;
+                    let _ = app.run("select.subject", run.params);
+                }
+            }
+        }
+    }
+    prefetch(app);
+    if busy(app) {
+        app.ui.status = if app.ai.subject.is_some() {
+            "HORIX AI: finding the subject…".into()
+        } else if app.ai.encoding.is_some() {
+            "HORIX AI: analyzing the image…".into()
+        } else {
+            "HORIX AI: selecting…".into()
+        };
+        app.ui.status_error = false;
+        ctx.request_repaint_after(std::time::Duration::from_millis(40));
+    }
+}
+
+/// A decode result: the best mask (first decode) or the refined one, edge-snapped, combined with
+/// the run's starting selection.
+fn apply(app: &mut PhotocraftApp, logits: &[f32], ious: &[f32]) {
+    let Some(r) = app.ai.run.as_mut() else { return };
+    let n = LOW * LOW;
+    if logits.len() < n {
+        return;
+    }
+    // The first answer picks the most confident of SAM's masks; refinements use the first.
+    let k = if r.decodes == 0 { ious.iter().enumerate().max_by(|a, b| a.1.total_cmp(b.1)).map_or(0, |(i, _)| i) } else { 0 };
+    let k = if logits.len() >= (k + 1) * n { k } else { 0 };
+    let low = logits[k * n..(k + 1) * n].to_vec();
+    r.prev = Some(low.clone());
+    r.decodes += 1;
+    let (doc, step, img, all, mode) = (r.doc, r.step, r.img, r.all_layers, r.mode);
+    let base = r.base.clone();
+    let Some(st) = app.session.active().filter(|s| s.doc.id == doc) else { return };
+    let canvas = st.doc.bounds();
+    let region = region_from_logits(&low, step, img.0, img.1, canvas);
+    // Snap the upsampled edge to the image (the model sees at most 1024 px).
+    let region = match region {
+        Some(rg) => photocraft_engine::smartselect_cmds::enhance_region(&app.session, all, &rg, (step as f32 * 2.0 + 2.0).min(64.0)).or(Some(rg)),
+        None => None,
+    };
+    let label = if app.ai.run.as_ref().is_some_and(|r| r.kind == Kind::Object) { "Object Selection" } else { "Quick Selection" };
+    let res = photocraft_engine::smartselect_cmds::set_selection_from(&mut app.session, label, base.as_ref(), region.as_ref(), mode);
+    if let Err(e) = res {
+        app.ui.status = e.to_string();
+        app.ui.status_error = true;
+        return;
+    }
+    app.sync_views();
+    let rev = app.session.active().map(|s| s.revision).unwrap_or(0);
+    if let Some(r) = app.ai.run.as_mut() {
+        r.revision = rev;
+    }
+    app.ui.status = "HORIX AI selection".into();
+    app.ui.status_error = false;
+}
