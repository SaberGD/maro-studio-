+  <script>
+    // HORIX AI selection: MobileSAM in the browser (onnxruntime-web, loaded on the first Quick /
+    // Object Selection), and U²-Netp for Select Subject (loaded on its first use). The models come from ./models/; the runtime from jsDelivr. The app asks
+    // through window.horixAi (see web.rs WebSegmenter) and polls for results.
+    (function () {
+      var ORT = 'https://cdn.jsdelivr.net/npm/onnxruntime-web@1.22.0/dist/';
+      var MODELS = new URL('models/', document.baseURI).href;
+      var ready = null, enc = null, dec = null, emb = null, queue = Promise.resolve(), out = [];
+      var rt = null, subj = null;
+      function script(src) {
+        return new Promise(function (res, rej) {
+          var s = document.createElement('script');
+          s.src = src; s.crossOrigin = 'anonymous'; s.onload = res;
+          s.onerror = function () { rej(new Error('could not load the AI runtime')); };
+          document.head.appendChild(s);
+        });
+      }
+      async function session(url, gpu) {
+        // The GPU (WebGPU) when the browser has it, else the CPU (WebAssembly).
+        if (gpu && navigator.gpu) {
+          try { return await ort.InferenceSession.create(url, { executionProviders: ['webgpu'] }); } catch (e) { console.warn('HORIX AI: WebGPU unavailable', e); }
+        }
+        return ort.InferenceSession.create(url, { executionProviders: ['wasm'] });
+      }
+      function runtime() {
+        if (rt) return rt;
+        rt = script(ORT + 'ort.webgpu.min.js').then(function () {
+          ort.env.wasm.wasmPaths = ORT;
+          ort.env.wasm.numThreads = self.crossOriginIsolated ? Math.min(navigator.hardwareConcurrency || 4, 8) : 1;
+        });
+        rt.catch(function () { rt = null; });
+        return rt;
+      }
+      function load() {
+        if (ready) return ready;
+        ready = runtime().then(async function () {
+          enc = await session(MODELS + 'mobile_sam_image_encoder.onnx', true);
+          dec = await session(MODELS + 'sam_mask_decoder_multi.onnx', false);
+        });
+        return ready;
+      }
+      // One model call at a time, in order.
+      function then(job) {
+        queue = queue.then(function () { return load().then(job); }).catch(function (e) {
+          out.push({ type: 'failed', msg: String((e && e.message) || e) });
+        });
+      }
+      window.horixAi = {
+        encode: function (key, rgb, w, h) {
+          then(async function () {
+            var f = new Float32Array(rgb.length);
+            for (var i = 0; i < rgb.length; i++) f[i] = rgb[i];
+            var r = await enc.run({ input_image: new ort.Tensor('float32', f, [h, w, 3]) });
+            emb = { key: key, t: r.image_embeddings, w: w, h: h };
+            out.push({ type: 'encoded', key: key });
+          });
+        },
+        decode: function (key, req, coords, labels, prev) {
+          then(async function () {
+            if (!emb || emb.key !== key) throw new Error('the image is not encoded');
+            var n = labels.length;
+            var r = await dec.run({
+              image_embeddings: emb.t,
+              point_coords: new ort.Tensor('float32', coords, [1, n, 2]),
+              point_labels: new ort.Tensor('float32', labels, [1, n]),
+              mask_input: new ort.Tensor('float32', prev || new Float32Array(256 * 256), [1, 1, 256, 256]),
+              has_mask_input: new ort.Tensor('float32', new Float32Array([prev ? 1 : 0]), [1]),
+              orig_im_size: new ort.Tensor('float32', new Float32Array([emb.h, emb.w]), [2])
+            });
+            out.push({ type: 'decoded', req: req, logits: await r.low_res_masks.getData(), ious: await r.iou_predictions.getData() });
+          });
+        },
+        // Select Subject: rgb is side × side; answers the subject's probability (0..1).
+        subject: function (req, rgb, side) {
+          queue = queue.then(async function () {
+            await runtime();
+            if (!subj) subj = await session(MODELS + 'u2netp.onnx', false);
+            var n = side * side, x = new Float32Array(3 * n), max = 1e-6;
+            var mean = [0.485, 0.456, 0.406], std = [0.229, 0.224, 0.225];
+            for (var i = 0; i < rgb.length; i++) if (rgb[i] > max) max = rgb[i];
+            for (var i = 0; i < n; i++) for (var c = 0; c < 3; c++) x[c * n + i] = (rgb[i * 3 + c] / max - mean[c]) / std[c];
+            var r = await subj.run({ [subj.inputNames[0]]: new ort.Tensor('float32', x, [1, 3, side, side]) });
+            var y = await r[subj.outputNames[0]].getData(), lo = Infinity, hi = -Infinity;
+            for (var i = 0; i < n; i++) { if (y[i] < lo) lo = y[i]; if (y[i] > hi) hi = y[i]; }
+            var k = hi - lo > 1e-6 ? 1 / (hi - lo) : 0, m = new Float32Array(n);
+            for (var i = 0; i < n; i++) m[i] = (y[i] - lo) * k;
+            out.push({ type: 'subject', req: req, mask: m });
+          }).catch(function (e) {
+            out.push({ type: 'subjectFailed', msg: String((e && e.message) || e) });
+          });
+        },
+        poll: function () { return out.splice(0, out.length); }
+      };
+    })();
+  </script>
   <script>
     // SG - PS: if the app stops (an internal error or the browser running out of memory), say so
     // instead of leaving a frozen canvas, and show the technical details to send to the team.
