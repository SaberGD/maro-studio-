+/// Select and Mask view modes: (value, label).
+pub const VIEWS: &[(&str, &str)] = &[("overlay", "Overlay"), ("onBlack", "On Black"), ("onWhite", "On White"), ("blackWhite", "Black & White")];
+
+/// Paint the document's selection over it as view mode `view` shows it: a top layer that tints,
+/// blacks or whites out what is not selected, or the mask itself in black and white.
+fn show_selection(doc: &mut Document, view: &str) {
+    if doc.mode != photocraft_color::ColorMode::Rgb {
+        return;
+    }
+    let area = doc.bounds();
+    if area.is_empty() {
+        return;
+    }
+    let n = (area.width() as usize) * (area.height() as usize);
+    let vals: Vec<f32> = match &doc.selection {
+        Some(s) => {
+            let c = s.channels();
+            s.read_region(area).chunks_exact(c).map(|p| p[0].clamp(0.0, 1.0)).collect()
+        }
+        None => vec![1.0; n],
+    };
+    let mut px = Vec::with_capacity(n * 4);
+    for v in vals {
+        let o = 1.0 - v;
+        px.extend(match view {
+            "onBlack" => [0.0, 0.0, 0.0, o],
+            "onWhite" => [1.0, 1.0, 1.0, o],
+            "blackWhite" => [v, v, v, 1.0],
+            // Overlay: Photoshop's red at 50% over what is not selected.
+            _ => [1.0, 0.0, 0.0, 0.5 * o],
+        });
+    }
+    let fmt = photocraft_color::PixelFormat::new(photocraft_color::ColorMode::Rgb, doc.depth, true);
+    let mut l = photocraft_doc::Layer::raster("Select and Mask view", fmt);
+    if let Some(s) = l.surface_mut() {
+        s.write_region(area, &px);
+        doc.layers.push(l);
+    }
+}
