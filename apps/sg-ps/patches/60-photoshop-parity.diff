+        let mut f = Vec::new();
+        let mut i = 0;
+        while f.len() < 4 && i < d.len() {
+            while d[i].is_ascii_whitespace() {
+                i += 1;
+            }
+            let s = i;
+            while !d[i].is_ascii_whitespace() {
+                i += 1;
+            }
+            f.push(String::from_utf8_lossy(&d[s..i]).to_string());
+        }
+        i += 1;
+        (f[1].parse().unwrap_or(0), f[2].parse().unwrap_or(0), d[i..].to_vec())
+    }
