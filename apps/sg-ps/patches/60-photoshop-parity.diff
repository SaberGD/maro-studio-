+pub fn draw_overflow_hint(app: &mut PhotocraftApp, painter: &egui::Painter, xf: &ViewXform) {
+    if app.ui.text_edit.is_some() || !matches!(app.ui.tool, crate::state::Tool::Type | crate::state::Tool::Move) {
+        return;
+    }
+    let Some(id) = app.session.active().and_then(|s| s.active_layer) else { return };
+    let Some(photocraft_doc::text::TextShape::Box { x, y, width, height }) = app.session.active().and_then(|s| text_layer(&s.doc, id).map(|t| t.shape)) else {
+        return;
+    };
+    let Some((l, aff, _)) = layout(app, id) else { return };
+    if l.overflow {
+        let p = aff.apply(Point::new((x + width) as f64, (y + height) as f64));
+        overflow_mark(painter, xf.to_screen(p.x as f32, p.y as f32));
+    }
+}
