+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services { segmenter: Some(Box::new(mock)), ..Default::default() });
+        app.run("file.new", serde_json::json!({"width": 256, "height": 256})).unwrap();
+        let ctx = egui::Context::default();
+        // 256 px document: step 1, cell = 4 px; the mock's square is cells 8..24 → pixels 32..96.
+        assert!(quick_stroke(&mut app, &[[60.0, 60.0], [64.0, 64.0], [68.0, 60.0]], false, false, serde_json::json!({})));
+        poll(&mut app, &ctx);
