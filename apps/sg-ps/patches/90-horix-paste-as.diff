+/// HORIX: paste vector art (SVG markup), asking how as Photoshop does: Smart Object, Pixels, Path
+/// or Shape Layer (`photocraft_ui_egui::horix_paste_as`).
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn horix_paste_svg(svg: String) {
+    PASTES.with(|q| q.borrow_mut().push(svg.into_bytes()));
+    wake();
+}
+
+/// HORIX: a paste whose text is SVG markup (art copied in Horix Vectors, HORIX One's Vector
+/// persona, or Illustrator) goes to the Paste As prompt; egui would take it as text and drop it.
+fn listen_for_svg_pastes() {
+    let Some(window) = web_sys::window() else { return };
+    let on_paste = wasm_bindgen::closure::Closure::<dyn FnMut(web_sys::ClipboardEvent)>::new(move |e: web_sys::ClipboardEvent| {
+        let Some(text) = e.clipboard_data().and_then(|d| d.get_data("text/plain").ok()) else { return };
+        if !photocraft_ui_egui::horix_paste_as::is_svg(text.as_bytes()) {
+            return;
+        }
+        // A text field being typed in keeps its paste.
+        if photocraft_ui_egui::horix_paste_as::typing() {
+            return;
+        }
+        e.prevent_default();
+        e.stop_propagation();
+        horix_paste_svg(text);
+    });
+    // Captured before eframe's own listener.
+    if window.add_event_listener_with_callback_and_bool("paste", on_paste.as_ref().unchecked_ref(), true).is_ok() {
+        on_paste.forget();
+    }
+}
