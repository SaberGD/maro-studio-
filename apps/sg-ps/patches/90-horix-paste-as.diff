index 0000000..46b63c0
--- /dev/null
+++ b/crates/ui-egui/src/horix_paste_as.rs
@@ -0,0 +1,150 @@
+//! HORIX: pasting vector art asks how to paste it, as Photoshop does for art copied in Illustrator
+//! ("Paste As: Smart Object, Pixels, Path, Shape Layer"). It comes up for a plain Edit › Paste
+//! (⌘V) when the system clipboard holds SVG markup: art copied in Horix Vectors (HORIX One's
+//! Vector persona among it), in Illustrator or in any app that copies SVG as text. On the web the
+//! page's paste event brings the SVG ([`open`]). Automation, Paste Special and the explicit
+//! `edit.paste {"as": …}` paste at once.
+//!
+//! The prompt is an ordinary dialog: `ui.dialog.set` with `"mode"` (`smart`, `pixels`, `path`,
+//! `shape`) then `ui.dialog.confirm` pastes, `ui.dialog.cancel` pastes nothing.
+
+use std::sync::{Arc, Mutex};
+
+use serde_json::{Map, Value, json};
+
+use crate::PhotocraftApp;
+use crate::state::DialogKind;
+
+const MARK: &str = "__horixPasteAs";
+/// The layer name of a pasted smart object, as in Photoshop.
+const SMART_NAME: &str = "Vector Smart Object.svg";
+
+/// The SVG the open prompt pastes (kept out of the dialog's fields, which are copied each frame).
+static PENDING: Mutex<Option<Arc<Vec<u8>>>> = Mutex::new(None);
+
+/// Whether a text field had the keyboard on the last frame (the web page's paste goes to it then).
+static TYPING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub fn set_typing(on: bool) {
+    TYPING.store(on, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub fn typing() -> bool {
+    TYPING.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub fn owns(fields: &Map<String, Value>) -> bool {
+    fields.contains_key(MARK)
+}
+
+/// Whether `bytes` look like SVG markup (an XML preamble or comments may come first).
+pub fn is_svg(bytes: &[u8]) -> bool {
+    photocraft_io::svg::is_svg(bytes)
+}
+
+/// A plain `edit.paste` from the UI with SVG on the system clipboard: the prompt instead.
+pub fn intercept(app: &mut PhotocraftApp, command: &str, params: &Value) -> Option<Result<Value, String>> {
+    if app.automation_input || command != "edit.paste" {
+        return None;
+    }
+    // Only Edit › Paste itself: an explicit mode, a target or a placement pastes as asked.
+    if params.as_object().is_some_and(|p| p.keys().any(|k| k != "center")) {
+        return None;
+    }
+    app.session.active()?;
+    let get = app.services.clipboard_get_svg.as_mut()?;
+    let svg = get().ok().flatten().filter(|s| is_svg(s))?;
+    Some(Ok(open(app, svg)))
+}
+
+/// Ask how to paste `svg` (the web page calls this with a paste event's SVG text).
+pub fn open(app: &mut PhotocraftApp, svg: Vec<u8>) -> Value {
+    if app.session.active().is_none() {
+        // Nothing open to paste into: the art becomes a document of its own, as a drop does.
+        return match app.run("file.newFromClipboard", json!({})) {
+            Ok(v) => v,
+            Err(e) => json!({"error": e}),
+        };
+    }
+    *PENDING.lock().unwrap_or_else(|e| e.into_inner()) = Some(Arc::new(svg));
+    if let Some(d) = app.ui.dialogs.iter().find(|d| owns(&d.fields)) {
+        return json!({"dialog": d.id, "pastePending": true});
+    }
+    let fields = json!({MARK: true, "__label": "Paste", "mode": "smart"});
+    let id = app.ui.open_dialog(DialogKind::Command, fields.as_object().cloned().unwrap_or_default());
+    json!({"dialog": id, "pastePending": true})
+}
+
+pub fn body(ui: &mut egui::Ui, fields: &mut Map<String, Value>) {
+    let mut mode = fields.get("mode").and_then(Value::as_str).unwrap_or("smart").to_string();
+    ui.label(egui::RichText::new(tl!("Paste As:")).strong());
+    ui.add_space(4.0);
+    for (value, label) in [("smart", tl!("Smart Object")), ("pixels", tl!("Pixels")), ("path", tl!("Path")), ("shape", tl!("Shape Layer"))] {
+        ui.radio_value(&mut mode, value.to_string(), label);
+    }
+    fields.insert("mode".into(), json!(mode));
+}
+
+/// Paste the pending SVG the chosen way.
+pub fn confirm(app: &mut PhotocraftApp, fields: &Map<String, Value>) -> Result<Value, String> {
+    let svg = PENDING.lock().unwrap_or_else(|e| e.into_inner()).take().ok_or(tl!("Nothing to paste"))?;
+    match fields.get("mode").and_then(Value::as_str).unwrap_or("smart") {
+        "smart" => {
+            let r = photocraft_engine::file_cmds::place_bytes(&mut app.session, SMART_NAME, svg.to_vec(), None, &json!({"smartObject": true}))
+                .map_err(|e| e.to_string());
+            app.sync_views();
+            r
+        }
+        mode @ ("pixels" | "path" | "shape") => {
+            // The engine's own Paste As, from this SVG (the clipboard may have changed since).
+            app.session.clipboard = Some(photocraft_engine::edit_cmds::Clip::from_svg(&svg).map_err(|e| e.to_string())?);
+            app.run_command("edit.paste", json!({"as": mode}))
+        }
+        other => Err(format!("unknown paste mode `{other}`")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SVG: &[u8] = br##"<svg xmlns="http://www.w3.org/2000/svg" width="4" height="4"><rect width="4" height="4" fill="#ff0000"/></svg>"##;
+
+    fn app() -> PhotocraftApp {
+        let services = crate::Services { clipboard_get_svg: Some(Box::new(|| Ok(Some(SVG.to_vec())))), ..Default::default() };
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), services);
+        app.run("file.new", json!({"width": 8, "height": 8})).unwrap();
+        app
+    }
+
+    fn layers(app: &PhotocraftApp) -> usize {
+        app.session.active().unwrap().doc.layer_count()
+    }
+
+    #[test]
+    fn a_plain_paste_of_svg_asks_and_each_mode_pastes() {
+        for (mode, smart) in [("smart", true), ("pixels", false), ("shape", false)] {
+            let mut app = app();
+            let before = layers(&app);
+            let r = app.run("edit.paste", json!({})).unwrap();
+            let dialog = r["dialog"].as_u64().expect("the prompt opens");
+            assert_eq!(layers(&app), before, "nothing pasted before OK");
+            app.ui.dialog_mut(dialog).unwrap().fields.insert("mode".into(), json!(mode));
+            crate::dialogs::confirm(&mut app, dialog).unwrap();
+            assert_eq!(layers(&app), before + 1, "{mode} pasted one layer");
+            let st = app.session.active().unwrap();
+            let layer = st.doc.layer(st.active_layer.unwrap()).unwrap();
+            assert_eq!(matches!(layer.content, photocraft_doc::LayerContent::Smart(_)), smart, "{mode}");
+        }
+    }
+
+    #[test]
+    fn explicit_modes_and_automation_paste_at_once() {
+        let mut app = app();
+        let r = app.run("edit.paste", json!({"as": "pixels"})).unwrap();
+        assert!(r.get("dialog").is_none());
+        app.automation_input = true;
+        let r = app.run("edit.paste", json!({})).unwrap();
+        assert!(r.get("dialog").is_none());
+    }
+}
