+/// Detached panel groups. Drag a dock tab strip out to float it; Dock returns it to the column.
+pub fn floating_dock_windows(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let pro = Tokens::get(ctx).pro;
+    for (group, at) in app.ui.dock.floating_groups() {
+        if !group.shown(&app.ui.panels) {
+            continue;
+        }
+        let tabs = group.tabs(pro);
+        let mut selected = (*group.tab_mut(&mut app.ui.dock_tabs)).min(tabs.len().saturating_sub(1));
+        let mut open = true;
+        let mut dock = false;
+        let shown = egui::Window::new(tl!(tabs.get(selected).copied().unwrap_or("Panel")))
+            .id(egui::Id::new(("floating-dock-group", group.key())))
+            .default_pos(egui::pos2(at[0], at[1]))
+            .default_size(egui::vec2(320.0, group.default_height()))
+            .min_width(240.0)
+            .resizable(true)
+            .open(&mut open)
+            .show(ctx, |ui| {
+                ui.horizontal(|ui| {
+                    for (i, tab) in tabs.iter().enumerate() {
+                        if ui.selectable_label(selected == i, tl!(tab)).clicked() {
+                            selected = i;
+                        }
+                    }
+                    ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                        if ui.small_button(tl!("Dock")).on_hover_text(tl!("Return this panel group to the right dock")).clicked() {
+                            dock = true;
+                        }
+                    });
+                });
+                ui.separator();
+                let available = ui.available_height().max(group.min_height());
+                if group.scrolls_itself(selected) {
+                    ui.set_min_height(available);
+                    dock_body(app, ui, group, selected);
+                } else {
+                    egui::ScrollArea::vertical()
+                        .id_salt(("floating-dock-scroll", group.key(), selected))
+                        .auto_shrink([false, false])
+                        .show(ui, |ui| dock_body(app, ui, group, selected));
+                }
+            });
+        *group.tab_mut(&mut app.ui.dock_tabs) = selected;
+        if let Some(inner) = shown {
+            let p = inner.response.rect.min;
+            app.ui.dock.floating.insert(group, [p.x, p.y]);
+        }
+        if dock {
+            app.ui.dock.dock_group(group);
+        } else if !open {
+            *group.shown_mut(&mut app.ui.panels) = false;
+        }
     }
 }
 
