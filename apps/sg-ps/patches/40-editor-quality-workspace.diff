+/// Convert clicked anchors to a smooth Catmull-Rom-style Bezier path for the Curvature Pen.
+fn curvature_handles(pen: &mut PenPath, closed: bool) {
+    let n = pen.knots.len();
+    if n < 2 {
+        return;
+    }
+    let anchors: Vec<[f64; 2]> = pen.knots.iter().map(|k| k[0]).collect();
+    for (i, knot) in pen.knots.iter_mut().enumerate() {
+        let a = anchors[i];
+        if !closed && i == 0 {
+            let next = anchors[1];
+            knot[1] = a;
+            knot[2] = [a[0] + (next[0] - a[0]) / 3.0, a[1] + (next[1] - a[1]) / 3.0];
+        } else if !closed && i + 1 == n {
+            let prev = anchors[n - 2];
+            knot[1] = [a[0] + (prev[0] - a[0]) / 3.0, a[1] + (prev[1] - a[1]) / 3.0];
+            knot[2] = a;
+        } else {
+            let prev = anchors[(i + n - 1) % n];
+            let next = anchors[(i + 1) % n];
+            let tangent = [(next[0] - prev[0]) / 6.0, (next[1] - prev[1]) / 6.0];
+            knot[1] = [a[0] - tangent[0], a[1] - tangent[1]];
+            knot[2] = [a[0] + tangent[0], a[1] + tangent[1]];
+        }
+    }
