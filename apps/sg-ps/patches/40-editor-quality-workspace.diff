+fn magnetic_lasso(s: &mut Session, p: &Value) -> Result<Value> {
+    const CMD: &str = "select.magneticLasso";
+    let raw = lasso_points(p);
+    if raw.len() < 3 {
+        return Err(EngineError::BadParams { cmd: CMD.into(), msg: "needs at least 3 points".into() });
+    }
+    let (area, pixels) = sample_rgba8(s, true)?;
+    let w = area.width() as usize;
+    let radius = f(p, "width", 10.0).round().clamp(2.0, 64.0) as i32;
+    let lum = |x: i32, y: i32| {
+        let x = x.clamp(area.x0, area.x1 - 1);
+        let y = y.clamp(area.y0, area.y1 - 1);
+        let c = pixels[(y - area.y0) as usize * w + (x - area.x0) as usize];
+        0.2126 * f32::from(c[0]) + 0.7152 * f32::from(c[1]) + 0.0722 * f32::from(c[2]) + 0.25 * f32::from(c[3])
+    };
+    let edge = |x: i32, y: i32| {
+        let gx = lum(x + 1, y - 1) + 2.0 * lum(x + 1, y) + lum(x + 1, y + 1) - lum(x - 1, y - 1) - 2.0 * lum(x - 1, y) - lum(x - 1, y + 1);
+        let gy = lum(x - 1, y + 1) + 2.0 * lum(x, y + 1) + lum(x + 1, y + 1) - lum(x - 1, y - 1) - 2.0 * lum(x, y - 1) - lum(x + 1, y - 1);
+        gx.hypot(gy)
+    };
+    let mut snapped: Vec<(f32, f32)> = Vec::with_capacity(raw.len());
+    for &(rx, ry) in &raw {
+        let (cx, cy) = (rx.round() as i32, ry.round() as i32);
+        let mut best = (rx, ry);
+        let mut best_score = f32::NEG_INFINITY;
+        for dy in -radius..=radius {
+            for dx in -radius..=radius {
+                let distance = ((dx * dx + dy * dy) as f32).sqrt();
+                if distance > radius as f32 {
+                    continue;
+                }
+                let (x, y) = (cx + dx, cy + dy);
+                if !area.contains(x, y) {
+                    continue;
+                }
+                // Prefer a strong Sobel edge, while keeping the path close to the pointer and
+                // discouraging discontinuous jumps between opposite sides of a thin object.
+                let continuity = snapped.last().map_or(0.0, |q| {
+                    let raw_step = (rx - q.0).hypot(ry - q.1);
+                    ((x as f32 - q.0).hypot(y as f32 - q.1) - raw_step).abs()
+                });
+                let score = edge(x, y) - distance * 5.0 - continuity * 1.5;
+                if score > best_score {
+                    best_score = score;
+                    best = (x as f32, y as f32);
+                }
+            }
+        }
+        if snapped.last().is_none_or(|q| (q.0 - best.0).hypot(q.1 - best.1) >= 1.0) {
+            snapped.push(best);
+        }
+    }
+    apply_lasso(s, p, &snapped, "Magnetic Lasso", CMD)
+}
