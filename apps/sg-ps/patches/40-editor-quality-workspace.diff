+        .min_by(|a, b| a.2.total_cmp(&b.2))
+}
+
+/// Nearest sampled position on a cubic segment. Dense sampling is sufficient for pointer hit
+/// testing and the chosen `t` is then used for an exact De Casteljau split.
+fn nearest_segment(path: &Path, at: [f64; 2]) -> Option<(usize, usize, f64, f64)> {
+    let mut best: Option<(usize, usize, f64, f64)> = None;
+    for (si, sub) in path.subpaths.iter().enumerate() {
+        let n = sub.knots.len();
+        let count = if sub.closed { n } else { n.saturating_sub(1) };
+        for i in 0..count {
+            let a = &sub.knots[i];
+            let b = &sub.knots[(i + 1) % n];
+            let (a0, _, a2) = knot_points(a);
+            let (b0, b1, _) = knot_points(b);
+            for sample in 1..32 {
+                let t = sample as f64 / 32.0;
+                let d = distance(bezier(a0, a2, b1, b0, t), at);
+                if best.is_none_or(|old| d < old.3) {
+                    best = Some((si, i, t, d));
+                }
+            }
+        }
+    }
+    best
+}
+
+fn add_anchor(path: &mut Path, si: usize, segment: usize, t: f64) -> bool {
+    let Some(sub) = path.subpaths.get_mut(si) else { return false };
+    let n = sub.knots.len();
+    if n < 2 || segment >= n || (!sub.closed && segment + 1 >= n) {
+        return false;
+    }
+    let next = (segment + 1) % n;
+    let (p0, _, p1) = knot_points(&sub.knots[segment]);
+    let (p3, p2, _) = knot_points(&sub.knots[next]);
+    let (q0, q1, q2) = (lerp(p0, p1, t), lerp(p1, p2, t), lerp(p2, p3, t));
+    let (r0, r1) = (lerp(q0, q1, t), lerp(q1, q2, t));
+    let anchor = lerp(r0, r1, t);
+    sub.knots[segment].out_ctrl = point(q0);
+    sub.knots[next].in_ctrl = point(q2);
+    sub.knots.insert(segment + 1, Knot::smooth(point(anchor), point(r0), point(r1)));
+    true
+}
+
+fn delete_anchor(path: &mut Path, si: usize, ki: usize) -> bool {
+    let Some(sub) = path.subpaths.get_mut(si) else { return false };
+    let minimum = if sub.closed { 3 } else { 2 };
+    if sub.knots.len() <= minimum || ki >= sub.knots.len() {
+        return false;
+    }
+    sub.knots.remove(ki);
+    true
+}
+
+fn convert_anchor(path: &mut Path, si: usize, ki: usize) -> bool {
+    let Some(sub) = path.subpaths.get_mut(si) else { return false };
+    let n = sub.knots.len();
+    if n < 2 || ki >= n {
+        return false;
+    }
+    let (anchor, incoming, outgoing) = knot_points(&sub.knots[ki]);
+    if sub.knots[ki].smooth || incoming != anchor || outgoing != anchor {
+        sub.knots[ki] = Knot::corner(anchor[0], anchor[1]);
+        return true;
+    }
+    let prev = if ki > 0 {
+        Some(knot_points(&sub.knots[ki - 1]).0)
+    } else if sub.closed {
+        Some(knot_points(&sub.knots[n - 1]).0)
+    } else {
+        None
+    };
+    let next = if ki + 1 < n {
+        Some(knot_points(&sub.knots[ki + 1]).0)
+    } else if sub.closed {
+        Some(knot_points(&sub.knots[0]).0)
+    } else {
+        None
+    };
+    let (incoming, outgoing) = match (prev, next) {
+        (Some(prev), Some(next)) => {
+            let tangent = [(next[0] - prev[0]) / 6.0, (next[1] - prev[1]) / 6.0];
+            ([anchor[0] - tangent[0], anchor[1] - tangent[1]], [anchor[0] + tangent[0], anchor[1] + tangent[1]])
+        }
+        (None, Some(next)) => (anchor, lerp(anchor, next, 1.0 / 3.0)),
+        (Some(prev), None) => (lerp(anchor, prev, 1.0 / 3.0), anchor),
+        (None, None) => return false,
+    };
+    sub.knots[ki] = Knot::smooth(point(anchor), point(incoming), point(outgoing));
+    true
 }
 
+fn save_target_path(app: &mut PhotocraftApp, target: PathTarget, path: &Path) {
+    let value = photocraft_engine::vector_cmds::path_json(path);
+    let result = match target {
+        PathTarget::Shape(id) => app.run("shape.edit", json!({"layer": id, "path": value})),
+        PathTarget::VectorMask(id) => app.run("layer.vectorMask.edit", json!({"layer": id, "path": value})),
+        PathTarget::Work => app.run("path.set", json!({"name": "work", "path": value})),
+    };
+    if let Err(error) = result {
+        app.ui.status = error;
+        app.ui.status_error = true;
+    }
+}
+
+fn edit_active_path(app: &mut PhotocraftApp, x: f64, y: f64) {
+    let Some((target, mut path)) = target_path(app) else {
+        app.ui.status = tl!("Select a shape, vector mask, or Work Path first").to_string();
+        return;
+    };
+    app.ui.pen = None;
+    let at = [x, y];
+    let tolerance = 9.0 / app.current_zoom().max(0.01) as f64;
+    let changed = match app.ui.tool_options.pen_kind.as_str() {
+        "add-anchor" => {
+            nearest_segment(&path, at).filter(|(_, _, _, d)| *d <= tolerance).is_some_and(|(si, segment, t, _)| add_anchor(&mut path, si, segment, t))
+        }
+        "delete-anchor" => nearest_anchor(&path, at).filter(|(_, _, d)| *d <= tolerance).is_some_and(|(si, ki, _)| delete_anchor(&mut path, si, ki)),
+        "convert-anchor" => nearest_anchor(&path, at).filter(|(_, _, d)| *d <= tolerance).is_some_and(|(si, ki, _)| convert_anchor(&mut path, si, ki)),
+        _ => false,
+    };
+    if changed {
+        save_target_path(app, target, &path);
+    } else {
+        app.ui.status = tl!("Click directly on a path segment or anchor point").to_string();
+    }
+}
