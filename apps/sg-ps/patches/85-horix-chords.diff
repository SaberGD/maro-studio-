+/// Where the Color tab keeps the height its Colour Chords took last frame, which the field leaves
+/// free when it stretches over the group.
+fn color_chords_height_id() -> egui::Id {
+    egui::Id::unique("horix-color-chords-height")
+}
+
+fn color_chords_room_id() -> egui::Id {
+    egui::Id::unique("horix-color-chords-room")
+}
+
+/// HORIX Colour Chords under the Color tab (also at the top of Swatches), from the foreground.
+/// When the docked group is too short for them, a button beside the panel opens Swatches, where
+/// they are too.
+pub(crate) fn color_tab_chords(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    let room = ui.data(|d| d.get_temp::<bool>(color_chords_room_id())).unwrap_or(true);
+    if !room {
+        ui.add_space(4.0);
+        let b = ui.button("Colour Chords  →").on_hover_text("Colours that go with this one, in the Swatches tab");
+        if b.clicked() {
+            if app.ui.docking.is_some() {
+                let _ = crate::panel_docking::command(app, "window.panel.activate", &serde_json::json!({"panel": "swatches"}));
+            } else {
+                let pro = Tokens::get(ui.ctx()).pro;
+                if let Some(i) = crate::dock::Group::Color.tabs(pro).iter().position(|t| *t == "Swatches") {
+                    *crate::dock::Group::Color.tab_mut(&mut app.ui.dock_tabs) = i;
+                }
+            }
+        }
+        return;
+    }
+    let top = ui.cursor().top();
+    ui.add_space(8.0);
+    crate::swatches_ui::horix_chords(app, ui);
+    let h = ui.cursor().top() - top;
+    ui.data_mut(|d| d.insert_temp(color_chords_height_id(), h));
+}
