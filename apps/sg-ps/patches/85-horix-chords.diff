+/// Where the Color tab keeps the height its Colour Chords took last frame, which the field leaves
+/// free when it stretches over the group.
+fn color_chords_height_id() -> egui::Id {
+    egui::Id::new("horix-color-chords-height")
+}
+
+fn color_chords_room_id() -> egui::Id {
+    egui::Id::new("horix-color-chords-room")
+}
+
+/// Whether the docked Color tab has room for its Colour Chords under the field (true undocked).
+fn color_chords_room(ui: &egui::Ui) -> bool {
+    ui.data(|d| d.get_temp::<bool>(color_chords_room_id())).unwrap_or(true)
+}
+
+/// HORIX Colour Chords under the Color tab (also at the top of Swatches), from the foreground.
+fn color_tab_chords(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    let top = ui.cursor().top();
+    ui.add_space(8.0);
+    crate::swatches_ui::horix_chords(app, ui);
+    let h = ui.cursor().top() - top;
+    ui.data_mut(|d| d.insert_temp(color_chords_height_id(), h));
 }
 
