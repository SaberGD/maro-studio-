+/// A 400×300 document at 400 %, filling the window round the dialog, with Blur Gallery `cmd` open.
+fn blur_harness(cmd: &str) -> Harness<'static, PhotocraftApp> {
+    let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), crate::Services::default());
+    app.run("file.new", json!({"width": 400, "height": 300})).unwrap();
+    app.sync_views();
+    app.ui.extras.rulers = false;
+    let mut h = Harness::builder().with_size(egui::vec2(1200.0, 800.0)).build_ui_state(
+        |ui, app: &mut PhotocraftApp| {
+            let ctx = ui.ctx().clone();
+            if !ctx.fonts(|f| f.families().contains(&egui::FontFamily::Name("medium".into()))) {
+                return;
+            }
+            crate::shortcuts::handle(app, &ctx);
+            egui::CentralPanel::default().show(ui, |ui| crate::canvas::document_area(app, ui));
+            crate::dialogs::show(app, &ctx);
+        },
+        app,
+    );
+    PhotocraftApp::setup_context(&h.ctx, crate::theme::ThemeKind::ALL[0]);
+    h.run_steps(4);
+    let v = &mut h.state_mut().ui.views[0];
+    // The image left of the dialog, which opens at the right edge.
+    (v.zoom, v.center, v.fit_pending) = (1.0, [420.0, 150.0], false);
+    crate::filter_dialog::open(h.state_mut(), cmd).unwrap();
+    h.run_steps(4);
+    h
+}
+
+fn blur_fields(h: &Harness<'static, PhotocraftApp>) -> serde_json::Map<String, serde_json::Value> {
+    h.state().ui.dialogs.last().unwrap().fields.clone()
+}
+
+fn doc_to_screen(h: &Harness<'static, PhotocraftApp>, p: [f32; 2]) -> egui::Pos2 {
+    let app = h.state();
+    let v = &app.ui.views[0];
+    let xf = crate::canvas::ViewXform {
+        rect: crate::rulers::content_rect(app, app.last_canvas_rect),
+        zoom: v.zoom,
+        center: v.center,
+        flip: false,
+        rotation: v.rotation,
+        aspect: app.ui.view.display_aspect(),
+    };
+    xf.to_screen(p[0], p[1])
+}
+
+fn doc_drag(h: &mut Harness<'static, PhotocraftApp>, a: [f32; 2], b: [f32; 2]) {
+    let (a, b) = (doc_to_screen(h, a), doc_to_screen(h, b));
+    screen_drag(h, a, b);
+}
+
+fn screen_drag(h: &mut Harness<'static, PhotocraftApp>, a: egui::Pos2, b: egui::Pos2) {
+    use egui::{Event, PointerButton};
+    h.event(Event::PointerMoved(a));
+    h.run_steps(1);
+    h.event(Event::PointerButton { pos: a, button: PointerButton::Primary, pressed: true, modifiers: Modifiers::NONE });
+    h.run_steps(1);
+    for k in 1..=5 {
+        h.event(Event::PointerMoved(a + (b - a) * (k as f32 / 5.0)));
+        h.run_steps(1);
+    }
+    h.event(Event::PointerButton { pos: b, button: PointerButton::Primary, pressed: false, modifiers: Modifiers::NONE });
+    h.run_steps(2);
+}
+
+fn f(m: &serde_json::Map<String, serde_json::Value>, k: &str) -> f64 {
+    m[k].as_f64().unwrap()
+}
