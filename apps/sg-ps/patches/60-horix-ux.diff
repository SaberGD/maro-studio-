diff --git a/crates/ui-egui/src/group_delete_prompt.rs b/crates/ui-egui/src/group_delete_prompt.rs
new file mode 100644
index 0000000..bd4d1ad
--- /dev/null
+++ b/crates/ui-egui/src/group_delete_prompt.rs
@@ -0,0 +1,91 @@
+//! HORIX: deleting a group that has layers in it asks what goes, as in Photoshop ("Delete the group
+//! and its contents, or the group only?"), plus HORIX's Contents Only. Every way of deleting from
+//! the UI comes here: the Layers panel's trash button, Delete / ⌫ and Layer › Delete. Automation
+//! deletes at once.
+//!
+//! The prompt is an ordinary dialog: `ui.dialog.set` with `"choice"` (`all`, `groupOnly`,
+//! `contents`) then `ui.dialog.confirm` answers it, `ui.dialog.cancel` keeps everything.
+
+use photocraft_doc::LayerId;
+use serde_json::{Map, Value, json};
+
+use crate::PhotocraftApp;
+use crate::state::DialogKind;
+use crate::widgets::{ButtonRole, DialogButton};
+
+const MARK: &str = "__groupDelete";
+
+pub fn owns(fields: &Map<String, Value>) -> bool {
+    fields.contains_key(MARK)
+}
+
+/// `layer.delete` from the UI with a group that has layers among its targets: the prompt instead.
+pub fn intercept(app: &mut PhotocraftApp, command: &str, params: &Value) -> Option<Result<Value, String>> {
+    if app.automation_input || command != "layer.delete" {
+        return None;
+    }
+    let state = app.session.active()?;
+    let ids = match params.get("layer").and_then(Value::as_u64) {
+        Some(id) => vec![LayerId(id)],
+        None => {
+            let sel = state.selected_layers();
+            if sel.is_empty() { state.active_layer.into_iter().collect() } else { sel }
+        }
+    };
+    let group = ids.iter().filter_map(|id| state.doc.layer(*id)).find(|l| l.children().is_some_and(|c| !c.is_empty()))?;
+    let message = crate::i18n::fmt(tl!("Delete the group “{name}” and its contents, or the group only?"), &[("name", &group.name)]);
+    let layer = params.get("layer").cloned().unwrap_or(Value::Null);
+    let fields = json!({MARK: true, "__label": "Delete Group", "message": message, "document": state.doc.id.0,
+        "selected": state.selected_layers().iter().map(|id| id.0).collect::<Vec<_>>(), "layer": layer, "choice": "all"});
+    if app.ui.dialogs.iter().any(|d| owns(&d.fields)) {
+        return Some(Ok(json!({"confirmationPending": true})));
+    }
+    let id = app.ui.open_dialog(DialogKind::Command, fields.as_object().cloned().unwrap_or_default());
+    Some(Ok(json!({"dialog": id, "confirmationPending": true})))
+}
+
+pub fn body(ui: &mut egui::Ui, fields: &Map<String, Value>) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    ui.label(fields.get("message").and_then(Value::as_str).unwrap_or(tl!("Delete the group and its contents, or the group only?")));
+    ui.add_space(2.0);
+    ui.label(egui::RichText::new(tl!("Group Only keeps its layers in place; Contents Only keeps the empty group.")).color(t.text_dim).size(12.0));
+}
+
+/// The buttons: Group and Contents (the default, ↩), Cancel, Group Only and Contents Only. Sets
+/// `choice` and reports the answer as OK (`Default`) or `Cancel`.
+pub fn buttons(ui: &mut egui::Ui, fields: &mut Map<String, Value>) -> Option<ButtonRole> {
+    let all = DialogButton::new(ButtonRole::Default, tl!("Group and Contents"), 140.0);
+    let cancel = DialogButton::new(ButtonRole::Cancel, tl!("Cancel"), 84.0);
+    let group_only = DialogButton::new(ButtonRole::Alternate, tl!("Group Only"), 96.0);
+    let contents = DialogButton::new(ButtonRole::Apply, tl!("Contents Only"), 108.0);
+    let hit = crate::widgets::dialog_buttons(ui, &[all, cancel, group_only, contents])?;
+    let choice = match hit {
+        ButtonRole::Cancel => return Some(ButtonRole::Cancel),
+        ButtonRole::Default => "all",
+        ButtonRole::Alternate => "groupOnly",
+        ButtonRole::Apply => "contents",
+    };
+    fields.insert("choice".into(), json!(choice));
+    Some(ButtonRole::Default)
+}
+
+/// Runs the answer, unless the document or its selected layers changed meanwhile.
+pub fn confirm(app: &mut PhotocraftApp, fields: &Map<String, Value>) -> Result<Value, String> {
+    let state = app.session.active().ok_or(tl!("The document is closed"))?;
+    if fields.get("document").and_then(Value::as_u64) != Some(state.doc.id.0)
+        || fields.get("selected") != Some(&json!(state.selected_layers().iter().map(|id| id.0).collect::<Vec<_>>()))
+    {
+        return Err(tl!("The document or selected layers changed. Please request deletion again.").into());
+    }
+    let mut params = json!({});
+    if let Some(layer) = fields.get("layer").filter(|v| v.is_u64()) {
+        params["layer"] = layer.clone();
+    }
+    match fields.get("choice").and_then(Value::as_str).unwrap_or("all") {
+        "groupOnly" | "contents" => {
+            params["mode"] = fields["choice"].clone();
+            app.run_command("layer.deleteGroup", params)
+        }
+        _ => app.run_command("layer.delete", params),
+    }
+}
diff --git a/crates/ui-egui/src/horix_ux.rs b/crates/ui-egui/src/horix_ux.rs
new file mode 100644
index 0000000..ded449b
--- /dev/null
+++ b/crates/ui-egui/src/horix_ux.rs
@@ -0,0 +1,179 @@
+//! HORIX's own UX fixes on top of PhotoCraft 0.9 (the team's bug rounds, apps/sg-ps/NEXT-STEPS.md):
+//! the Color panel's Eyedropper button, Properties coming forward for the shape / type / pen tools
+//! and layers, P for before / after in previewing dialogs, the overset-text mark, and Select ›
+//! Modify's live preview.
+
+use egui::{Color32, Pos2, Stroke, pos2};
+use photocraft_doc::{Document, LayerContent, LayerId};
+use photocraft_geom::Point;
+use serde_json::{Map, Value, json};
+
+use crate::PhotocraftApp;
+use crate::canvas::ViewXform;
+use crate::state::Tool;
+
+/// The Color panel's Eyedropper button (bug #5): picks the Eyedropper tool (I), so the next click
+/// on the canvas sets the foreground colour (⌥-click: the background).
+pub fn eyedropper_button(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    let on = app.ui.tool == Tool::Eyedropper;
+    if crate::icons::button(ui, "pipette", 22.0, on, tl!("Pick a color from the image (Eyedropper)")).clicked() {
+        app.ui.tool = Tool::Eyedropper;
+    }
+}
+
+/// Tools whose live options Properties shows (Photoshop: the shape's or the type's properties).
+pub fn properties_tool(tool: Tool) -> bool {
+    tool.is_type()
+        || matches!(
+            tool,
+            Tool::Rectangle
+                | Tool::EllipseShape
+                | Tool::Triangle
+                | Tool::Polygon
+                | Tool::Line
+                | Tool::CustomShape
+                | Tool::Pen
+                | Tool::FreeformPen
+                | Tool::CurvaturePen
+        )
+}
+
+/// Layers whose settings live in Properties: shape (Fill / Stroke), type (Character) and
+/// gradient fill layers.
+pub fn properties_layer(doc: &Document, id: LayerId) -> bool {
+    doc.layer(id)
+        .is_some_and(|l| matches!(l.content, LayerContent::Shape(_) | LayerContent::Text(_) | LayerContent::Fill(photocraft_doc::Fill::Gradient { .. })))
+}
+
+/// Bring Properties to the front, shown and expanded (as upstream does for a new adjustment layer).
+pub fn raise_properties(app: &mut PhotocraftApp) {
+    if app.ui.docking.is_some() {
+        let _ = crate::panel_docking::command(app, "window.panel.activate", &json!({"panel": "properties"}));
+    } else {
+        app.ui.dock_tabs.properties = 0;
+        crate::dock::reveal(app, crate::dock::Group::Properties);
+    }
+}
+
+/// What [`frame`] saw last: the tool, and the document and its active layer.
+#[derive(Clone, Copy, PartialEq)]
+struct Seen(Tool, Option<(photocraft_doc::DocId, Option<LayerId>)>);
+
+/// Once per frame (bug #5, round 1 #11): picking a shape, type or pen tool, or making a shape,
+/// type or gradient fill layer active, brings Properties forward, in every theme. Only the change
+/// does, so closing the panel afterwards sticks. Switching documents doesn't count. The panel moves
+/// once the pointer is up and a double-click can no longer follow, so the click that selected a
+/// layer row is never followed by a second one landing on a shifted dock.
+pub fn frame(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let (key, pending) = (egui::Id::new("horix-properties-seen"), egui::Id::new("horix-properties-pending"));
+    let doc = app.session.active().map(|st| (st.doc.id, st.active_layer));
+    let now = Seen(app.ui.tool, doc);
+    let before = ctx.data(|d| d.get_temp::<Seen>(key));
+    ctx.data_mut(|d| d.insert_temp(key, now));
+    if let Some(before) = before.filter(|b| *b != now) {
+        let tool_wants = before.0 != now.0 && properties_tool(now.0);
+        let layer_wants = match (before.1, now.1) {
+            (Some((d0, l0)), Some((d1, Some(l1)))) if d0 == d1 && l0 != Some(l1) => app.session.active().is_some_and(|st| properties_layer(&st.doc, l1)),
+            _ => false,
+        };
+        if tool_wants || layer_wants {
+            ctx.data_mut(|d| d.insert_temp(pending, true));
+        } else if before.0 != now.0 || before.1 != now.1 {
+            // Another tool or layer since: nothing left to show.
+            ctx.data_mut(|d| d.remove::<bool>(pending));
+        }
+    }
+    if !ctx.data(|d| d.get_temp::<bool>(pending).unwrap_or(false)) {
+        return;
+    }
+    let busy = ctx.input(|i| i.pointer.any_down() || i.pointer.time_since_last_click() < 0.35);
+    if busy {
+        ctx.request_repaint_after(std::time::Duration::from_millis(100));
+        return;
+    }
+    ctx.data_mut(|d| d.remove::<bool>(pending));
+    raise_properties(app);
+}
+
+/// Photoshop's P in a previewing dialog (Windows user #3): flips Preview between the result and
+/// the original. Not while a text field or a popup has the keys; Select and Mask keeps P for its
+/// own Show Original.
+pub fn preview_key(ctx: &egui::Context, fields: &mut Map<String, Value>) {
+    let Some(on) = fields.get("__preview").and_then(Value::as_bool) else { return };
+    if crate::select_mask_view::owns(fields) || ctx.memory(|m| m.focused().is_some()) || egui::Popup::is_any_open(ctx) {
+        return;
+    }
+    if ctx.input_mut(|i| i.consume_key(egui::Modifiers::NONE, egui::Key::P)) {
+        fields.insert("__preview".into(), json!(!on));
+        ctx.request_repaint();
+    }
+}
+
+/// Photoshop's overset-text mark (round 1 #12): a red "+" in a square on the box's bottom-right
+/// handle, for paragraph text that does not fit in its box.
+pub fn overflow_mark(painter: &egui::Painter, at: Pos2) {
+    let red = Color32::from_rgb(214, 60, 50);
+    let r = egui::Rect::from_center_size(at, egui::vec2(13.0, 13.0));
+    painter.rect_filled(r, 0.0, Color32::WHITE);
+    painter.rect_stroke(r, 0.0, Stroke::new(1.5, red), egui::StrokeKind::Inside);
+    let s = Stroke::new(1.8, red);
+    painter.line_segment([pos2(r.left() + 3.5, r.center().y), pos2(r.right() - 3.5, r.center().y)], s);
+    painter.line_segment([pos2(r.center().x, r.top() + 3.5), pos2(r.center().x, r.bottom() - 3.5)], s);
+}
+
+/// Where the overset mark of type layer `id` goes (document points), when its text overflows.
+pub fn overflow_corner(app: &mut PhotocraftApp, id: LayerId) -> Option<[f32; 2]> {
+    let shape = app.session.active().and_then(|st| match &st.doc.layer(id)?.content {
+        LayerContent::Text(t) => Some(t.shape.clone()),
+        _ => None,
+    })?;
+    let photocraft_doc::text::TextShape::Box { x, y, width, height } = shape else { return None };
+    let (l, aff, _) = crate::type_tool::layout(app, id)?;
+    if !l.overflow {
+        return None;
+    }
+    let p = aff.apply(Point::new(f64::from(x + width), f64::from(y + height)));
+    Some([p.x as f32, p.y as f32])
+}
+
+/// The overset mark for the active paragraph type layer while it is not being edited (the editing
+/// frame draws its own), with the Type or Move tool, as Photoshop shows it.
+pub fn draw_overflow_hint(app: &mut PhotocraftApp, painter: &egui::Painter, xf: &ViewXform) {
+    if app.ui.text_edit.is_some() || !(app.ui.tool.is_type() || app.ui.tool == Tool::Move) {
+        return;
+    }
+    let Some(id) = app.session.active().and_then(|s| s.active_layer) else { return };
+    if let Some(p) = overflow_corner(app, id) {
+        overflow_mark(painter, xf.to_screen(p[0], p[1]));
+    }
+}
+
+/// Select › Modify previews the selection it makes (Windows user #2): Photoshop's red overlay at
+/// 50 % over what is not selected, as a top layer of the preview document.
+pub fn selection_overlay(doc: &mut Document) {
+    if doc.mode != photocraft_color::ColorMode::Rgb {
+        return;
+    }
+    let area = doc.bounds();
+    if area.is_empty() {
+        return;
+    }
+    let n = (area.width() as usize) * (area.height() as usize);
+    let selected: Vec<f32> = match &doc.selection {
+        Some(s) => {
+            let c = s.channels().max(1);
+            s.read_region(area).chunks_exact(c).map(|p| p[0].clamp(0.0, 1.0)).collect()
+        }
+        None => vec![1.0; n],
+    };
+    let mut px = Vec::with_capacity(n * 4);
+    for v in selected {
+        px.extend([1.0, 0.0, 0.0, 0.5 * (1.0 - v)]);
+    }
+    let fmt = photocraft_color::PixelFormat::new(photocraft_color::ColorMode::Rgb, doc.depth, true);
+    let mut l = photocraft_doc::Layer::raster("Selection preview", fmt);
+    if let Some(s) = l.surface_mut() {
+        s.write_region(area, &px);
+        doc.layers.push(l);
+    }
+}
