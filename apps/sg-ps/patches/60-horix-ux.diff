@@ -0,0 +1,728 @@
+//! HORIX (round 4 #3, round 5 #2): Path Blur gets Photoshop's on-canvas controls too. Upstream's
+//! `blur_pins` (PhotoCraft 0.10+) owns Field, Iris, Spin and Tilt-Shift, so only `pathBlur` is
+//! live here; the other kinds' geometry stays for the tests. While a blur is open, its geometry is
+//! drawn on the image under the dialog and dragged there: Path Blur's arrow and its end and bend points, Tilt-Shift's focus and transition lines
+//! (and the dot that rotates them), the Iris and Spin ellipses with their size handles (and
+//! Iris's feather handle), each blur's centre pin and the ring that sets its blur (Spin: its arc).
+//! The handles edit the dialog's own fields (`centerX`, `radiusX`, `focus`, `startX`…, fractions
+//! of the filter's bounds as the engine reads them), so the sliders and the preview follow.
+//!
+//! Iris and Spin take several pins and Path Blur several paths: a click on an empty spot adds one
+//! (drag at once to place it), a click on one selects it (the sliders then edit it), Delete or
+//! Backspace removes the selected one (never the last), and a click on the selected path's
+//! segment adds a bend point. They travel as the command's `pins` / `paths`.
+
+use egui::{Color32, Pos2, Shape, Stroke, pos2, vec2};
+use serde_json::{Map, Value, json};
+
+use crate::PhotocraftApp;
+use crate::canvas::ViewXform;
+
+const PREFIX: &str = "filter.blurGallery.";
+const KINDS: [&str; 1] = ["pathBlur"];
+/// The handle being dragged, and the one under the pointer (egui memory).
+const HELD: &str = "horix-blur-handle-held";
+const NEAR: &str = "horix-blur-handle-near";
+/// Screen radius of the blur ring.
+const RING_R: f32 = 30.0;
+/// More pins or paths than anyone places by hand (as `blur_pins::MAX_PINS`).
+const MAX_ITEMS: usize = 64;
+
+fn kind(fields: &Map<String, Value>) -> Option<&str> {
+    fields.get("__command").and_then(Value::as_str)?.strip_prefix(PREFIX).filter(|k| KINDS.contains(k))
+}
+
+pub fn owns(fields: &Map<String, Value>) -> bool {
+    kind(fields).is_some()
+}
+
+/// A freshly opened dialog: the filter's bounds (the selection's, else the canvas), and its
+/// fields as the first pin / path.
+pub fn init(app: &mut PhotocraftApp, fields: &mut Map<String, Value>) {
+    let bounds = app.session.active().map(|st| (st.doc.id, st.doc.bounds(), st.doc.selection.clone()));
+    if let Some((doc, canvas, selection)) = bounds {
+        let b = selection.map(|s| app.cached_bounds(u64::MAX - doc.0, &s)).filter(|b| !b.is_empty()).unwrap_or(canvas);
+        fields.insert("__bounds".into(), json!([b.x0, b.y0, b.x1, b.y1]));
+    }
+    if let Some(k) = kind(fields).map(str::to_owned) {
+        fields.remove("pins");
+        fields.remove("paths");
+        sync(&k, fields);
+    }
+}
+
+/// Where the dialog first opens: at the right edge, beside the image, as Photoshop docks its Blur
+/// Tools panel, so the controls under it stay in view.
+pub fn first_place(fields: &Map<String, Value>, ctx: &egui::Context) -> Option<egui::Vec2> {
+    owns(fields).then(|| vec2((ctx.content_rect().width() - 480.0).max(0.0), 96.0))
+}
+
+fn num(f: &Map<String, Value>, k: &str, d: f32) -> f32 {
+    f.get(k).and_then(Value::as_f64).filter(|v| v.is_finite()).map_or(d, |v| v as f32)
+}
+
+/// The filter's bounds: `[x0, y0, width, height]` in document pixels.
+#[derive(Clone, Copy)]
+struct Geo {
+    b: [f32; 4],
+}
+
+impl Geo {
+    fn of(f: &Map<String, Value>) -> Option<Self> {
+        let a = f.get("__bounds")?.as_array()?;
+        let v = |i: usize| a.get(i).and_then(Value::as_f64).map(|x| x as f32);
+        let (x0, y0, x1, y1) = (v(0)?, v(1)?, v(2)?, v(3)?);
+        (x1 > x0 && y1 > y0).then_some(Self { b: [x0, y0, x1 - x0, y1 - y0] })
+    }
+    /// The shorter side: radii and distances are fractions of it.
+    fn ss(&self) -> f32 {
+        self.b[2].min(self.b[3]).max(1.0)
+    }
+    /// Fractions → document pixels.
+    fn doc(&self, fx: f32, fy: f32) -> [f32; 2] {
+        [self.b[0] + fx * self.b[2], self.b[1] + fy * self.b[3]]
+    }
+    /// Document pixels → fractions.
+    fn frac(&self, p: [f32; 2]) -> [f32; 2] {
+        [(p[0] - self.b[0]) / self.b[2].max(1.0), (p[1] - self.b[1]) / self.b[3].max(1.0)]
+    }
+}
+
+/// A draggable point: its key and position (document pixels).
+type Handle = (String, [f32; 2]);
+
+/// The command's list parameter for kinds that take several pins or paths.
+fn list_key(kind: &str) -> Option<&'static str> {
+    match kind {
+        "irisBlur" | "spinBlur" => Some("pins"),
+        "pathBlur" => Some("paths"),
+        _ => None,
+    }
+}
+
+fn sel(f: &Map<String, Value>) -> usize {
+    f.get("__pin").and_then(Value::as_u64).unwrap_or(0) as usize
+}
+
+fn items(f: &Map<String, Value>, key: &str) -> Vec<Value> {
+    f.get(key).and_then(Value::as_array).cloned().unwrap_or_default()
+}
+
+/// The selected pin / path as the filter reads it, from the dialog's fields (a path keeps the
+/// bend points of `prev`).
+fn to_item(kind: &str, f: &Map<String, Value>, prev: Option<&Value>) -> Value {
+    let n = |k: &str, d: f32| json!(num(f, k, d));
+    match kind {
+        "irisBlur" => {
+            json!({"x": n("centerX", 0.5), "y": n("centerY", 0.5), "radiusX": n("radiusX", 0.35), "radiusY": n("radiusY", 0.25), "angle": n("angle", 0.0),
+            "roundness": n("roundness", 0.0), "feather": n("feather", 0.5), "blur": n("blur", 15.0)})
+        }
+        "spinBlur" => {
+            json!({"x": n("centerX", 0.5), "y": n("centerY", 0.5), "radiusX": n("radiusX", 0.3), "radiusY": n("radiusY", 0.3), "angle": n("angle", 0.0), "blurAngle": n("blurAngle", 15.0)})
+        }
+        _ => {
+            let mid: Vec<Value> = prev
+                .and_then(|p| p.get("points")?.as_array().cloned())
+                .map(|pts| if pts.len() > 2 { pts[1..pts.len() - 1].to_vec() } else { Vec::new() })
+                .unwrap_or_default();
+            let mut pts = vec![json!([num(f, "startX", 0.2), num(f, "startY", 0.5)])];
+            pts.extend(mid);
+            pts.push(json!([num(f, "endX", 0.8), num(f, "endY", 0.5)]));
+            json!({"points": pts, "speed": n("speed", 50.0), "taper": n("taper", 0.0)})
+        }
+    }
+}
+
+/// Load a pin / path into the dialog's fields (the sliders edit the selected one).
+fn load_item(kind: &str, item: &Value, f: &mut Map<String, Value>) {
+    let mut put = |k: &str, v: Option<&Value>| {
+        if let Some(v) = v {
+            f.insert(k.into(), v.clone());
+        }
+    };
+    if kind == "pathBlur" {
+        let pts = item.get("points").and_then(Value::as_array).cloned().unwrap_or_default();
+        if let (Some(a), Some(b)) = (pts.first(), pts.last()) {
+            put("startX", a.get(0));
+            put("startY", a.get(1));
+            put("endX", b.get(0));
+            put("endY", b.get(1));
+        }
+        put("speed", item.get("speed"));
+        put("taper", item.get("taper"));
+        return;
+    }
+    put("centerX", item.get("x"));
+    put("centerY", item.get("y"));
+    for k in ["radiusX", "radiusY", "angle", "roundness", "feather", "blur", "blurAngle"] {
+        put(k, item.get(k));
+    }
+}
+
+/// Keep the list parameter in step with the fields: made from them the first time, then the
+/// selected entry follows the sliders and handles.
+fn sync(kind: &str, f: &mut Map<String, Value>) {
+    let Some(key) = list_key(kind) else { return };
+    let mut list = items(f, key);
+    let s = sel(f).min(list.len().saturating_sub(1));
+    let item = to_item(kind, f, list.get(s));
+    if list.is_empty() {
+        list.push(item);
+    } else {
+        list[s] = item;
+    }
+    f.insert(key.into(), Value::Array(list));
+    f.insert("__pin".into(), json!(s));
+}
+
+fn path_points(f: &Map<String, Value>, i: usize) -> Vec<[f32; 2]> {
+    items(f, "paths")
+        .get(i)
+        .and_then(|p| p.get("points")?.as_array().cloned())
+        .map(|a| a.iter().filter_map(|q| Some([q.get(0)?.as_f64()? as f32, q.get(1)?.as_f64()? as f32])).collect())
+        .unwrap_or_default()
+}
+
+fn handles(kind: &str, f: &Map<String, Value>, g: &Geo) -> Vec<Handle> {
+    let c = g.doc(num(f, "centerX", 0.5), num(f, "centerY", 0.5));
+    let ss = g.ss();
+    let h = |k: &str, p: [f32; 2]| (k.to_string(), p);
+    match kind {
+        "pathBlur" => {
+            let pts = path_points(f, sel(f));
+            if pts.len() >= 2 {
+                pts.iter().enumerate().map(|(i, q)| (format!("p{i}"), g.doc(q[0], q[1]))).collect()
+            } else {
+                vec![h("p0", g.doc(num(f, "startX", 0.2), num(f, "startY", 0.5))), h("p1", g.doc(num(f, "endX", 0.8), num(f, "endY", 0.5)))]
+            }
+        }
+        "tiltShift" => {
+            let (s, co) = num(f, "angle", 0.0).to_radians().sin_cos();
+            let (n, d) = ([s, co], [co, -s]);
+            let (f0, f1) = (num(f, "focus", 0.1) * ss, (num(f, "focus", 0.1) + num(f, "transition", 0.15)) * ss);
+            let at = |k: f32, along: f32| [c[0] + n[0] * k + d[0] * along, c[1] + n[1] * k + d[1] * along];
+            vec![h("center", c), h("focus", at(f0, 0.0)), h("transition", at(f1, 0.0)), h("rotate", at(f0, 0.35 * ss))]
+        }
+        "irisBlur" | "spinBlur" => {
+            let iris = kind == "irisBlur";
+            let (s, co) = num(f, "angle", 0.0).to_radians().sin_cos();
+            let (rx, ry) = (num(f, "radiusX", if iris { 0.35 } else { 0.3 }) * ss, num(f, "radiusY", if iris { 0.25 } else { 0.3 }) * ss);
+            let mut v = vec![h("center", c), h("radiusX", [c[0] + co * rx, c[1] + s * rx]), h("radiusY", [c[0] - s * ry, c[1] + co * ry])];
+            if iris {
+                let fe = num(f, "feather", 0.5);
+                v.push(h("feather", [c[0] + co * rx * fe, c[1] + s * rx * fe]));
+            }
+            v
+        }
+        _ => vec![h("center", c)],
+    }
+}
+
+fn r3(v: f32) -> Value {
+    json!((v * 1000.0).round() / 1000.0)
+}
+
+/// Apply a drag of handle `h` to document point `p`.
+fn drag(kind: &str, h: &str, p: [f32; 2], f: &mut Map<String, Value>, g: &Geo) {
+    let fr = g.frac(p);
+    let (fx, fy) = (fr[0].clamp(0.0, 1.0), fr[1].clamp(0.0, 1.0));
+    let c = g.doc(num(f, "centerX", 0.5), num(f, "centerY", 0.5));
+    let (dx, dy) = (p[0] - c[0], p[1] - c[1]);
+    let ss = g.ss();
+    let (s, co) = num(f, "angle", 0.0).to_radians().sin_cos();
+    if kind == "pathBlur"
+        && let Some(i) = h.strip_prefix('p').and_then(|v| v.parse::<usize>().ok())
+    {
+        let n = path_points(f, sel(f)).len().max(2);
+        if i == 0 {
+            f.insert("startX".into(), r3(fx));
+            f.insert("startY".into(), r3(fy));
+        } else if i + 1 == n {
+            f.insert("endX".into(), r3(fx));
+            f.insert("endY".into(), r3(fy));
+        } else {
+            // A bend point lives only in the path list.
+            let s = sel(f);
+            if let Some(Value::Array(list)) = f.get_mut("paths")
+                && let Some(pts) = list.get_mut(s).and_then(|p| p.get_mut("points")).and_then(Value::as_array_mut)
+                && let Some(q) = pts.get_mut(i)
+            {
+                *q = json!([(fx * 1000.0).round() / 1000.0, (fy * 1000.0).round() / 1000.0]);
+            }
+        }
+        return;
+    }
+    match (kind, h) {
+        (_, "center") => {
+            f.insert("centerX".into(), r3(fx));
+            f.insert("centerY".into(), r3(fy));
+        }
+        ("tiltShift", "focus") => {
+            f.insert("focus".into(), r3(((dx * s + dy * co).abs() / ss).clamp(0.0, 1.0)));
+        }
+        ("tiltShift", "transition") => {
+            let t = (dx * s + dy * co).abs() / ss - num(f, "focus", 0.1);
+            f.insert("transition".into(), r3(t.clamp(0.01, 1.0)));
+        }
+        ("tiltShift", "rotate") => {
+            // The band runs along (cos a, −sin a): the angle that points it at the pointer, folded
+            // into −90…90 (a band has no direction).
+            let mut a = (-dy).atan2(dx).to_degrees();
+            if a > 90.0 {
+                a -= 180.0;
+            } else if a < -90.0 {
+                a += 180.0;
+            }
+            f.insert("angle".into(), json!(a.round()));
+        }
+        (_, "radiusX") => {
+            f.insert("radiusX".into(), r3(((dx * co + dy * s).abs() / ss).clamp(0.01, 1.0)));
+        }
+        (_, "radiusY") => {
+            f.insert("radiusY".into(), r3(((-dx * s + dy * co).abs() / ss).clamp(0.01, 1.0)));
+        }
+        ("irisBlur", "feather") => {
+            let rx = num(f, "radiusX", 0.35) * ss;
+            f.insert("feather".into(), r3(((dx * co + dy * s) / rx.max(1.0)).clamp(0.0, 0.99)));
+        }
+        _ => {}
+    }
+}
+
+/// The blur ring: (field, value of a full turn). Iris's sets its blur, Spin's its arc.
+fn ring(kind: &str) -> Option<(&'static str, f32)> {
+    match kind {
+        "irisBlur" | "tiltShift" => Some(("blur", 500.0)),
+        "spinBlur" => Some(("blurAngle", 360.0)),
+        _ => None,
+    }
+}
+
+/// Add a pin / path at document point `p` (a copy of the selected one), select it and return the
+/// handle a drag that started with the click should move.
+fn add_item(kind: &str, f: &mut Map<String, Value>, g: &Geo, p: [f32; 2], zoom: f32) -> Option<&'static str> {
+    let key = list_key(kind)?;
+    let mut list = items(f, key);
+    if list.len() >= MAX_ITEMS {
+        return None;
+    }
+    let fr = g.frac(p);
+    let (fx, fy) = (fr[0].clamp(0.0, 1.0), fr[1].clamp(0.0, 1.0));
+    let mut item = to_item(kind, f, None);
+    let grab = if kind == "pathBlur" {
+        let len = (120.0 / zoom.max(0.01) / g.b[2].max(1.0)).min(0.3);
+        item["points"] = json!([[fx, fy], [(fx + len).min(1.0), fy]]);
+        "p1"
+    } else {
+        item["x"] = json!(fx);
+        item["y"] = json!(fy);
+        "center"
+    };
+    list.push(item.clone());
+    f.insert("__pin".into(), json!(list.len() - 1));
+    f.insert(key.into(), Value::Array(list));
+    load_item(kind, &item, f);
+    Some(grab)
+}
+
+fn select_item(kind: &str, f: &mut Map<String, Value>, i: usize) {
+    let Some(key) = list_key(kind) else { return };
+    if let Some(item) = items(f, key).get(i).cloned() {
+        f.insert("__pin".into(), json!(i));
+        load_item(kind, &item, f);
+    }
+}
+
+/// Delete the selected pin / path (the last one stays).
+fn delete_item(kind: &str, f: &mut Map<String, Value>) -> bool {
+    let Some(key) = list_key(kind) else { return false };
+    let mut list = items(f, key);
+    if list.len() <= 1 {
+        return false;
+    }
+    let s = sel(f).min(list.len() - 1);
+    list.remove(s);
+    f.insert(key.into(), Value::Array(list));
+    select_item(kind, f, s.saturating_sub(1));
+    true
+}
+
+fn seg_dist(p: Pos2, a: Pos2, b: Pos2) -> f32 {
+    let ab = b - a;
+    let t = ((p - a).dot(ab) / ab.length_sq().max(1e-6)).clamp(0.0, 1.0);
+    (a + ab * t).distance(p)
+}
+
+fn screen(xf: &ViewXform, p: [f32; 2]) -> Pos2 {
+    xf.to_screen(p[0], p[1])
+}
+
+fn item_centre(g: &Geo, it: &Value) -> [f32; 2] {
+    let v = |k: &str| it.get(k).and_then(Value::as_f64).unwrap_or(0.5) as f32;
+    g.doc(v("x"), v("y"))
+}
+
+/// Where the ring's handle sits: at the angle that shows the value (a quarter turn = a quarter
+/// of its full-turn value), from the top.
+fn ring_pos(kind: &str, f: &Map<String, Value>, c: Pos2) -> Option<Pos2> {
+    ring(kind).map(|(k, full)| {
+        let a = (num(f, k, 15.0) / full * 360.0 - 90.0).to_radians();
+        c + vec2(a.cos(), a.sin()) * RING_R
+    })
+}
+
+/// What the pointer at screen point `p` is on: a handle's key, `ring`, or nothing.
+fn near(kind: &str, f: &Map<String, Value>, g: &Geo, xf: &ViewXform, p: Pos2) -> Option<String> {
+    let hit = handles(kind, f, g).into_iter().map(|(k, q)| (k, screen(xf, q).distance(p))).filter(|(_, d)| *d <= 12.0).min_by(|a, b| a.1.total_cmp(&b.1));
+    if let Some((k, _)) = hit {
+        return Some(k);
+    }
+    let c = screen(xf, g.doc(num(f, "centerX", 0.5), num(f, "centerY", 0.5)));
+    ring_pos(kind, f, c).filter(|r| r.distance(p) <= 10.0).map(|_| "ring".to_string())
+}
+
+/// The pointer on the free image under the dialog: `over` is where it is, `press` where the
+/// primary button is held (`dialogs::free_press`), both in screen points. Returns whether the
+/// controls took it.
+pub fn canvas(app: &mut PhotocraftApp, ctx: &egui::Context, xf: &ViewXform, over: Pos2, press: Option<Pos2>) -> bool {
+    let Some(d) = app.ui.dialogs.last_mut().filter(|d| owns(&d.fields)) else { return false };
+    let f = &mut d.fields;
+    let Some(k) = kind(f).map(str::to_owned) else { return false };
+    let Some(g) = Geo::of(f) else { return false };
+    sync(&k, f);
+    let (held_id, near_id) = (egui::Id::new(HELD), egui::Id::new(NEAR));
+    let mut held: Option<String> = ctx.data(|m| m.get_temp(held_id));
+    let (start, down) = ctx.input(|i| (i.pointer.primary_pressed(), i.pointer.primary_down()));
+    let hover = near(&k, f, &g, xf, over);
+    if start
+        && held.is_none()
+        && let Some(at) = press
+    {
+        // A press on the image takes the keys from the dialog's fields (Delete is the pin's then).
+        ctx.memory_mut(|m| {
+            if let Some(id) = m.focused() {
+                m.surrender_focus(id);
+            }
+        });
+        held = near(&k, f, &g, xf, at);
+        if held.is_none()
+            && let Some(key) = list_key(&k)
+        {
+            // Another pin / path under the pointer selects it; a segment of the selected path
+            // gets a bend point there; elsewhere a new pin / path starts.
+            let list = items(f, key);
+            let s = sel(f);
+            let (mut other, mut bend) = (None, None);
+            for (i, it) in list.iter().enumerate() {
+                if k == "pathBlur" {
+                    let pts: Vec<Pos2> = path_points(f, i).iter().map(|q| screen(xf, g.doc(q[0], q[1]))).collect();
+                    for (j, w) in pts.windows(2).enumerate() {
+                        if seg_dist(at, w[0], w[1]) <= 8.0 {
+                            if i == s {
+                                bend = Some(j + 1);
+                            } else {
+                                other = Some(i);
+                            }
+                        }
+                    }
+                } else if i != s && screen(xf, item_centre(&g, it)).distance(at) <= 14.0 {
+                    other = Some(i);
+                }
+            }
+            let q = xf.to_doc(at);
+            let q = [q[0] as f32, q[1] as f32];
+            if let Some(i) = other {
+                select_item(&k, f, i);
+            } else if let Some(j) = bend {
+                let fr = g.frac(q);
+                if let Some(Value::Array(list)) = f.get_mut("paths")
+                    && let Some(pts) = list.get_mut(s).and_then(|p| p.get_mut("points")).and_then(Value::as_array_mut)
+                {
+                    pts.insert(j, json!([fr[0].clamp(0.0, 1.0), fr[1].clamp(0.0, 1.0)]));
+                }
+                held = Some(format!("p{j}"));
+            } else if (g.b[0]..=g.b[0] + g.b[2]).contains(&q[0]) && (g.b[1]..=g.b[1] + g.b[3]).contains(&q[1]) {
+                held = add_item(&k, f, &g, q, xf.zoom).map(str::to_string);
+            }
+        }
+    }
+    if !down {
+        held = None;
+    }
+    // Delete / ⌫ removes the selected pin or path, unless a text field has the keys.
+    if ctx.memory(|m| m.focused().is_none())
+        && ctx.input_mut(|i| i.consume_key(egui::Modifiers::NONE, egui::Key::Delete) || i.consume_key(egui::Modifiers::NONE, egui::Key::Backspace))
+    {
+        delete_item(&k, f);
+    }
+    if let (Some(h), Some(p)) = (held.as_deref(), press) {
+        if h == "ring" {
+            if let Some((key, full)) = ring(&k) {
+                let c = screen(xf, g.doc(num(f, "centerX", 0.5), num(f, "centerY", 0.5)));
+                let v = p - c;
+                let deg = (v.y.atan2(v.x).to_degrees() + 90.0).rem_euclid(360.0);
+                f.insert(key.into(), json!((deg / 360.0 * full).round()));
+            }
+        } else {
+            let q = xf.to_doc(p);
+            drag(&k, h, [q[0] as f32, q[1] as f32], f, &g);
+        }
+        ctx.request_repaint();
+    }
+    sync(&k, f);
+    ctx.set_cursor_icon(if held.is_some() {
+        egui::CursorIcon::Grabbing
+    } else if hover.is_some() {
+        egui::CursorIcon::Grab
+    } else if list_key(&k).is_some() {
+        // Photoshop's "add pin" pointer.
+        egui::CursorIcon::Crosshair
+    } else {
+        egui::CursorIcon::Default
+    });
+    ctx.data_mut(|m| {
+        match &held {
+            Some(h) => {
+                m.insert_temp(held_id, h.clone());
+            }
+            None => m.remove::<String>(held_id),
+        }
+        match &hover {
+            Some(h) => {
+                m.insert_temp(near_id, h.clone());
+            }
+            None => m.remove::<String>(near_id),
+        }
+    });
+    true
+}
+
+/// Preview proxies run at 1/`k` of the document: Path Blur's per-path speed (pixels) scales with
+/// them, as its single `speed` does (Iris pins' blur is scaled by `blur_pins::scale_for_proxy`).
+pub fn scale_for_proxy(params: &mut Value, k: u32) {
+    if k <= 1 {
+        return;
+    }
+    let Some(list) = params.get_mut("paths").and_then(Value::as_array_mut) else { return };
+    for path in list {
+        if let Some(v) = path.get("speed").and_then(Value::as_f64) {
+            path["speed"] = json!(v / f64::from(k));
+        }
+    }
+}
+
+fn line(painter: &egui::Painter, a: Pos2, b: Pos2, dashed: bool) {
+    let shadow = Stroke::new(3.0, Color32::from_black_alpha(140));
+    let white = Stroke::new(1.5, Color32::WHITE);
+    if dashed {
+        painter.extend(Shape::dashed_line(&[a, b], shadow, 8.0, 6.0));
+        painter.extend(Shape::dashed_line(&[a, b], white, 8.0, 6.0));
+    } else {
+        painter.line_segment([a, b], shadow);
+        painter.line_segment([a, b], white);
+    }
+}
+
+fn ellipse(painter: &egui::Painter, c: Pos2, rx: f32, ry: f32, angle: f32, dashed: bool) {
+    let (s, co) = angle.to_radians().sin_cos();
+    let pts: Vec<Pos2> = (0..=72)
+        .map(|i| {
+            let t = i as f32 / 72.0 * std::f32::consts::TAU;
+            let (u, v) = (t.cos() * rx, t.sin() * ry);
+            pos2(c.x + u * co - v * s, c.y + u * s + v * co)
+        })
+        .collect();
+    if dashed {
+        for w in pts.windows(2) {
+            line(painter, w[0], w[1], true);
+        }
+    } else {
+        painter.add(Shape::line(pts.clone(), Stroke::new(3.0, Color32::from_black_alpha(140))));
+        painter.add(Shape::line(pts, Stroke::new(1.5, Color32::WHITE)));
+    }
+}
+
+fn dot(painter: &egui::Painter, p: Pos2, r: f32, hot: bool) {
+    painter.circle_filled(p, r + 1.5, Color32::from_black_alpha(150));
+    painter.circle_filled(p, r, if hot { Color32::from_rgb(234, 153, 63) } else { Color32::WHITE });
+}
+
+/// Draw the open blur's controls over the image.
+pub fn draw(app: &PhotocraftApp, painter: &egui::Painter, xf: &ViewXform) {
+    let Some(d) = app.ui.dialogs.last().filter(|d| owns(&d.fields)) else { return };
+    let f = &d.fields;
+    let (Some(k), Some(g)) = (kind(f), Geo::of(f)) else { return };
+    let ctx = painter.ctx();
+    let held: Option<String> = ctx.data(|m| m.get_temp(egui::Id::new(HELD)));
+    let hover: Option<String> = ctx.data(|m| m.get_temp(egui::Id::new(NEAR)));
+    let hot = |key: &str| held.as_deref() == Some(key) || hover.as_deref() == Some(key);
+    let hs = handles(k, f, &g);
+    let ss = g.ss() * xf.zoom;
+    let c = screen(xf, g.doc(num(f, "centerX", 0.5), num(f, "centerY", 0.5)));
+    let s = sel(f);
+    // The other pins / paths, quieter.
+    if let Some(key) = list_key(k) {
+        for (i, it) in items(f, key).iter().enumerate() {
+            if i == s {
+                continue;
+            }
+            if k == "pathBlur" {
+                let pts: Vec<Pos2> = path_points(f, i).iter().map(|q| screen(xf, g.doc(q[0], q[1]))).collect();
+                for w in pts.windows(2) {
+                    line(painter, w[0], w[1], true);
+                }
+            } else {
+                let q = screen(xf, item_centre(&g, it));
+                painter.circle_stroke(q, 9.0, Stroke::new(3.0, Color32::from_black_alpha(150)));
+                painter.circle_stroke(q, 9.0, Stroke::new(1.5, Color32::from_gray(200)));
+            }
+        }
+    }
+    match k {
+        "pathBlur" => {
+            let pts: Vec<Pos2> = hs.iter().map(|(_, q)| screen(xf, *q)).collect();
+            for w in pts.windows(2) {
+                line(painter, w[0], w[1], false);
+            }
+            if let [.., a, b] = pts.as_slice() {
+                // The arrow head at the end: the blur's direction.
+                let v = (*b - *a).normalized();
+                let n = vec2(-v.y, v.x);
+                for side in [n, -n] {
+                    line(painter, *b, *b - v * 16.0 + side * 8.0, false);
+                }
+            }
+        }
+        "tiltShift" => {
+            let (sn, co) = num(f, "angle", 0.0).to_radians().sin_cos();
+            let (n, along) = (vec2(sn, co), vec2(co, -sn));
+            let r = painter.clip_rect();
+            let len = r.width().max(r.height()) * 2.0;
+            let f0 = num(f, "focus", 0.1) * ss;
+            let f1 = f0 + num(f, "transition", 0.15) * ss;
+            for (dist, dashed) in [(f0, false), (-f0, false), (f1, true), (-f1, true)] {
+                let o = c + n * dist;
+                line(painter, o - along * len, o + along * len, dashed);
+            }
+        }
+        _ => {
+            let iris = k == "irisBlur";
+            let (rx, ry) = (num(f, "radiusX", if iris { 0.35 } else { 0.3 }) * ss, num(f, "radiusY", if iris { 0.25 } else { 0.3 }) * ss);
+            let a = num(f, "angle", 0.0);
+            ellipse(painter, c, rx, ry, a, false);
+            if iris {
+                let fe = num(f, "feather", 0.5);
+                ellipse(painter, c, rx * fe, ry * fe, a, true);
+            }
+        }
+    }
+    if let Some(r) = ring_pos(k, f, c) {
+        // The blur ring, filled up to the value.
+        painter.circle_stroke(c, RING_R, Stroke::new(4.0, Color32::from_black_alpha(110)));
+        painter.circle_stroke(c, RING_R, Stroke::new(1.5, Color32::from_white_alpha(120)));
+        let end = (r - c).y.atan2((r - c).x);
+        let start = -std::f32::consts::FRAC_PI_2;
+        let span = (end - start).rem_euclid(std::f32::consts::TAU);
+        let arc: Vec<Pos2> = (0..=40)
+            .map(|i| {
+                let t = start + span * i as f32 / 40.0;
+                c + vec2(t.cos(), t.sin()) * RING_R
+            })
+            .collect();
+        painter.add(Shape::line(arc, Stroke::new(2.5, Color32::WHITE)));
+        dot(painter, r, 4.5, hot("ring"));
+    }
+    for (key, p) in &hs {
+        let at = screen(xf, *p);
+        if key == "center" {
+            // Photoshop's pin: a ring with a dot.
+            painter.circle_stroke(at, 9.0, Stroke::new(3.0, Color32::from_black_alpha(150)));
+            painter.circle_stroke(at, 9.0, Stroke::new(1.5, if hot(key) { Color32::from_rgb(234, 153, 63) } else { Color32::WHITE }));
+            dot(painter, at, 3.0, hot(key));
+        } else {
+            dot(painter, at, 5.0, hot(key));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn fields(cmd: &str) -> Map<String, Value> {
+        let mut f = Map::new();
+        f.insert("__command".into(), json!(cmd));
+        f.insert("__bounds".into(), json!([0, 0, 400, 200]));
+        f
+    }
+
+    #[test]
+    fn handles_round_trip_through_drags() {
+        let g = Geo { b: [0.0, 0.0, 400.0, 200.0] };
+        // Path Blur: dragging the end point moves endX / endY.
+        let mut f = fields("filter.blurGallery.pathBlur");
+        drag("pathBlur", "p1", [300.0, 50.0], &mut f, &g);
+        assert_eq!((num(&f, "endX", 0.0), num(&f, "endY", 0.0)), (0.75, 0.25));
+        assert_eq!(handles("pathBlur", &f, &g)[1].1, [300.0, 50.0]);
+        // Tilt-Shift: the focus handle sits at the focus distance, and dragging it sets it.
+        let mut f = fields("filter.blurGallery.tiltShift");
+        drag("tiltShift", "focus", [200.0, 100.0 + 40.0], &mut f, &g);
+        assert!((num(&f, "focus", 0.0) - 0.2).abs() < 1e-3, "{f:?}");
+        let h = handles("tiltShift", &f, &g);
+        assert!((h[1].1[1] - 140.0).abs() < 0.5, "{h:?}");
+        // The rotate dot turns the band; a pointer straight up-right of the centre is 45°.
+        drag("tiltShift", "rotate", [250.0, 50.0], &mut f, &g);
+        assert_eq!(num(&f, "angle", 0.0), 45.0);
+        // Iris: the radius handles follow the rotated ellipse's axes.
+        let mut f = fields("filter.blurGallery.irisBlur");
+        drag("irisBlur", "radiusX", [200.0 + 100.0, 100.0], &mut f, &g);
+        assert!((num(&f, "radiusX", 0.0) - 0.5).abs() < 1e-3);
+        drag("irisBlur", "center", [100.0, 50.0], &mut f, &g);
+        assert_eq!((num(&f, "centerX", 0.0), num(&f, "centerY", 0.0)), (0.25, 0.25));
+    }
+
+    #[test]
+    fn several_pins_and_paths() {
+        let g = Geo { b: [0.0, 0.0, 400.0, 200.0] };
+        // Iris Blur: the fields become the first pin; a click elsewhere adds a second one,
+        // selected, whose blur the sliders then change without touching the first.
+        let mut f = fields("filter.blurGallery.irisBlur");
+        sync("irisBlur", &mut f);
+        assert_eq!(items(&f, "pins").len(), 1);
+        assert_eq!(add_item("irisBlur", &mut f, &g, [100.0, 50.0], 1.0), Some("center"));
+        f.insert("blur".into(), json!(40));
+        sync("irisBlur", &mut f);
+        let pins = items(&f, "pins");
+        assert_eq!((pins.len(), sel(&f)), (2, 1));
+        assert_eq!((pins[1]["x"].as_f64(), pins[1]["blur"].as_f64(), pins[0]["blur"].as_f64()), (Some(0.25), Some(40.0), Some(15.0)));
+        // Selecting the first loads it into the fields; Delete removes the selected pin, never
+        // the last one.
+        select_item("irisBlur", &mut f, 0);
+        assert_eq!(num(&f, "blur", 0.0), 15.0);
+        assert!(delete_item("irisBlur", &mut f));
+        assert!(!delete_item("irisBlur", &mut f));
+        assert_eq!(items(&f, "pins")[0]["blur"].as_f64(), Some(40.0));
+        // Path Blur: a bend point survives syncing and drags on its own.
+        let mut f = fields("filter.blurGallery.pathBlur");
+        sync("pathBlur", &mut f);
+        if let Some(Value::Array(l)) = f.get_mut("paths") {
+            l[0]["points"].as_array_mut().unwrap().insert(1, json!([0.5, 0.2]));
+        }
+        drag("pathBlur", "p1", [200.0, 160.0], &mut f, &g);
+        sync("pathBlur", &mut f);
+        let pts = path_points(&f, 0);
+        assert_eq!(pts.len(), 3);
+        assert_eq!(pts[1], [0.5, 0.8]);
+        assert_eq!(handles("pathBlur", &f, &g).len(), 3);
+        // Tilt-Shift has one band: no list.
+        let mut f = fields("filter.blurGallery.tiltShift");
+        sync("tiltShift", &mut f);
+        assert!(!f.contains_key("pins") && !f.contains_key("paths"));
+        assert_eq!(add_item("tiltShift", &mut f, &g, [10.0, 10.0], 1.0), None);
+        // Field, Iris, Spin and Tilt-Shift are upstream's `blur_pins`; Path Blur is ours.
+        for kind in ["fieldBlur", "irisBlur", "spinBlur", "tiltShift"] {
+            assert!(!owns(&fields(&format!("filter.blurGallery.{kind}"))), "{kind}");
+        }
+        assert!(owns(&fields("filter.blurGallery.pathBlur")));
+    }
+}
