+/// Round 1 #5: Ungroup is in a group's Layers context menu (not a pixel layer's).
+#[test]
+fn ungroup_is_in_the_group_context_menu() {
+    let mut s = new_session();
+    s.execute("layer.new.layer", json!({})).unwrap();
+    let pixel = s.active().unwrap().active_layer.unwrap();
+    s.execute("layer.groupLayers", json!({})).unwrap();
+    let st = s.active().unwrap();
+    let group = st.doc.layer(st.active_layer.unwrap()).unwrap();
+    let ids = |l: &photocraft_doc::Layer| crate::layer_menu_ui::entries(l, false, false).into_iter().flatten().map(|(_, id)| id).collect::<Vec<_>>();
+    assert!(ids(group).contains(&"layer.ungroupLayers"));
+    assert!(!ids(st.doc.layer(pixel).unwrap()).contains(&"layer.ungroupLayers"));
+}
+
+/// Deleting a group with layers in it asks: Group and Contents, Group Only or Contents Only,
+/// from the Delete key, Layer › Delete and the trash button; a pixel layer goes at once, and
+/// automation never asks.
+#[test]
+fn deleting_a_group_asks_what_goes() {
+    use egui_kittest::kittest::Queryable;
+    let mut s = new_session();
+    for _ in 0..2 {
+        s.execute("layer.new.layer", json!({})).unwrap();
+    }
+    let ids: Vec<u64> = s.active().unwrap().doc.layers.iter().skip(1).map(|l| l.id.0).collect();
+    s.execute("layer.select", json!({"layer": ids[0]})).unwrap();
+    s.execute("layer.select", json!({"layer": ids[1], "mode": "add"})).unwrap();
+    s.execute("layer.groupLayers", json!({})).unwrap();
+    let mut h = app_harness(s);
+    let top = |h: &Harness<'_, PhotocraftApp>| {
+        h.state().session.active().unwrap().doc.layers.iter().map(|l| (l.is_group(), l.children().map_or(0, <[_]>::len))).collect::<Vec<_>>()
+    };
+    let asking = |h: &Harness<'_, PhotocraftApp>| h.state().ui.dialogs.iter().any(|d| crate::group_delete_prompt::owns(&d.fields));
+    let delete_key = |h: &mut Harness<'_, PhotocraftApp>| {
+        h.key_press(Key::Delete);
+        h.run_steps(3);
+    };
+    assert_eq!(top(&h), vec![(false, 0), (true, 2)]);
+    delete_key(&mut h);
+    assert!(asking(&h), "asked: {}", h.state().ui.status);
+    assert_eq!(top(&h), vec![(false, 0), (true, 2)], "nothing deleted yet");
+    h.get_by_label("Group Only").click();
+    h.run_steps(3);
+    assert!(!asking(&h));
+    assert_eq!(top(&h), vec![(false, 0), (false, 0), (false, 0)], "the layers stayed, the group went");
+    h.state_mut().run("edit.undo", json!({})).unwrap();
+    h.run_steps(2);
+    let ctx = h.ctx.clone();
+    crate::menus::invoke(h.state_mut(), &ctx, "layer.delete", json!({})).unwrap();
+    h.run_steps(3);
+    h.get_by_label("Contents Only").click();
+    h.run_steps(3);
+    assert_eq!(top(&h), vec![(false, 0), (true, 0)], "an empty group stayed");
+    h.state_mut().run("edit.undo", json!({})).unwrap();
+    h.run_steps(2);
+    h.state_mut().run("layer.delete", json!({"__trash": true})).unwrap();
+    h.run_steps(3);
+    assert!(asking(&h), "the trash button asks too");
+    h.key_press(Key::Escape);
+    h.run_steps(3);
+    assert!(!asking(&h));
+    assert_eq!(top(&h), vec![(false, 0), (true, 2)], "Cancel keeps everything");
+    delete_key(&mut h);
+    h.get_by_label("Group and Contents").click();
+    h.run_steps(3);
+    assert_eq!(top(&h), vec![(false, 0)]);
+    // A pixel layer is deleted without asking; so is a group by automation.
+    h.state_mut().run("layer.new.layer", json!({})).unwrap();
+    h.run_steps(2);
+    delete_key(&mut h);
+    assert!(!asking(&h));
+    assert_eq!(top(&h), vec![(false, 0)]);
+    h.state_mut().run("layer.new.layer", json!({})).unwrap();
+    h.state_mut().run("layer.groupLayers", json!({})).unwrap();
+    h.state_mut().automation_input = true;
+    h.state_mut().run("layer.delete", json!({})).unwrap();
+    h.state_mut().automation_input = false;
+    assert_eq!(top(&h), vec![(false, 0)]);
+}
