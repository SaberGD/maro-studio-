+//! HORIX's bug reports re-run on PhotoCraft 0.9 (apps/sg-ps/NEXT-STEPS.md), and the HORIX UX
+//! fixes that 0.9 still needed. Each test names the report it reproduces.
+
+use egui::{Key, Modifiers};
+use egui_kittest::Harness;
+use serde_json::json;
+
+use crate::PhotocraftApp;
+use crate::transform_undo_tests::{begin, drag, harness};
+
+fn quad(h: &Harness<'static, PhotocraftApp>) -> [[f64; 2]; 4] {
+    h.state().ui.transform.as_ref().expect("transforming").quad
+}
+
+fn key(h: &mut Harness<'static, PhotocraftApp>, m: Modifiers, k: Key) {
+    h.key_press_modifiers(m, k);
+    h.run_steps(2);
+}
+
+fn close(a: [[f64; 2]; 4], b: [[f64; 2]; 4]) -> bool {
+    a.iter().flatten().zip(b.iter().flatten()).all(|(x, y)| (x - y).abs() < 1e-6)
+}
+
+const RECT: [[f64; 2]; 4] = [[100.0, 100.0], [200.0, 100.0], [200.0, 160.0], [100.0, 160.0]];
+
+/// Bug round #1: "Undo skips a rotation". A rotation in an open Free Transform is the first thing
+/// ⌘Z takes back.
+#[test]
+fn undo_takes_back_a_free_transform_rotation() {
+    let mut h = harness();
+    begin(&mut h);
+    let q0 = quad(&h);
+    assert!(close(q0, RECT), "{q0:?}");
+    drag(&mut h, [q0[2][0] + 30.0, q0[2][1] + 30.0], [q0[2][0] - 10.0, q0[2][1] + 60.0]);
+    let r = quad(&h);
+    assert!((r[0][1] - r[1][1]).abs() > 1.0, "rotated: {r:?}");
+    key(&mut h, Modifiers::COMMAND, Key::Z);
+    assert!(close(quad(&h), q0), "⌘Z undid the rotation: {:?}", quad(&h));
+    // Nothing was committed to the document meanwhile.
+    key(&mut h, Modifiers::NONE, Key::Escape);
+    assert!(h.state().ui.transform.is_none());
+}
+
+/// Bug round #2: "Undo doesn't restore a move". A move inside the box is undone by ⌘Z, and after
+/// the commit ⌘Z restores the layer where it was.
+#[test]
+fn undo_restores_a_free_transform_move() {
+    let mut h = harness();
+    let bounds = |h: &Harness<'static, PhotocraftApp>| {
+        let st = h.state().session.active().unwrap();
+        st.doc.layer(st.active_layer.unwrap()).unwrap().surface().unwrap().content_bounds()
+    };
+    let before = bounds(&h);
+    begin(&mut h);
+    drag(&mut h, [125.0, 115.0], [185.0, 155.0]);
+    assert!(close(quad(&h), RECT.map(|p| [p[0] + 60.0, p[1] + 40.0])), "moved: {:?}", quad(&h));
+    key(&mut h, Modifiers::COMMAND, Key::Z);
+    assert!(close(quad(&h), RECT), "⌘Z undid the move: {:?}", quad(&h));
+    drag(&mut h, [125.0, 115.0], [185.0, 155.0]);
+    key(&mut h, Modifiers::NONE, Key::Enter);
+    assert!(h.state().ui.transform.is_none());
+    assert_eq!(bounds(&h).x0, before.x0 + 60);
+    key(&mut h, Modifiers::COMMAND, Key::Z);
+    assert_eq!(bounds(&h), before, "⌘Z after the commit restores the layer");
+}
+
+/// Bug round #3: "Placed image stays below objects after reordering". With the box open on the
+/// lower layer, Bring to Front shows it over the other layer at once (the preview follows the new
+/// order instead of freezing), and the commit keeps it on top.
+#[test]
+fn reordering_while_transforming_shows_the_new_order() {
+    let mut h = harness();
+    let lower = h.state().session.active().unwrap().active_layer.unwrap();
+    h.state_mut().run("layer.new.layer", json!({})).unwrap();
+    h.state_mut().run("select.rect", json!({"x": 120, "y": 110, "width": 60, "height": 40})).unwrap();
+    h.state_mut().run("edit.fill", json!({"color": "#0000ff"})).unwrap();
+    h.state_mut().run("select.deselect", json!({})).unwrap();
+    let upper = h.state().session.active().unwrap().active_layer.unwrap();
+    h.state_mut().run("layer.select", json!({"layer": lower.0})).unwrap();
+    h.run_steps(2);
+    begin(&mut h);
+    drag(&mut h, [125.0, 115.0], [135.0, 120.0]);
+    let hidden_upper = |h: &Harness<'static, PhotocraftApp>| {
+        let pv = h.state().transform_preview.as_ref().expect("preview");
+        !pv.doc.layer(upper).unwrap().visible
+    };
+    assert!(hidden_upper(&h), "the covering layer is drawn over the moving pixels, not in the document under them");
+    h.state_mut().run("layer.arrange.bringToFront", json!({})).unwrap();
+    h.run_steps(3);
+    assert!(h.state().ui.transform.is_some(), "the box stays open");
+    assert!(!hidden_upper(&h), "nothing covers the moving layer any more: the preview follows the new order");
+    key(&mut h, Modifiers::NONE, Key::Enter);
+    let st = h.state().session.active().unwrap();
+    assert_eq!(st.doc.layers.last().map(|l| l.id), Some(lower), "the transformed layer is on top");
+}
+
+/// Bug #6: Ctrl+C with an Arabic layout. egui-winit maps a key whose character isn't a Latin
+/// letter (ؤ on the C key) to its physical key, and turns ⌘C into a Copy event; the app turns
+/// that back into the ⌘C press its shortcut table matches.
+#[test]
+fn arabic_layout_letters_fall_back_to_the_physical_key() {
+    for arabic in ["ؤ", "ر", "ء", "ئ"] {
+        assert_eq!(Key::from_name(arabic), None, "{arabic} is not a key name, so egui-winit uses the physical key");
+    }
+    let ctx = egui::Context::default();
+    let mut raw = egui::RawInput { events: vec![egui::Event::ModifiersChanged(Modifiers::COMMAND), egui::Event::Copy, egui::Event::Cut], ..Default::default() };
+    crate::shortcuts::clipboard_keys(&ctx, false, &mut raw);
+    let keys: Vec<_> = raw
+        .events
+        .iter()
+        .filter_map(|e| if let egui::Event::Key { key, pressed: true, modifiers, .. } = e { Some((*key, modifiers.command)) } else { None })
+        .collect();
+    assert_eq!(keys, vec![(Key::C, true), (Key::X, true)]);
+    // The shortcut table matches the key, not its character.
+    let mut h = harness();
+    h.state_mut().run("select.rect", json!({"x": 100, "y": 100, "width": 20, "height": 20})).unwrap();
+    h.event(egui::Event::Key { key: Key::C, physical_key: Some(Key::C), pressed: true, repeat: false, modifiers: Modifiers::COMMAND });
+    h.run_steps(2);
+    assert!(h.state().session.clipboard.is_some(), "⌘C copied");
+}
+
+/// Bug #6 (partial): Copy with a selection on a shape or type layer copies its pixels.
+#[test]
+fn copy_with_a_selection_on_shape_and_type_layers() {
+    let mut s = photocraft_engine::Session::new();
+    s.execute("file.new", json!({"width": 64, "height": 64})).unwrap();
+    s.execute("shape.create", json!({"kind": "rect", "rect": [10, 10, 20, 10], "fill": "#ff8800"})).unwrap();
+    s.execute("select.rect", json!({"x": 0, "y": 0, "width": 15, "height": 64})).unwrap();
+    assert!(s.is_enabled("edit.copy"), "{:?}", s.disabled_reason("edit.copy"));
+    s.execute("edit.copy", json!({})).unwrap();
+    s.execute("edit.paste", json!({})).unwrap();
+    let st = s.active().unwrap();
+    let l = st.doc.layer(st.active_layer.unwrap()).unwrap();
+    assert!(matches!(l.content, photocraft_doc::LayerContent::Raster(_)));
+    assert_eq!(l.surface().unwrap().content_bounds().width(), 5, "the selected part of the shape");
+    s.execute("type.create", json!({"text": "Hi", "size": 30, "x": 20, "y": 50})).unwrap();
+    s.execute("select.all", json!({})).unwrap();
+    assert!(s.is_enabled("edit.copy"), "{:?}", s.disabled_reason("edit.copy"));
+}
+
+/// The whole app in a window, like the user sees it (Pro theme, Color panel expanded).
+fn app_harness(s: photocraft_engine::Session) -> Harness<'static, PhotocraftApp> {
+    let mut h = Harness::builder().with_size(egui::vec2(1440.0, 1000.0)).with_max_steps(64).build_eframe(move |cc| {
+        PhotocraftApp::setup_context(&cc.egui_ctx, Default::default());
+        PhotocraftApp::new(s, crate::Services::default())
+    });
+    h.run_steps(6);
+    h
+}
+
+fn new_session() -> photocraft_engine::Session {
+    let mut s = photocraft_engine::Session::new();
+    s.execute("file.new", json!({"width": 200, "height": 120})).unwrap();
+    s
+}
+
+/// Bug #5: the Color panel has an Eyedropper button; it picks the Eyedropper tool.
+#[test]
+fn color_panel_eyedropper_button_picks_the_eyedropper() {
+    use egui_kittest::kittest::Queryable;
+    let mut h = app_harness(new_session());
+    let ctx = h.ctx.clone();
+    let (req, _rx) = crate::control::ControlRequest::new("ui.set", json!({"dock": {"collapsed": []}}));
+    crate::control::handle(h.state_mut(), &ctx, &req);
+    h.run_steps(4);
+    assert_ne!(h.state().ui.tool, crate::state::Tool::Eyedropper);
+    h.get_by_label("Pick a color from the image (Eyedropper)").click();
+    h.run_steps(3);
+    assert_eq!(h.state().ui.tool, crate::state::Tool::Eyedropper);
+}
+
+/// Bug #5 / round 1 #11: picking a shape, type or pen tool, or selecting a shape or type layer,
+/// brings Properties forward; other tools and layers leave the panels alone.
+#[test]
+fn properties_comes_forward_for_shape_type_and_pen() {
+    use crate::dock::Group;
+    use crate::state::Tool;
+    let ctx = egui::Context::default();
+    let mut s = new_session();
+    s.execute("layer.new.layer", json!({})).unwrap();
+    let pixel = s.active().unwrap().active_layer.unwrap();
+    s.execute("shape.create", json!({"kind": "rect", "rect": [10, 10, 40, 20], "fill": "#ff0000"})).unwrap();
+    let shape = s.active().unwrap().active_layer.unwrap();
+    s.execute("layer.select", json!({"layer": pixel.0})).unwrap();
+    let mut app = PhotocraftApp::new(s, crate::Services::default());
+    let hide = |app: &mut PhotocraftApp| {
+        app.ui.dock_tabs.properties = 1;
+        app.ui.dock.set_collapsed(Group::Properties, true);
+    };
+    let front = |app: &PhotocraftApp| app.ui.dock_tabs.properties == 0 && !app.ui.dock.is_collapsed(Group::Properties) && app.ui.panels.properties;
+    crate::horix_ux::frame(&mut app, &ctx);
+    hide(&mut app);
+    for (tool, wants) in [(Tool::Brush, false), (Tool::Rectangle, true), (Tool::Move, false), (Tool::Type, true), (Tool::Pen, true), (Tool::CurvaturePen, true)]
+    {
+        hide(&mut app);
+        app.ui.tool = tool;
+        crate::horix_ux::frame(&mut app, &ctx);
+        assert_eq!(front(&app), wants, "{tool:?}");
+    }
+    // The same tool again changes nothing: closing the panel sticks.
+    hide(&mut app);
+    crate::horix_ux::frame(&mut app, &ctx);
+    assert!(!front(&app));
+    app.ui.tool = Tool::Move;
+    crate::horix_ux::frame(&mut app, &ctx);
+    app.session.execute("layer.select", json!({"layer": shape.0})).unwrap();
+    crate::horix_ux::frame(&mut app, &ctx);
+    assert!(front(&app), "a shape layer selected");
+    hide(&mut app);
+    app.session.execute("layer.select", json!({"layer": pixel.0})).unwrap();
+    crate::horix_ux::frame(&mut app, &ctx);
+    assert!(!front(&app), "a pixel layer: left alone");
+}
+
+/// Windows user #3: P flips Preview in a previewing dialog; Select and Mask keeps P for its own
+/// Show Original.
+#[test]
+fn p_toggles_the_preview_of_the_open_dialog() {
+    let mut h2 = {
+        let mut app = PhotocraftApp::new(new_session(), crate::Services::default());
+        app.sync_views();
+        let mut h2 = Harness::builder().with_size(egui::vec2(1000.0, 700.0)).build_ui_state(
+            |ui, app: &mut PhotocraftApp| {
+                let ctx = ui.ctx().clone();
+                if !ctx.fonts(|f| f.families().contains(&egui::FontFamily::Name("medium".into()))) {
+                    return;
+                }
+                crate::shortcuts::handle(app, &ctx);
+                egui::CentralPanel::default().show(ui, |ui| crate::canvas::document_area(app, ui));
+                crate::dialogs::show(app, &ctx);
+            },
+            app,
+        );
+        PhotocraftApp::setup_context(&h2.ctx, crate::theme::ThemeKind::ALL[0]);
+        h2.run_steps(4);
+        h2
+    };
+    h2.state_mut().ui.tool = crate::state::Tool::Move;
+    let d = crate::filter_dialog::open(h2.state_mut(), "filter.blur.gaussianBlur").unwrap();
+    h2.run_steps(3);
+    let preview = |h: &Harness<'static, PhotocraftApp>| h.state().ui.dialogs.iter().find(|x| x.id == d).unwrap().fields["__preview"].as_bool();
+    assert_eq!(preview(&h2), Some(true));
+    // The dialog opens on its first number: there P is typed (`5 pt`), not a shortcut.
+    key(&mut h2, Modifiers::NONE, Key::P);
+    assert_eq!(preview(&h2), Some(true), "a focused field keeps P");
+    h2.ctx.memory_mut(|m| {
+        if let Some(id) = m.focused() {
+            m.surrender_focus(id);
+        }
+    });
+    key(&mut h2, Modifiers::NONE, Key::P);
+    assert_eq!(preview(&h2), Some(false), "P shows the original");
+    assert_eq!(h2.state().ui.tool, crate::state::Tool::Move, "P didn't reach the tool shortcuts (Pen)");
+    key(&mut h2, Modifiers::NONE, Key::P);
+    assert_eq!(preview(&h2), Some(true), "P again shows the result");
+    let mut f = h2.state().ui.dialogs[0].fields.clone();
+    f.insert("__command".into(), json!(crate::select_mask_view::COMMAND));
+    let ctx = egui::Context::default();
+    ctx.input_mut(|i| i.events.push(egui::Event::Key { key: Key::P, physical_key: None, pressed: true, repeat: false, modifiers: Modifiers::NONE }));
+    crate::horix_ux::preview_key(&ctx, &mut f);
+    assert_eq!(f["__preview"], true, "Select and Mask keeps P");
+}
+
+/// Round 4 #1: Color Settings shows Ask When Opening as it is (off by default) and turns it on.
+#[test]
+fn color_settings_dialog_shows_ask_when_opening() {
+    let ctx = egui::Context::default();
+    let mut app = PhotocraftApp::new(new_session(), crate::Services::default());
+    let open = |app: &mut PhotocraftApp| {
+        let d = crate::prefs_ui::invoke(app, &ctx, "edit.colorSettings", &json!({})).unwrap().unwrap()["dialog"].as_u64().unwrap();
+        let v = app.ui.dialogs.iter().find(|x| x.id == d).unwrap().fields["askOnMismatch"].clone();
+        crate::dialogs::cancel(app, d).unwrap();
+        v
+    };
+    assert_eq!(open(&mut app), json!(false));
+    app.run("edit.colorSettings", json!({"askOnMismatch": true})).unwrap();
+    assert!(app.session.color.settings.ask_on_mismatch);
+    assert_eq!(open(&mut app), json!(true));
+}
+
+/// Round 1 #12: overset paragraph text has its mark's corner; text that fits has none.
+#[test]
+fn overset_text_has_a_mark() {
+    let mut s = new_session();
+    s.execute("type.create", json!({"text": "One two three four five six seven eight nine ten", "size": 20, "box": [10, 10, 80, 30]})).unwrap();
+    let over = s.active().unwrap().active_layer.unwrap();
+    s.execute("type.create", json!({"text": "Hi", "size": 12, "box": [10, 60, 100, 50]})).unwrap();
+    let fits = s.active().unwrap().active_layer.unwrap();
+    let mut app = PhotocraftApp::new(s, crate::Services::default());
+    let c = crate::horix_ux::overflow_corner(&mut app, over).expect("overset");
+    assert!((c[0] - 90.0).abs() < 0.5 && (c[1] - 40.0).abs() < 0.5, "{c:?}");
+    assert_eq!(crate::horix_ux::overflow_corner(&mut app, fits), None);
+}
