+/// Windows user #2: Select › Modify previews the selection it makes, red over the rest.
+#[test]
+fn select_modify_previews_its_selection() {
+    let mut s = new_session();
+    s.execute("select.rect", json!({"x": 50, "y": 40, "width": 40, "height": 40})).unwrap();
+    let mut app = PhotocraftApp::new(s, crate::Services::default());
+    let d = crate::filter_dialog::open(&mut app, "select.modify.expand").unwrap();
+    assert_eq!(app.ui.dialogs.iter().find(|x| x.id == d).unwrap().fields["__preview"], true);
+    let st = app.session.active().unwrap();
+    let out = crate::filter_dialog::preview_document(&st.doc, st.active_layer, "select.modify.expand", &json!({"radius": 10}), 1).unwrap();
+    let top = out.layers.last().unwrap();
+    assert_eq!(top.name, "Selection preview");
+    let alpha = |x: i32, y: i32| top.surface().unwrap().pixel(x, y)[3];
+    assert!(alpha(45, 60) < 0.01, "inside the expanded selection: clear");
+    assert!((alpha(20, 60) - 0.5).abs() < 0.01, "outside: half red");
+    assert_eq!(out.layers.len(), st.doc.layers.len() + 1);
+}
