+/// HORIX: Delete on a group, after Photoshop's question: `group_only` keeps each group's layers
+/// (they take its place), otherwise they go and the emptied group stays. The [`targets`] that are
+/// not groups are deleted either way. One history step.
+pub fn delete_groups(s: &mut Session, p: &Value, group_only: bool) -> Result<Value> {
+    let sel = targets(s, p)?;
+    s.edit(if group_only { "Delete Group" } else { "Delete Group Contents" }, |doc, active| {
+        let mut keep = None;
+        let ids = top_level(doc, &sel);
+        let before = crate::clip_group::Before::read(doc, &ids);
+        for id in ids {
+            if !doc.layer(id).is_some_and(Layer::is_group) {
+                doc.remove(id).ok_or(EngineError::NoLayer(id))?;
+            } else if group_only {
+                let path = doc.path_of(id).ok_or(EngineError::NoLayer(id))?;
+                let (&idx, parent) = path.split_last().ok_or(EngineError::NoLayer(id))?;
+                let sib =
+                    if parent.is_empty() { &mut doc.layers } else { doc.layer_at_mut(parent).and_then(Layer::children_mut).ok_or(EngineError::NoLayer(id))? };
+                let children = match sib.remove(idx).content {
+                    LayerContent::Group(g) => g.children,
+                    _ => Vec::new(),
+                };
+                keep = children.last().map(|l| l.id).or(keep);
+                for (k, l) in children.into_iter().enumerate() {
+                    sib.insert(idx + k, l);
+                }
+            } else {
+                doc.layer_mut(id).and_then(Layer::children_mut).ok_or(EngineError::NoLayer(id))?.clear();
+                keep = Some(id);
+            }
+        }
+        crate::clip_group::settle(doc, &[], &before, false);
+        if doc.layers.is_empty() {
+            return Err(EngineError::Other("a document must keep at least one layer".into()));
+        }
+        *active = keep.filter(|k| doc.layer(*k).is_some()).or_else(|| doc.top_layer());
+        Ok(())
+    })?;
+    Ok(Value::Null)
+}
+
