+/// Round 4 #3, round 5 #2: Path Blur's end point drags on the image, the dialog's fields and
+/// its first path follow (Field, Iris, Spin and Tilt-Shift are upstream's `blur_pins`).
+#[test]
+fn path_blur_is_edited_on_the_image() {
+    let mut h = blur_harness("filter.blurGallery.pathBlur");
+    let fl = blur_fields(&h);
+    let end = [(f(&fl, "endX") * 400.0) as f32, (f(&fl, "endY") * 300.0) as f32];
+    doc_drag(&mut h, end, [300.0, 75.0]);
+    let fl = blur_fields(&h);
+    assert!((f(&fl, "endX") - 0.75).abs() < 0.005 && (f(&fl, "endY") - 0.25).abs() < 0.005, "{} {}", fl["endX"], fl["endY"]);
+    assert_eq!(fl["paths"][0]["points"][1], json!([fl["endX"], fl["endY"]]), "the path follows");
+}
