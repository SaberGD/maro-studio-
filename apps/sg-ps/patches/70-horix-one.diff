+type Reply = (js_sys::Function, js_sys::Function);
+
+thread_local! {
+    /// HORIX One: commands from the page ([`horix_command`]), run on the next frame.
+    static COMMANDS: std::cell::RefCell<Vec<(String, String, Reply)>> = const { std::cell::RefCell::new(Vec::new()) };
+    /// HORIX One: files the page opens ([`horix_open`]).
+    static OPENS: std::cell::RefCell<Vec<(String, Vec<u8>)>> = const { std::cell::RefCell::new(Vec::new()) };
+    static CTX: std::cell::RefCell<Option<egui::Context>> = const { std::cell::RefCell::new(None) };
+}
+
+fn wake() {
+    CTX.with(|c| c.borrow().as_ref().map(|c| c.request_repaint()));
+}
+
+/// HORIX One: run a command by id from the page, as the menus do (`await
+/// wasmBindings.horix_command("file.export.quickExportAsPng", "{}")`); resolves to the result as
+/// JSON text or rejects with the error. With
+/// `window.horixOneCapture(name, bytes)` defined, files the command writes go to it instead of
+/// downloading, so HORIX One hands them to another persona.
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn horix_command(id: String, params: String) -> js_sys::Promise {
+    js_sys::Promise::new(&mut |resolve, reject| {
+        COMMANDS.with(|q| q.borrow_mut().push((id.clone(), params.clone(), (resolve, reject))));
+        wake();
+    })
+}
+
+/// HORIX One: open a file as a document, as if it were dropped on the window.
+#[wasm_bindgen::prelude::wasm_bindgen]
+pub fn horix_open(name: String, bytes: Vec<u8>) {
+    OPENS.with(|q| q.borrow_mut().push((name, bytes)));
+    wake();
+}
+
+impl WebShell {
+    /// HORIX One's requests (see [`horix_command`] and [`horix_open`]).
+    fn horix_one(&mut self, ctx: &egui::Context) {
+        CTX.with(|c| {
+            if c.borrow().is_none() {
+                *c.borrow_mut() = Some(ctx.clone());
+            }
+        });
+        let opens = OPENS.with(|q| std::mem::take(&mut *q.borrow_mut()));
+        if !opens.is_empty() {
+            self.inbox.lock().unwrap_or_else(|e| e.into_inner()).extend(opens);
+            ctx.request_repaint();
+        }
+        for (id, params, (resolve, reject)) in COMMANDS.with(|q| std::mem::take(&mut *q.borrow_mut())) {
+            let params: serde_json::Value = serde_json::from_str(&params).unwrap_or(serde_json::json!({}));
+            // As the menus run it: UI commands too (Quick Export as PNG writes through the page).
+            let _ = match photocraft_ui_egui::menus::invoke(&mut self.app, ctx, &id, params) {
+                Ok(v) => resolve.call1(&wasm_bindgen::JsValue::NULL, &v.to_string().into()),
+                Err(e) => reject.call1(&wasm_bindgen::JsValue::NULL, &e.into()),
+            };
+        }
+    }
+}
