 fn apply_drag(s: &mut TransformSession, g: Gesture, p: [f64; 2], mods: egui::Modifiers) {
+    apply_drag_box(s, g, p, mods);
+    // SG - PS: the reference point keeps its place *in the box* (centre by default), as in
+    // Photoshop: scaling, skewing or distorting carries it along instead of leaving it behind.
+    // (⌥-scaling is about the reference point itself, so it already stays put.)
+    if matches!(g.hit, Hit::Corner(_) | Hit::Edge(_)) && (mods.command || !mods.alt) {
+        let unit = [0.0, 0.0, 1.0, 1.0];
+        let rel = Homography::rect_to_quad(unit, g.quad0).and_then(|h| h.inverse()).map(|inv| inv.apply(g.pivot0[0], g.pivot0[1]));
+        if let (Some((pu, pv)), Some(h1)) = (rel, Homography::rect_to_quad(unit, s.quad)) {
+            let (x, y) = h1.apply(pu, pv);
+            if x.is_finite() && y.is_finite() {
+                s.pivot = [x, y];
+            }
+        }
+    }
+}
