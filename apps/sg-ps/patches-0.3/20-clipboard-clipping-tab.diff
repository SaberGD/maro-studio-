+/// Photoshop's Tab (show/hide all panels) and ⇧Tab (show/hide the panels on the right and the
+/// floating ones). Taken from the raw input, before egui would move keyboard focus with Tab,
+/// and only while nothing has keyboard focus and no menu, dialog or warp owns the keys.
+pub fn tab_panels(app: &mut PhotocraftApp, ctx: &egui::Context, typing: bool, raw: &mut egui::RawInput) {
+    let busy = typing
+        || ctx.memory(|m| m.focused().is_some())
+        || crate::menu_nav::is_open(ctx)
+        || !app.ui.dialogs.is_empty()
+        || app.discard.is_some()
+        || app.distort.active()
+        || app.distort.gallery.is_some();
+    raw.events.retain(|e| {
+        let egui::Event::Key { key: Key::Tab, pressed, modifiers: m, .. } = *e else { return true };
+        if !pressed {
+            app.ui.tab_down = false;
+            return true;
+        }
+        if busy || m.command || m.alt {
+            return true;
+        }
+        if !app.ui.tab_down {
+            let target = if m.shift { 2 } else { 1 };
+            app.ui.panels_hidden = if app.ui.panels_hidden == 0 { target } else { 0 };
+        }
+        app.ui.tab_down = true;
+        false
+    });
+}
