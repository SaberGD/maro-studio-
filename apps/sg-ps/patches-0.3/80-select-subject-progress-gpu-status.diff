+    pub fn run_with_feedback(&mut self, ctx: &egui::Context, id: &str, params: Value) -> Result<Value, String> {
+        if cfg!(target_arch = "wasm32") && matches!(id, "select.subject" | "select.focusArea" | "layer.removeBackground") {
+            let label = photocraft_engine::commands::find(id).map_or(id, |c| c.label).to_string();
