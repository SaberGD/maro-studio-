+    }
+
+    fn run_pending_command(&mut self, ctx: &egui::Context) {
+        let Some((frame, _, _)) = self.pending_command.as_ref() else { return };
+        if self.frame < *frame {
+            ctx.request_repaint_after(std::time::Duration::from_millis(16));
+            return;
+        }
+        let Some((_, id, params)) = self.pending_command.take() else { return };
+        let t0 = gpu_canvas::now_ms();
+        let label = photocraft_engine::commands::find(&id).map_or(id.as_str(), |c| c.label).to_string();
+        let r = self.run(&id, params);
+        let elapsed = gpu_canvas::now_ms() - t0;
+        let ai_pending = matches!(&r, Ok(v) if v.get("ai").and_then(serde_json::Value::as_bool).unwrap_or(false));
+        if r.is_ok() && !ai_pending {
+            self.ui.status = format!("{label} finished in {}", jobs_ui::elapsed(elapsed));
+            self.ui.status_error = false;
+        }
+    }
