+/// Compact, always-visible graphics and model health for the status bar.
+pub fn status_bar(app: &mut PhotocraftApp, ui: &mut egui::Ui) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    let gpu = app.gpu_active() && app.perf.gpu_info.canvas == "gpu";
+    let weak = app.perf.gpu_info.device_type == "integratedGpu" || app.perf.gpu_info.device_type == "cpu" || app.perf.gpu_info.backend == "gl";
+    let ai_ready = crate::ai_segment::available(app) && crate::ai_segment::subject_available(app);
+    let problem = app.perf.gpu_info.lost.as_deref().or(app.perf.gpu_info.fallback.as_deref()).or(app.perf.gpu_fallback.as_deref());
+    let label = if ai_ready && gpu && !weak {
+        "AI/GPU ready"
+    } else if ai_ready && gpu {
+        "AI ready - GPU limited"
+    } else if ai_ready {
+        "AI ready - CPU fallback"
+    } else if gpu && !weak {
+        "GPU connected"
+    } else if gpu {
+        "GPU limited"
+    } else {
+        "CPU fallback"
+    };
+    let color = if ai_ready && gpu && !weak { t.accent } else { t.warning };
+    let hover = if let Some(reason) = problem {
+        format!("{}\n{}\nAI selection can become very slow when the browser falls back to CPU/WebGL.", graphics_line(app), reason)
+    } else if let Some(reason) = crate::ai_segment::problem(app) {
+        format!("{}\nAI model service failed: {reason}. HORIX will use the classic selection path.", graphics_line(app))
+    } else if !ai_ready {
+        format!("{}\nAI model service is not attached. HORIX will use the classic selection path.", graphics_line(app))
+    } else if weak {
+        format!("{}\nAI models are available, but this GPU/backend is limited. Heavy selection can be slower.", graphics_line(app))
+    } else {
+        format!("{}\nAI models and graphics acceleration are active.", graphics_line(app))
+    };
+    ui.label(egui::RichText::new(label).color(color).size(12.0)).on_hover_text(hover);
+    if (!gpu || !ai_ready) && ui.small_button("Retry").on_hover_text("Reload HORIX and try the GPU/model service again").clicked() {
+        app.ui.status = "Retrying the GPU/model connection...".into();
+        app.ui.status_error = false;
+        #[cfg(target_arch = "wasm32")]
+        ui.ctx().open_url(egui::OpenUrl::same_tab("/"));
+        #[cfg(not(target_arch = "wasm32"))]
+        crate::notices::post(
+            app,
+            "Restart HORIX to reconnect the GPU/model service",
+            vec!["Your documents are unchanged. Save your work, close HORIX, and open it again to retry acceleration.".into()],
+            false,
+        );
+    }
+}
+
+fn graphics_line(app: &PhotocraftApp) -> String {
+    let info = &app.perf.gpu_info;
+    let adapter = if info.adapter.is_empty() { "unknown adapter" } else { &info.adapter };
+    let backend = if info.backend.is_empty() { "unknown backend" } else { &info.backend };
+    let device = if info.device_type.is_empty() { "unknown type" } else { &info.device_type };
+    format!("Graphics: {adapter} - {backend} - {device}")
+}
