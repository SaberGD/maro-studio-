# engsaber.space/sgps-downloads/: SG - PS desktop zips, published by apps/sg-ps/desktop/publish.sh.
Options -Indexes
AddType application/zip .zip
AddType application/json .json
<IfModule mod_headers.c>
  # The download page on studio.engsaber.space reads latest.json.
  <FilesMatch "\.json$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Same names every release: short cache; the page adds ?v=<build>.
  <FilesMatch "\.zip$">
    Header set Content-Disposition "attachment"
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
