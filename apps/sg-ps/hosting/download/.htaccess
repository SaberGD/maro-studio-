# horix.si/: the HORIX download page (HORIX Launcher for Windows; the Mac apps in mac/).
DirectoryIndex index.html
Options -Indexes
# The Mac disk images in mac/ download as files (the host would send them as text/plain).
AddType application/x-apple-diskimage .dmg
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
<FilesMatch "^sgps-config\.php$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "(\.html|^)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(woff2|webp|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.dmg$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>
