# HORIX على Hostinger (LiteSpeed/Apache): sabergroupacademy.com/horix/. الملف ده جنب index.html.

DirectoryIndex index.html

# 1) HTTPS إجباري (WebGPU والـclipboard شغالين على https بس)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2) نوع الملفات (بدونه المتصفح يرفض ملف الـwasm)
AddType application/wasm .wasm
AddType text/javascript .js

# 3) الضغط: الـwasm ينزل ~8MB بدل ~24MB
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript text/html
</IfModule>

# 4) الكاش: أسماء الملفات ثابتة في كل نسخة، فالمتصفح بيسأل السيرفر كل مرة (ولو الملف ما اتغيرش
#    بيرجع 304 من غير ما ينزّله تاني)
<IfModule mod_headers.c>
  <FilesMatch "(\.(wasm|js|svg|html)|^)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5) ملفات الشرح والتراخيص متتعرضش كصفحات تنفيذ
Options -Indexes

# 6) إعدادات السيرفر متتفتحش من المتصفح
<FilesMatch "^sgps-config\.php$">
  Require all denied
</FilesMatch>
