# studio.engsaber.space: HORIX moved to its own domains. Every old link (with its query string,
# e.g. ?waitlist=early from the desktop app) goes permanently to the new address.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^downloads?(/.*)?$ https://horix.si/ [R=301,L]
  RewriteRule ^(.*)$ https://horix.live/$1 [R=301,L]
</IfModule>
