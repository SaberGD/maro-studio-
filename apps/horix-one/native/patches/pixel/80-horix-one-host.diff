+# HORIX One: Horix Vectors and Horix Layout (its Vector and Layout personas) read and write PDFs
+# with these, from their own workspaces (whose [patch] tables a path dependency doesn't bring).
+# One copy of each, all at the newest of the three apps' craft-libs revisions (6e03f65, PhotoCraft's
+# own): craft-libs' history is one line (92d392c Layout, 9be9a63 Vectors, 6e03f65) and these vendor
+# crates only gained to it (new decode limits and cancellation, krilla's exact CMYK/gray/spot inks),
+# so each craft-pdf at its older revision builds against them. hayro, hayro-syntax, hayro-interpret
+# and hayro-jbig2 are already above (PhotoCraft's).
+krilla = { git = "https://github.com/storytold/craft-libs", rev = "6e03f65bf45181db77ba6229716e6624db9eb25b", version = "=0.8.2" }
+hayro-cmap = { git = "https://github.com/storytold/craft-libs", rev = "6e03f65bf45181db77ba6229716e6624db9eb25b", version = "=0.1.0" }
+hayro-postscript = { git = "https://github.com/storytold/craft-libs", rev = "6e03f65bf45181db77ba6229716e6624db9eb25b", version = "=0.1.0" }
+# Horix Vectors' patched linesweeper (its own [patch] says so).
+linesweeper = { git = "https://github.com/storytold/craft-libs", rev = "481f66d287b2a06845f3667a19daf35f0fe958ed" }
