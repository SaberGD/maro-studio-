+/// HORIX One: Horix Layout as the Layout persona of HORIX's window. HORIX's start-up made the
+/// window, its graphics device and the log; this is the part of [`main`]'s app creation that
+/// belongs to Horix Layout (its preferences and crash recovery, which it shares with the
+/// standalone app). The menus stay inside the window.
+pub struct Persona {
+    app: DesignApp,
+}
+
+pub fn horix_one_persona(custom_titlebar: bool) -> Persona {
+    let mut session = Session::new();
+    session.recovery_dir = profile::recovery_dir();
+    let recovered = session.execute("file.recovery.open", &serde_json::json!({})).ok();
+    let mut app = DesignApp::new(session, services());
+    load_prefs(&mut app);
+    if let Some(n) = recovered.as_ref().and_then(|r| r["opened"].as_array()).map(Vec::len).filter(|n| *n > 0) {
+        app.status(format!("Recovered {n} unsaved document{} from the last session.", if n == 1 { "" } else { "s" }));
+    }
+    app.integrated_titlebar = false;
+    app.custom_titlebar = custom_titlebar;
+    Persona { app }
+}
+
+impl Persona {
+    /// The app, for HORIX One's persona bar.
+    pub fn app(&mut self) -> &mut DesignApp {
+        &mut self.app
+    }
+
+    /// Whether a document has unsaved changes (quitting asks about them first).
+    pub fn unsaved(&self) -> bool {
+        self.app.session.documents().iter().any(|d| d.is_dirty())
+    }
+
+    /// Place `bytes` named `name` (a PNG or PDF another persona exported) on the spread in view,
+    /// in a new document when none is open.
+    pub fn place_bytes(&mut self, name: &str, bytes: &[u8]) -> Result<(), String> {
+        if self.app.session.documents().is_empty() {
+            self.app.run("file.new", serde_json::json!({}))?;
+        }
+        let base64 = designcraft_engine::cmd::base64_encode(bytes);
+        self.app.run("file.place", serde_json::json!({"base64": base64, "name": name, "x": 36, "y": 36})).map(|_| ())
+    }
+
+    /// The active document's first page as PDF (HORIX One's hand-off to Vector). `None` without a
+    /// document.
+    pub fn export_pdf(&mut self) -> Result<Option<Vec<u8>>, String> {
+        if self.app.session.documents().is_empty() {
+            return Ok(None);
+        }
+        let r = self.app.run("file.exportPdf", serde_json::json!({"pages": "1"}))?;
+        let data = r["base64"].as_str().ok_or("the export returned no data")?;
+        Ok(Some(designcraft_engine::cmd::base64_decode(data)))
+    }
+}
+
+impl eframe::App for Persona {
+    fn logic(&mut self, ctx: &egui::Context, _frame: &mut eframe::Frame) {
+        self.app.logic(ctx);
+    }
+    fn raw_input_hook(&mut self, _ctx: &egui::Context, raw: &mut egui::RawInput) {
+        self.app.raw_input_hook(raw);
+    }
+    fn ui(&mut self, ui: &mut egui::Ui, _frame: &mut eframe::Frame) {
+        self.app.ui(ui);
+    }
+    fn on_exit(&mut self) {
+        if let Err(e) = preserve_documents_on_exit(&mut self.app) {
+            log::error!("Couldn't preserve Layout's documents on exit: {e}");
+        }
+        save_prefs(&self.app);
+    }
+}
