+/// HORIX One: Horix Vectors as the Vector persona of HORIX's window. HORIX's start-up made the
+/// window, its graphics device, the log and the macOS menu bar; this is the part of [`main`]'s app
+/// creation that belongs to Horix Vectors (its preferences, libraries, fonts and Data Recovery,
+/// which it shares with the standalone app). The menus stay inside the window.
+pub fn horix_one_persona(cc: &eframe::CreationContext<'_>, custom_titlebar: bool) -> App {
+    vectorcraft_ui_egui::i18n::detect_system_lang_in_background();
+    #[cfg(all(windows, not(target_vendor = "win7")))]
+    system_fonts::install();
+    #[cfg(target_os = "macos")]
+    mac_fonts::install();
+    prefs_dir::install_fonts();
+    let saved = read_prefs();
+    let mut session = Session::new();
+    prefs_dir::attach_profile_store(&mut session);
+    prefs_dir::attach_plugin_store(&mut session);
+    let mut app = VectorcraftApp::new(session, services(cc.winit_window().cloned(), cc.egui_ctx.clone()));
+    load_prefs(&mut app, saved);
+    prefs_dir::attach_pdf_preset_store(&mut app.session);
+    let swatches = prefs_path().and_then(|p| Some(p.parent()?.join("Swatches").to_string_lossy().to_string()));
+    app.session.swatch_libraries.set_user_dir(swatches);
+    let styles = prefs_path().and_then(|p| Some(p.parent()?.join("Graphic Styles").to_string_lossy().to_string()));
+    app.session.style_libraries.set_user_dir(styles);
+    vectorcraft_ui_egui::panels::library_panel::restore(&mut app);
+    if prefs_enabled() {
+        let libraries = prefs_path().and_then(|p| Some(p.parent()?.join("Libraries").to_string_lossy().to_string()));
+        app.session.libraries.set_dir(libraries);
+    }
+    if std::env::var_os("VECTORCRAFT_NO_PREFS").is_none() {
+        let recovery = prefs_path().and_then(|p| Some(p.parent()?.join("Data Recovery").to_string_lossy().to_string()));
+        app.session.recovery.set_default_folder(recovery);
+    }
+    #[cfg(feature = "wgpu")]
+    if let Some(rs) = &cc.wgpu_render_state {
+        app.graphics_adapter = Some(adapter_summary(&rs.adapter.get_info()));
+    }
+    app.custom_titlebar = custom_titlebar;
+    // HORIX keeps the window's size and place.
+    app.ui.window = None;
+    App {
+        app,
+        graphics_loss: GraphicsLoss::default(),
+        graphics_lost: false,
+        frames: 0,
+        window_frame: None,
+        winit_window: None,
+        pending_maximize: false,
+        maximize_tries: 0,
+    }
+}
+
+impl App {
+    /// The app, for HORIX One's persona bar (open a file, export the drawing).
+    pub fn app(&mut self) -> &mut VectorcraftApp {
+        &mut self.app
+    }
+
+    /// Open `bytes` named `name` as a new document, as a dropped file opens.
+    pub fn open_bytes(&mut self, name: &str, bytes: &[u8]) -> Result<(), String> {
+        file_access::unconfined(|| vectorcraft_ui_egui::io::open_bytes(&mut self.app, name, bytes, None)).map(|_| ())
+    }
+
+    /// The active document as SVG, its type as outlines (HORIX One's hand-off to Pixel). `None`
+    /// without a document.
+    pub fn export_svg(&mut self) -> Result<Option<Vec<u8>>, String> {
+        if self.app.session.active().is_none() {
+            return Ok(None);
+        }
+        let r = file_access::unconfined(|| self.app.run("document.export", serde_json::json!({"format": "svg", "outlineText": true})))?;
+        let data = r["dataBase64"].as_str().ok_or("the export returned no data")?;
+        vectorcraft_format::base64_decode(data).map(Some).ok_or_else(|| "the export data is not base64".to_string())
+    }
+}
