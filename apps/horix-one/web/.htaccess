# HORIX One (one.horix.live): the persona bar here; Pixel in pixel/ and Vector in vector/, each
# with its own .htaccess (file types, pre-compressed WebAssembly).

DirectoryIndex index.html

# WebGPU and the clipboard need https.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType text/javascript .js
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# The page's name never changes between versions: browsers ask every time (304 when unchanged).
<IfModule mod_headers.c>
  <FilesMatch "(\.(html|svg)|^)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
