{
  "name": "maro-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Maro Creative Studio: browser design tools with the Maro Assistant",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "dev:api": "npm run dev -w @maro/api",
    "dev:web": "npm run dev -w @maro/web",
    "build": "npm run build -w @maro/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "verify": "node scripts/verify/no-secrets-in-web.mjs && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
